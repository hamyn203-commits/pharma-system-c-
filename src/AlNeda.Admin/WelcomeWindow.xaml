<Window x:Class="AlNeda.Admin.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760"
        Height="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded">

    <Window.Resources>
        <LinearGradientBrush x:Key="WelcomePanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF102238" Offset="0" />
            <GradientStop Color="#FF123B35" Offset="0.48" />
            <GradientStop Color="#FF0F172A" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="WelcomeChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#2422D3EE" />
            <Setter Property="BorderBrush" Value="#4422D3EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </Window.Resources>

    <Grid Opacity="0" x:Name="Root">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Root"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.35" />

                        <DoubleAnimation Storyboard.TargetName="HeroCardScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="0.78"
                                         To="1"
                                         Duration="0:0:0.70">
                            <DoubleAnimation.EasingFunction>
                                <BackEase Amplitude="0.32" EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="HeroCardScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="0.78"
                                         To="1"
                                         Duration="0:0:0.70">
                            <DoubleAnimation.EasingFunction>
                                <BackEase Amplitude="0.32" EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="HeroCardRotate"
                                         Storyboard.TargetProperty="Angle"
                                         From="-8"
                                         To="0"
                                         Duration="0:0:0.70">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="HeroCardTranslate"
                                         Storyboard.TargetProperty="Y"
                                         From="40"
                                         To="0"
                                         Duration="0:0:0.70">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>

                        <DoubleAnimation Storyboard.TargetName="WelcomeText"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         BeginTime="0:0:0.22"
                                         Duration="0:0:0.35" />
                        <DoubleAnimation Storyboard.TargetName="WelcomeTextScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="0.92"
                                         To="1"
                                         BeginTime="0:0:0.22"
                                         Duration="0:0:0.45" />
                        <DoubleAnimation Storyboard.TargetName="WelcomeTextScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="0.92"
                                         To="1"
                                         BeginTime="0:0:0.22"
                                         Duration="0:0:0.45" />

                        <DoubleAnimation Storyboard.TargetName="GlowRing"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.15"
                                         To="0.52"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"
                                         Duration="0:0:0.9" />
                        <DoubleAnimation Storyboard.TargetName="FloatingBadge"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         From="0"
                                         To="-12"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"
                                         Duration="0:0:1.05" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Border Background="#A60F172A" CornerRadius="30" />

        <Border x:Name="HeroCard"
                Width="660"
                Height="330"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource WelcomePanelBrush}"
                BorderBrush="#4422D3EE"
                BorderThickness="1"
                CornerRadius="30"
                Padding="32"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="HeroCardScale" ScaleX="1" ScaleY="1" />
                    <SkewTransform AngleX="-2" AngleY="0" />
                    <RotateTransform x:Name="HeroCardRotate" Angle="0" />
                    <TranslateTransform x:Name="HeroCardTranslate" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#FF22D3EE" BlurRadius="48" ShadowDepth="0" Opacity="0.28" />
            </Border.Effect>

            <Grid>
                <Ellipse x:Name="GlowRing"
                         Width="170"
                         Height="170"
                         Fill="#2234D399"
                         Stroke="#6634D399"
                         StrokeThickness="1"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="0,-36,0,0"
                         Opacity="0.18" />

                <Border x:Name="FloatingBadge"
                        Style="{StaticResource WelcomeChipStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                        <Ellipse Width="8" Height="8" Fill="#FF34D399" VerticalAlignment="Center" />
                        <TextBlock Text="تم تسجيل الدخول بنجاح"
                                   Foreground="#FF67E8F9"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,18,0,0">
                    <Grid Width="86" Height="86" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Ellipse Fill="#2634D399" Stroke="#4434D399" StrokeThickness="1" />
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="38"
                                   Foreground="#FF34D399"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel x:Name="WelcomeText"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="WelcomeTextScale" ScaleX="1" ScaleY="1" />
                        </StackPanel.RenderTransform>

                        <TextBlock Text="مرحباً بكم في مخزن الندى"
                                   FontSize="40"
                                   FontWeight="Black"
                                   Foreground="#FFF8FAFC"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF22D3EE" BlurRadius="22" ShadowDepth="0" Opacity="0.34" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="نظام إدارة مخزن الأدوية والصيدليات"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#FFCBD5E1"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <TextBlock Text="تم عمل هذا البرنامج بواسطة المهندس حسام السبعاوي"
                               Foreground="#FF94A3B8"
                               FontSize="13"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
