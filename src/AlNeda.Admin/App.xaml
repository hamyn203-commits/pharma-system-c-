<Application x:Class="AlNeda.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AlNeda.Admin"
             xmlns:conv="clr-namespace:AlNeda.Admin.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AlNeda.Admin;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter" />
            <conv:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
            <conv:StatusToBgConverter x:Key="StatusToBgConverter" />
            <conv:BalanceColorConverter x:Key="BalanceColorConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <conv:BoolToTextConverter x:Key="BoolToTextConverter" />
            <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter" />
            <conv:PositiveNegativeToBrushConverter x:Key="PositiveNegativeToBrushConverter" />
            <conv:ProfitMarginToBrushConverter x:Key="ProfitMarginToBrushConverter" />
            <conv:TrendToBrushConverter x:Key="TrendToBrushConverter" />
            <conv:TrendToForegroundConverter x:Key="TrendToForegroundConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
