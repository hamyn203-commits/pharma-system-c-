<Window x:Class="AlNeda.Admin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AlNeda.Admin.Converters"
        Title="مخزن الندا - تسجيل الدخول"
        Width="460" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=PasswordBox}" />
    </Window.InputBindings>

    <Border Background="#FF0D1117" CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="60" Color="#FF55D66B" Opacity="0.15" />
        </Border.Effect>

        <Grid>
            <!-- Subtle grid pattern overlay -->
            <Border CornerRadius="24" Opacity="0.03">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                                        <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#FFFFFFFF" Thickness="1" />
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <StackPanel VerticalAlignment="Center" Margin="40,0">

                <!-- Logo & Branding -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Ellipse Fill="#FF1F3B2A" />
                        <Grid>
                            <Rectangle Width="8" Height="32" Fill="#FF55D66B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RadiusX="2" RadiusY="2" />
                            <Rectangle Width="32" Height="8" Fill="#FF55D66B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RadiusX="2" RadiusY="2" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="مخزن الندا"
                               FontSize="32" FontWeight="Bold"
                               Foreground="#FFFFFFFF"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Pharmaceutical Warehouse Management"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="#FF8B949E"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Welcome Text -->
                <TextBlock Text="مرحباً بعودتك"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="#FFFFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,4" />
                <TextBlock Text="سجل دخولك للمتابعة"
                           FontSize="13"
                           Foreground="#FF8B949E"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30" />

                <!-- Username -->
                <TextBlock Text="اسم المستخدم" FontSize="12"
                           Foreground="#FF8B949E" Margin="0,0,0,8" />
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="48" FontSize="14"
                         Background="#FF0D1117" Foreground="White"
                         BorderBrush="#FF30363D" BorderThickness="1"
                         Padding="14,12" CaretBrush="#FF55D66B"
                         VerticalContentAlignment="Center" />

                <!-- Password -->
                <TextBlock Text="كلمة المرور" FontSize="12"
                           Foreground="#FF8B949E" Margin="0,16,0,8" />
                <PasswordBox x:Name="PasswordBox"
                             Height="48" FontSize="14"
                             Background="#FF0D1117" Foreground="White"
                             BorderBrush="#FF30363D" BorderThickness="1"
                             Padding="14,12" />

                <!-- Role -->
                <TextBlock Text="الدور الوظيفي" FontSize="12"
                           Foreground="#FF8B949E" Margin="0,16,0,8" />
                <ComboBox ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding SelectedRole}"
                          Height="48" FontSize="14"
                          Background="#FF0D1117" Foreground="White"
                          BorderBrush="#FF30363D" BorderThickness="1"
                          Padding="14,12" />

                <!-- Error Message -->
                <Border Background="#FF3D1A1A" CornerRadius="10"
                        Padding="14,10" Margin="0,16,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12"
                               Foreground="#FFFF5C5C"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Login Button -->
                <Button Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        Height="52" Margin="0,24,0,0"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding LoginButtonText, FallbackValue=تسجيل الدخول}"
                                   FontSize="15" />
                        <TextBlock Text=" →" FontSize="15"
                                   Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </StackPanel>
                </Button>

                <!-- Dev Skip Button -->
                <Button Command="{Binding SkipLoginCommand}"
                        Height="32" Margin="0,12,0,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FF8B949E" FontSize="11"
                        Cursor="Hand">
                    <TextBlock Text="تخطي تسجيل الدخول (وضع التطوير)" TextDecorations="Underline" />
                </Button>

                <!-- Version -->
                <TextBlock Text="الإصدار 1.0.0 | AlNeda Systems"
                           FontSize="10"
                           Foreground="#FF484F58"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
