<Window x:Class="AlNeda.Admin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AlNeda.Admin.Converters"
        Title="Al-Neda Warehouse - Login"
        Width="460" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=PasswordBox}" />
    </Window.InputBindings>

    <Border Background="{StaticResource WarmSurfaceBrush}" CornerRadius="24" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="60" Color="{StaticResource PrimaryIndigo}" Opacity="0.15" />
        </Border.Effect>

        <Grid>
            <!-- Subtle grid pattern overlay -->
            <Border CornerRadius="24" Opacity="0.03">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                                        <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="{StaticResource BorderDefaultBrush}" Thickness="1" />
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
            </Border>

            <!-- Control Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20">
                <Button x:Name="CloseButton"
                        Click="CloseButton_Click"
                        Width="32" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" FontSize="18"
                        Cursor="Hand">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="16">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{StaticResource DangerGlassBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" Margin="40,0">

                <!-- Logo & Branding -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Ellipse Fill="{StaticResource PrimaryIndigoGlassBrush}" />
                        <Grid>
                            <Rectangle Width="8" Height="32" Fill="{StaticResource PrimaryIndigoBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RadiusX="2" RadiusY="2" />
                            <Rectangle Width="32" Height="8" Fill="{StaticResource PrimaryIndigoBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RadiusX="2" RadiusY="2" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="Al-Neda Warehouse"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Pharmaceutical Warehouse Management"
                               FontSize="11" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Welcome Text -->
                <TextBlock Text="مرحباً بعودتك"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,4" />
                <TextBlock Text="سجل دخولك للمتابعة"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30" />

                <!-- Username -->
                <TextBlock Text="اسم المستخدم" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="48" FontSize="14"
                         Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                         Padding="14,12" CaretBrush="#FF55D66B"
                         VerticalContentAlignment="Center" />

                <!-- Password -->
                <TextBlock Text="كلمة المرور" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,8" />
                <Grid>
                    <PasswordBox x:Name="PasswordBox"
                                 Height="48" FontSize="14"
                                 Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                 Padding="14,12,45,12" 
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    
                    <TextBox x:Name="PasswordVisibleBox"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Height="48" FontSize="14"
                             Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                             Padding="14,12,45,12"
                             Visibility="{Binding ShowPassword, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    
                    <ToggleButton IsChecked="{Binding ShowPassword}"
                                  HorizontalAlignment="Right" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,10,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{StaticResource TextMutedBrush}"
                                  Cursor="Hand"
                                  FontSize="16">
                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" />
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryIndigoBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </Grid>

                <!-- Role -->
                <TextBlock Text="الدور الوظيفي" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,8" />
                <ComboBox ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding SelectedRole}"
                          Height="48" FontSize="14"
                          Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                          Padding="14,12" Style="{StaticResource ModernComboBox}" ItemContainerStyle="{StaticResource ModernComboBoxItem}" />

                <!-- Error Message -->
                <Border Background="{StaticResource DangerGlassBrush}" CornerRadius="10"
                        Padding="14,10" Margin="0,16,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Login Button -->
                <Button Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        Height="52" Margin="0,24,0,0"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding LoginButtonText, FallbackValue=تسجيل الدخول}"
                                   FontSize="15" />
                        <TextBlock Text=" ->" FontSize="15"
                                   Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </StackPanel>
                </Button>

                <!-- Dev Skip Button -->
                <Button Command="{Binding SkipLoginCommand}"
                        Height="32" Margin="0,12,0,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                        Cursor="Hand"
                        Visibility="{Binding ShowDevSkip, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="تخطي تسجيل الدخول (وضع التطوير)" TextDecorations="Underline" />
                </Button>

                <!-- Version -->
                <TextBlock Text="Version 1.0.0 | Al-Neda Systems"
                           FontSize="10"
                           Foreground="#FF484F58"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
