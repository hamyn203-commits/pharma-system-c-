    <Color x:Key="SidebarBg">#FF101827</Color>
    <Color x:Key="CardBg">#FF121C2E</Color>
    <Color x:Key="HeaderBg">#FF111A2A</Color>
    <Color x:Key="BorderDefault">#FF243149</Color>
    <Color x:Key="BorderMuted">#FF1A2436</Color>
    
    <Color x:Key="TextPrimary">#FFF4F8FF</Color>
    <Color x:Key="TextSecondary">#FFB7C4D8</Color>
    <Color x:Key="TextMuted">#FF8290A7</Color>

    <!-- SolidColorBrushes -->
