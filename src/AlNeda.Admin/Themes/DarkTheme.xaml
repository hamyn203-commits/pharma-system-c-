    <Color x:Key="PrimaryIndigoDark">#FF0E8F77</Color>
    <Color x:Key="PrimaryIndigoLight">#FF7EE7D2</Color>
    <Color x:Key="PrimaryIndigoGlass">#2631D0AA</Color>
    
    <Color x:Key="PrimaryCyan">#FF4EA7FF</Color>
    <Color x:Key="PrimaryCyanDark">#FF2173C7</Color>
    <Color x:Key="PrimaryCyanLight">#FF9FD0FF</Color>
    <Color x:Key="PrimaryCyanGlass">#264EA7FF</Color>
    
    <Color x:Key="AccentPurple">#FFFF6FAE</Color>
    <Color x:Key="AccentPurpleLight">#33FF6FAE</Color>
    
    <Color x:Key="Danger">#FFFF5F7E</Color>
    <Color x:Key="DangerLight">#FFFF9CAE</Color>
    <Color x:Key="DangerGlass">#2BFF5F7E</Color>
    
    <Color x:Key="Warning">#FFF0B84A</Color>
    <Color x:Key="WarningLight">#FFFFD98A</Color>
    <Color x:Key="WarningGlass">#2BF0B84A</Color>
    
