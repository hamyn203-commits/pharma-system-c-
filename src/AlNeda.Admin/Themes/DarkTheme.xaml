        <GradientStop Color="{StaticResource PrimaryCyanLight}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="UsersTabGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentPurple}" Offset="0" />
        <GradientStop Color="{StaticResource AccentPurpleLight}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NotificationsTabGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Warning}" Offset="0" />
        <GradientStop Color="{StaticResource WarningLight}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BackupTabGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Danger}" Offset="0" />
        <GradientStop Color="{StaticResource DangerLight}" Offset="1" />
    </LinearGradientBrush>

    <!-- Stat Card Gradients -->
    <LinearGradientBrush x:Key="StatCardGreenGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2631D0AA" Offset="0" />
        <GradientStop Color="#FF121C2E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatCardBlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#264EA7FF" Offset="0" />
        <GradientStop Color="#FF121C2E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatCardPurpleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2BFF6FAE" Offset="0" />
        <GradientStop Color="#FF121C2E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatCardAmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2BF0B84A" Offset="0" />
        <GradientStop Color="#FF121C2E" Offset="1" />
    </LinearGradientBrush>

    <!-- Glass Border Gradient -->
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#44FFFFFF" Offset="0" />
        <GradientStop Color="#22243149" Offset="0.5" />
        <GradientStop Color="#1131D0AA" Offset="1" />
    </LinearGradientBrush>

    <!-- Group Colors -->
    <SolidColorBrush x:Key="GeneralGroupBrush" Color="{StaticResource PrimaryIndigo}" />
    <SolidColorBrush x:Key="InventoryGroupBrush" Color="{StaticResource PrimaryCyan}" />
    <SolidColorBrush x:Key="SalesGroupBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="MonitoringGroupBrush" Color="{StaticResource AccentPurple}" />

    <!-- Metric Brushes (More Vibrant) -->
    <LinearGradientBrush x:Key="ReceivablesGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#35FF5F7E" Offset="0" />
        <GradientStop Color="#FF151F33" Offset="0.52" />
        <GradientStop Color="#FF101827" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PharmaciesGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3331D0AA" Offset="0" />
        <GradientStop Color="#FF101827" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrdersGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#30F0B84A" Offset="0" />
        <GradientStop Color="#FF101827" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InExecutionGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2BFF6FAE" Offset="0" />
        <GradientStop Color="#FF101827" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DailySalesGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#304EA7FF" Offset="0" />
        <GradientStop Color="#FF101827" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MonthlySalesGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3031D0AA" Offset="0" />
        <GradientStop Color="#FF101827" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProductsGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2BFF6FAE" Offset="0" />
        <GradientStop Color="#FF101827" Offset="1" />
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- EFFECTS & SHIMMERS                                              -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="30" ShadowDepth="8" Color="#FF020617" Opacity="0.42" />
    <DropShadowEffect x:Key="DashboardCardShadow3D" BlurRadius="42" ShadowDepth="12" Direction="270" Color="#FF020617" Opacity="0.48" />
    <DropShadowEffect x:Key="NavActiveShadow" BlurRadius="22" ShadowDepth="5" Direction="270" Color="#FF020617" Opacity="0.38" />
    
    <LinearGradientBrush x:Key="ShimmerBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF132033" Offset="0" />
        <GradientStop Color="#FF1E3350" Offset="0.5" />
        <GradientStop Color="#FF132033" Offset="1" />
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- NAVIGATION BUTTON STYLE                                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                    <TranslateTransform X="0" />
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="#3318233A"
                            CornerRadius="16"
                            BorderThickness="1"
                            BorderBrush="#2EFFFFFF"
                            Padding="12,0">
                        <Grid>
                            <Border x:Name="Tint"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="16"
                                    Opacity="0.06" />
                            <Border x:Name="Indicator" Width="4" CornerRadius="2"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                    Opacity="0" Margin="0,8,-2,8" />
                            <Border x:Name="IconGlow" Width="30" Height="30" CornerRadius="12"
                                    Background="{TemplateBinding Foreground}"
                                    Opacity="0.10"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="8,0,0,0" />
                            <ContentPresenter HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.14" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="IconGlow" Property="Opacity" Value="0.18" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.01" ScaleY="1.01" />
                                        <TranslateTransform X="-2" />
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Uid" Value="active">
                            <Setter TargetName="Border" Property="Background" Value="#401F2E46" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Border" Property="Effect" Value="{StaticResource NavActiveShadow}" />
                            <Setter TargetName="Tint" Property="Opacity" Value="0.20" />
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            <Setter TargetName="IconGlow" Property="Opacity" Value="0.24" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1.015" ScaleY="1.015" />
                                        <TranslateTransform X="-4" />
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- CARD STYLE                                                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarmSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <Style x:Key="TransparentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- PRIMARY ACTION BUTTON (Green)                                    -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource PrimaryIndigoBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            BorderThickness="0">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8"
                                              Color="{StaticResource PrimaryIndigo}" Opacity="0.3" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryIndigoDarkBrush}" />
                            <Setter TargetName="Border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="3" BlurRadius="12"
                                                      Color="{StaticResource PrimaryIndigo}" Opacity="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryIndigoDarkBrush}" />
                            <Setter TargetName="Border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BorderDefaultBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SECONDARY ACTION BUTTON (Blue)                                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource PrimaryCyanBrush}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryCyanLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
