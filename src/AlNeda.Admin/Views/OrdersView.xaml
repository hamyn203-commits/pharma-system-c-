<UserControl x:Class="AlNeda.Admin.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AlNeda.Admin.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Stats -->
            <RowDefinition Height="Auto" /> <!-- Filters -->
            <RowDefinition Height="*" />    <!-- Grid -->
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="#E60D1117" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="#FF55D66B" Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل الطلبات..." Foreground="#FF8B949E"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Stats -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="طلبات اليوم" Foreground="#FF8B949E" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="24" FontSize="28" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="📝" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="6,0,6,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="طلبات قيد التنفيذ" Foreground="#FF8B949E" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="8" FontSize="28" FontWeight="Bold" Foreground="#FFD29922" />
                        <TextBlock Text="⏳" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="إيرادات الشهر" Foreground="#FF8B949E" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="452,000" FontSize="28" FontWeight="Bold" Foreground="#FF55D66B" />
                        <TextBlock Text="💰" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"
                          Width="180" Height="44" Style="{StaticResource ModernComboBox}" />
                
                <Grid Width="250" Height="44" Margin="12,0,0,0">
                    <TextBox Text="{Binding BarcodeSearch, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Padding="35,0,12,0"
                             VerticalContentAlignment="Center" Tag="باركود المنتج..."/>
                    <TextBlock Text="📷" Foreground="#FF8B949E" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                </Grid>
                
                <Button Content="تطبيق" Command="{Binding LoadCommand}" Height="44"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" Padding="20,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🖨️ طباعة المحدد" Command="{Binding PrintSelectedOrderCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Height="44" Padding="16,0" Margin="0,0,12,0" />
                <Button Content="+ طلب جديد" Command="{Binding NewOrderCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Height="44" Padding="24,0" />
            </StackPanel>
        </Grid>

        <!-- Data Grid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                      Style="{StaticResource ModernDataGrid}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF21262D"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الطلب" Binding="{Binding OrderNumber}" Width="120" />
                    <DataGridTextColumn Header="الصيدلية" Binding="{Binding Pharmacy.Name}" Width="*" />
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding FinalTotal, StringFormat={}{0:N2}}" Width="120" />
                    <DataGridTemplateColumn Header="الحالة" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Margin="10,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="completed">
                                                    <Setter Property="Background" Value="#FF1F3B2A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="pending">
                                                    <Setter Property="Background" Value="#FF3B2D1A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                    <Setter Property="Background" Value="#FF3D1A1A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="completed">
                                                        <Setter Property="Text" Value="مكتمل" />
                                                        <Setter Property="Foreground" Value="#FF55D66B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="pending">
                                                        <Setter Property="Text" Value="قيد التنفيذ" />
                                                        <Setter Property="Foreground" Value="#FFD29922" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                        <Setter Property="Text" Value="ملغي" />
                                                        <Setter Property="Foreground" Value="#FFFF5C5C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                    <DataGridTemplateColumn Header="الإجراءات" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="👁️" Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource ActionButtonStyle}" ToolTip="عرض التفاصيل" />
                                    <Button Content="🖨️" Command="{Binding DataContext.PrintOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource ActionButtonStyle}" ToolTip="طباعة" Margin="6,0,0,0" />
                                    <Button Content="📄" Command="{Binding DataContext.ExportOrderHtmlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource ActionButtonStyle}" ToolTip="تصدير HTML" Margin="6,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Detail Overlay -->
        <Border Grid.RowSpan="3" Background="#E60D1117"
                Visibility="{Binding ShowDetail, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <Border Style="{StaticResource CardStyle}" Width="650" MaxHeight="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="تفاصيل الطلب" FontSize="22" FontWeight="Bold" Foreground="#FF55D66B" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="🖨️ طباعة الفاتورة" Command="{Binding PrintSelectedOrderCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="12,0" />
                            <Button Content="✕" Command="{Binding CloseDetailCommand}"
                                    Style="{StaticResource ActionButtonStyle}" Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#FF21262D" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="رقم الطلب" Foreground="#FF8B949E" FontSize="11" />
                                <TextBlock Text="{Binding SelectedOrder.OrderNumber}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="الصيدلية" Foreground="#FF8B949E" FontSize="11" />
                                <TextBlock Text="{Binding SelectedOrder.Pharmacy.Name}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الإجمالي" Foreground="#FF8B949E" FontSize="11" />
                                <TextBlock Text="{Binding SelectedOrder.FinalTotal, StringFormat={}{0:N2}}" Foreground="#FF55D66B" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Items placeholder or items list could go here -->
                    <TextBlock Grid.Row="2" Text="قائمة المنتجات في هذا الطلب ستظهر هنا بتنسيق جدولي متطور..." 
                               Foreground="#FF8B949E" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <Button Grid.Row="3" Content="إغلاق النافذة" Command="{Binding CloseDetailCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Height="44" Width="150" HorizontalAlignment="Right" Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
