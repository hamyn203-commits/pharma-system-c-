<UserControl x:Class="AlNeda.Admin.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:conv="clr-namespace:AlNeda.Admin.Converters"
             xmlns:models="clr-namespace:AlNeda.Core.Models"
             xmlns:entities="clr-namespace:AlNeda.Core.Entities"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Resources>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="OrdersKpiCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- HEADER + KPI CARDS                                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="إدارة الطلبات" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OrdersKpiCardStyle}" Background="{StaticResource CardBgBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardGreenGradient}">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="طلبات اليوم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding TodayOrdersCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource OrdersKpiCardStyle}" Background="{StaticResource CardBgBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardAmberGradient}">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="قيد التنفيذ" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding PendingOrdersCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource OrdersKpiCardStyle}" Background="{StaticResource CardBgBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardBlueGradient}">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="إيرادات الشهر" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding MonthlyRevenue, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource OrdersKpiCardStyle}" Background="{StaticResource CardBgBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardPurpleGradient}">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="إجمالي الطلبات" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding TotalOrdersCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- FILTERS + ACTIONS                                          -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" CornerRadius="14"
                Padding="20,12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1"
                Effect="{StaticResource CardShadow}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"
                              Style="{StaticResource ModernComboBox}" MinWidth="150" Height="40" FontSize="12" />
                    <ComboBox ItemsSource="{Binding SourceFilters}" SelectedItem="{Binding SourceFilter}"
                              Style="{StaticResource ModernComboBox}" MinWidth="120" Height="40" FontSize="12" Margin="10,0,0,0" />
                    <DatePicker SelectedDate="{Binding FilterFrom}" Margin="10,0,0,0"
                                Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderMutedBrush}" Height="40" FontSize="12" />
                    <TextBlock Text="إلى" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="8,0,8,0" />
                    <DatePicker SelectedDate="{Binding FilterTo}"
                                Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderMutedBrush}" Height="40" FontSize="12" />
                    <Border CornerRadius="10" Background="{StaticResource GlassCardBrush}" Margin="10,0,0,0" Height="40">
                        <Grid Width="220">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" Padding="35,0,12,0"
                                     VerticalContentAlignment="Center" FontSize="12"
                                     Tag="بحث برقم الطلب أو الصيدلية..." />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <Button Content="&#xE72D; تحديث" Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Height="40" FontSize="12" Padding="16,0" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="+ طلب جديد" Command="{Binding NewOrderCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="20,0" FontSize="13" Margin="0,0,10,0" />
                    <Button Content="&#xE7C3; CSV" Command="{Binding ExportCsvCommand}"
                            Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource TextSecondaryBrush}" Height="40" Padding="12,0" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- DATA GRID                                                  -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                      Style="{StaticResource ModernDataGrid}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" />

                    <DataGridTemplateColumn Header="رقم الطلب" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding OrderNumber}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBlueLightBrush}"
                                           TextDecorations="Underline" Cursor="Hand" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="الصيدلية" Binding="{Binding PharmacyName}" Width="*" />

                    <DataGridTemplateColumn Header="المصدر" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source}" Value="mobile">
                                                    <Setter Property="Background" Value="{StaticResource SuccessGlassBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="الإدارة" />
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}" Value="mobile">
                                                        <Setter Property="Text" Value="طلب من التطبيق" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ملاحظات الصيدلية" Binding="{Binding ClientNotes}" Width="160" />
                    <DataGridTextColumn Header="وقت الوصول" Binding="{Binding MobileCreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />

                    <DataGridTemplateColumn Header="الإجمالي" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FinalTotal, StringFormat={}{0:N2} ر.س}" FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryCyanBrush}" />
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='{}قبل الخصم: {0:N2}'}" FontSize="9"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="الخصم" Binding="{Binding Discount, StringFormat={}{0:N2}}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="14,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="سريع" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="مراجعة" Command="{Binding DataContext.QuickReviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource TransparentButtonStyle}" FontSize="11" Padding="6,0" />
                                    <Button Content="تجهيز" Command="{Binding DataContext.QuickPrepareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource TransparentButtonStyle}" FontSize="11" Padding="6,0" />
                                    <Button Content="مندوب" Command="{Binding DataContext.SendToDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource TransparentButtonStyle}" FontSize="11" Padding="6,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="الحالة" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="pending">
                                                    <Setter Property="Background" Value="{StaticResource WarningGlassBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="reviewed">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryCyanGlassBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="in_store">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryCyanGlassBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="with_driver">
                                                    <Setter Property="Background" Value="{StaticResource AccentPurpleLightBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="on_the_way">
                                                    <Setter Property="Background" Value="{StaticResource AccentPurpleLightBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="delivered">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryIndigoGlassBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="postponed">
                                                    <Setter Property="Background" Value="{StaticResource WarningGlassBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                    <Setter Property="Background" Value="{StaticResource DangerGlassBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="pending">
                                                        <Setter Property="Text" Value="قيد الانتظار" />
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="reviewed">
                                                        <Setter Property="Text" Value="تم المراجعة" />
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryCyanBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="in_store">
                                                        <Setter Property="Text" Value="في المخزن" />
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryCyanBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="with_driver">
                                                        <Setter Property="Text" Value="مع المندوب" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="on_the_way">
                                                        <Setter Property="Text" Value="في الطريق" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="delivered">
                                                        <Setter Property="Text" Value="تم التسليم" />
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryIndigoBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="postponed">
                                                        <Setter Property="Text" Value="مؤجل" />
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                        <Setter Property="Text" Value="ملغي" />
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />

                    <DataGridTemplateColumn Header="الإجراءات" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="&#xE8AF;" Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" Width="32" Height="32" FontSize="12" Padding="0" ToolTip="عرض التفاصيل" />
                                    <Button Content="&#xE749;" Command="{Binding DataContext.PrintGridOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Width="32" Height="32" FontSize="12" Padding="0" ToolTip="طباعة" Margin="6,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STATUS BAR                                                 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="{StaticResource CardBgBrush}" CornerRadius="14" Padding="16,12"
                BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource PrimaryGreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding StatusFilter, StringFormat='الحالة: {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <TextBlock Text="{Binding Orders.Count, StringFormat='{}{0} طلب'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- OVERLAY: Loading                                           -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.RowSpan="5" Background="{StaticResource OverlayBgBrush}" CornerRadius="20"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="240" Height="4" Style="{StaticResource ModernProgressBar}" Foreground="{StaticResource PrimaryGreenBrush}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- OVERLAY: Order Detail                                     -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.RowSpan="5" Background="{StaticResource OverlayBgBrush}"
                Visibility="{Binding ShowDetail, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardStyle}" Width="750" MaxWidth="800"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedDetailOrder.OrderNumber, StringFormat='طلب رقم {0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" />
                                <TextBlock Text="تفاصيل الطلب" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="&#xE749; طباعة" Command="{Binding PrintDetailOrderCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="14,0" FontSize="12" />
                                <Button Content="&#xE7C3; HTML" Command="{Binding ExportHtmlCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" FontSize="12" Margin="8,0,0,0" />
                                <Button Content="✕" Command="{Binding CloseDetailCommand}"
                                        Style="{StaticResource CloseButtonStyle}" Width="36" Height="36" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Order Info -->
                        <Border Grid.Row="1" Background="{StaticResource GlassCardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="رقم الطلب" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedDetailOrder.OrderNumber}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SelectedDetailOrder.Id, StringFormat='{}ID: {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="الصيدلية" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedDetailOrder.Pharmacy.Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="الحالة" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="delivered">
                                                        <Setter Property="Background" Value="{StaticResource SuccessGlassBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="cancelled">
                                                        <Setter Property="Background" Value="{StaticResource DangerGlassBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="pending">
                                                        <Setter Property="Background" Value="{StaticResource WarningGlassBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="postponed">
                                                        <Setter Property="Background" Value="{StaticResource WarningGlassBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="reviewed">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryCyanGlassBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="in_store">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryCyanGlassBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="with_driver">
                                                        <Setter Property="Background" Value="{StaticResource AccentPurpleLightBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="on_the_way">
                                                        <Setter Property="Background" Value="{StaticResource AccentPurpleLightBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="delivered">
                                                        <Setter Property="Text" Value="تم التسليم" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="cancelled">
                                                        <Setter Property="Text" Value="ملغي" />
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="pending">
                                                        <Setter Property="Text" Value="قيد الانتظار" />
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="postponed">
                                                        <Setter Property="Text" Value="مؤجل" />
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="reviewed">
                                                        <Setter Property="Text" Value="تم المراجعة" />
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryCyanBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="in_store">
                                                        <Setter Property="Text" Value="في المخزن" />
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryCyanBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="with_driver">
                                                        <Setter Property="Text" Value="مع المندوب" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetailOrder.Status}" Value="on_the_way">
                                                        <Setter Property="Text" Value="في الطريق" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="التاريخ" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedDetailOrder.CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Financial Summary -->
                        <Border Grid.Row="2" Background="{StaticResource GlassCardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="الإجمالي" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedDetailOrder.TotalAmount, StringFormat={}{0:N2}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="الخصم" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedDetailOrder.Discount, StringFormat={}{0:N2}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="المدفوع" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedDetailOrder.AmountPaid, StringFormat={}{0:N2}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="المتبقي" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedDetailOrder.RemainingAmount, StringFormat={}{0:N2}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Items Table -->
                        <Border Grid.Row="3" Background="{StaticResource CardBgBrush}" CornerRadius="14" Padding="0" Margin="0,0,0,20"
                                BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource GlassCardBrush}" CornerRadius="14,14,0,0" Padding="16,12">
                                    <TextBlock Text="المنتجات" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Border>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedDetailOrder.Items}" Margin="0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="16,10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ProductId}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Product.Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='{}x{0}'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding UnitPrice, StringFormat='{}{0:N2}'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Text="{Binding TotalPrice, StringFormat='{}{0:N2}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Status Transitions -->
                        <Border Grid.Row="4" Background="{StaticResource GlassCardBrush}" CornerRadius="14" Padding="20">
                            <StackPanel>
                                <TextBlock Text="تغيير الحالة" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Border CornerRadius="8" Background="{StaticResource WarningGlassBrush}" Margin="0,0,6,6">
                                        <Button Content="⏳ قيد الانتظار" Command="{Binding TransitionStatusCommand}" CommandParameter="pending"
                                                Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource WarningBrush}" FontSize="12" Height="34" Padding="12,0" />
                                    </Border>
                                    <Border CornerRadius="8" Background="{StaticResource PrimaryCyanGlassBrush}" Margin="0,0,6,6">
                                        <Button Content="مراجعة" Command="{Binding TransitionStatusCommand}" CommandParameter="reviewed"
                                                Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource PrimaryCyanBrush}" FontSize="12" Height="34" Padding="12,0" />
                                    </Border>
                                    <Border CornerRadius="8" Background="{StaticResource PrimaryCyanGlassBrush}" Margin="0,0,6,6">
                                        <Button Content="في المخزن" Command="{Binding TransitionStatusCommand}" CommandParameter="in_store"
                                                Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource PrimaryCyanBrush}" FontSize="12" Height="34" Padding="12,0" />
                                    </Border>
                                    <Border CornerRadius="8" Background="{StaticResource AccentPurpleLightBrush}" Margin="0,0,6,6">
                                        <Button Content="🚚 مع المندوب" Command="{Binding TransitionStatusCommand}" CommandParameter="with_driver"
                                                Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource AccentPurpleBrush}" FontSize="12" Height="34" Padding="12,0" />
                                    </Border>
                                    <Border CornerRadius="8" Background="{StaticResource AccentPurpleLightBrush}" Margin="0,0,6,6">
                                        <Button Content="🛣️ في الطريق" Command="{Binding TransitionStatusCommand}" CommandParameter="on_the_way"
                                                Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource AccentPurpleBrush}" FontSize="12" Height="34" Padding="12,0" />
                                    </Border>
                                    <Button Content="تم التسليم" Command="{Binding TransitionStatusCommand}" CommandParameter="delivered"
                                            Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="14,0" FontSize="12" Margin="0,0,6,6" />
                                    <Button Content="❌ إلغاء" Command="{Binding TransitionStatusCommand}" CommandParameter="cancelled"
                                            Style="{StaticResource DangerButtonStyle}" Height="34" Padding="14,0" FontSize="12" Margin="0,0,6,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- OVERLAY: New Order Editor                                 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.RowSpan="5" Background="{StaticResource OverlayBgBrush}"
                Visibility="{Binding ShowEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Style="{StaticResource CardStyle}" Width="700"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="طلب جديد" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                            <Button Content="✕" Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource CloseButtonStyle}" Width="36" Height="36" HorizontalAlignment="Left" />
                        </Grid>

                        <!-- Pharmacy -->
                        <Border Grid.Row="1" Background="{StaticResource GlassCardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الصيدلية:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,12,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Pharmacies}" SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedPharmacyId}"
                                          Style="{StaticResource ModernComboBox}" Height="40" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Barcode Search -->
                        <Border Grid.Row="2" Background="{StaticResource GlassCardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="إضافة منتج:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,12,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding FilteredProducts}" SelectedItem="{Binding SelectedProductForOrder}"
                                          IsTextSearchEnabled="True"
                                          Style="{StaticResource ModernComboBox}" Height="40" FontSize="12"
                                          Text="{Binding BarcodeSearch, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding UnitPrice, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="{StaticResource PrimaryGreenBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='{}{0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="➕" Command="{Binding AddProductByBarcodeCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Width="40" Height="40" FontSize="16" Padding="0" Margin="8,0,0,0" ToolTip="إضافة المنتج" />
                            </Grid>
                        </Border>

                        <!-- Items List -->
                        <Border Grid.Row="3" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="0" Margin="0,0,0,12"
                                BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" MaxHeight="240">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding NewItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,8" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ProductId}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Height="32"
                                                             Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Center" TextAlignment="Center" />
                                                    <TextBox Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Height="32"
                                                             Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Center" TextAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding TotalPrice, StringFormat={}{0:N2}}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryGreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <Button Grid.Column="4" Content="✕" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource DangerBrush}" FontSize="14" Width="36" Height="36" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Totals & Discount -->
                        <Border Grid.Row="4" Background="{StaticResource GlassCardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalAmount, StringFormat='الإجمالي: {0:N2} ر.س'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DiscountTypes}" SelectedItem="{Binding DiscountType}"
                                          Style="{StaticResource ModernComboBox}" Width="80" Height="36" FontSize="11" Margin="0,0,8,0" />
                                <TextBox Grid.Column="2" Text="{Binding Discount, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Width="100" Height="36" FontSize="12" VerticalContentAlignment="Center" TextAlignment="Center" Tag="الخصم" />
                            </Grid>
                        </Border>

                        <!-- Actions -->
                        <Border Grid.Row="5" Background="{StaticResource GlassCardBrush}" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="إلغاء" Command="{Binding CancelEditCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Height="40" Padding="24,0" FontSize="13" Margin="0,0,10,0" />
                                <Button Grid.Column="2" Content="💾 حفظ الطلب" Command="{Binding SaveOrderCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="28,0" FontSize="13" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
