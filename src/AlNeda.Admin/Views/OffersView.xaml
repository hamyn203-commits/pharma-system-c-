<UserControl x:Class="AlNeda.Admin.Views.OffersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource PageBgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="OfferSurface" TargetType="Border">
            <Setter Property="Background" Value="#F20B1626" />
            <Setter Property="BorderBrush" Value="#2738BDF8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="SmallPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#1822363E" />
            <Setter Property="BorderBrush" Value="#3347556B" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource OfferSurface}" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="إدارة العروض" Foreground="{StaticResource TextPrimaryBrush}" FontSize="26" FontWeight="Black" />
                    <TextBlock Text="إنشاء العروض ومراجعة ظهورها على تطبيق الصيدلي ومتابعة الأداء"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Content="إنشاء عرض جديد" Command="{Binding NewOfferCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="20,0" Margin="8,0,0,0" />
                    <Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="18,0" Margin="8,0,0,0" />
                    <Button Content="تصدير تقرير العروض" Command="{Binding ExportReportCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="18,0" />
                </WrapPanel>
            </Grid>
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding StatCards}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#F0111E32" BorderBrush="{Binding Accent}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#FF020617" Opacity="0.22" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Value}" Foreground="{Binding Accent}" FontSize="26" FontWeight="Black" />
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="38" Height="38" CornerRadius="12" Background="#1722363E" BorderBrush="{Binding Accent}" BorderThickness="1">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Accent}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" MinWidth="540" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource OfferSurface}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="العروض الحالية" Style="{StaticResource SectionTitle}" />
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBox Text="{Binding OfferSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Style="{StaticResource ModernComboBox}" Height="36" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding DateFilters}" SelectedItem="{Binding DateFilter}" Style="{StaticResource ModernComboBox}" Height="36" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredOffers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectOfferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Cursor="Hand"
                                            Margin="0,0,0,10">
                                        <Border Background="{Binding CardBackground}"
                                                BorderBrush="{Binding ActiveBorder}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="12">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                                                    <Border Grid.Column="1" Background="{Binding Accent}" CornerRadius="10" Padding="8,4" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource PrimaryCyanBrush}" FontSize="11" Margin="0,8,0,0" />
                                                <UniformGrid Columns="3" Margin="0,10,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Views}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" />
                                                        <TextBlock Text="مشاهدات" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Orders}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" />
                                                        <TextBlock Text="طلبات" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Conversion}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" />
                                                        <TextBlock Text="تحويل" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Text="{Binding EndsAtLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource OfferSurface}" Margin="0,0,12,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#141E293B" BorderBrush="#2638BDF8" BorderThickness="0,0,0,1" Padding="14" CornerRadius="16,16,0,0">
                        <ItemsControl ItemsSource="{Binding EditorSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" BorderBrush="{Binding Accent}" BorderThickness="1" CornerRadius="14" Padding="10,7" Margin="4,0">
                                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Number}" Foreground="{Binding Accent}" FontWeight="Black" />
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14">
                        <StackPanel>
                            <Border Style="{StaticResource OfferSurface}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="بيانات العرض" Style="{StaticResource SectionTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="عنوان العرض" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding OfferTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="40" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="نوع العرض" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding OfferTypes}" SelectedItem="{Binding OfferType}" Style="{StaticResource ModernComboBox}" Height="40" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="سطر مختصر يظهر في التطبيق" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding OfferSubtitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="40" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="تاريخ البداية" Style="{StaticResource FieldLabel}" />
                                            <DatePicker SelectedDate="{Binding StartsAt}" Height="40" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="تاريخ النهاية" Style="{StaticResource FieldLabel}" />
                                            <DatePicker SelectedDate="{Binding EndsAt}" Height="40" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="حالة العرض" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding OfferStates}" SelectedItem="{Binding OfferState}" Style="{StaticResource ModernComboBox}" Height="40" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OfferSurface}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="المنتجات المرتبطة بالعرض" Style="{StaticResource SectionTitle}" DockPanel.Dock="Right" />
                                        <Button Content="إضافة منتج" Command="{Binding AddOfferProductCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="110" Height="34" HorizontalAlignment="Left" />
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding OfferProducts}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              MinHeight="168"
                                              MaxHeight="235"
                                              Background="#FF07111F"
                                              BorderBrush="#3347556B"
                                              GridLinesVisibility="None"
                                              Foreground="{StaticResource TextPrimaryBrush}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="المنتج" Width="2*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.ProductNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                                                  Style="{StaticResource ModernComboBox}"
                                                                  Height="34" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="كمية العرض" Binding="{Binding OfferQuantity, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridTextColumn Header="قبل الخصم" Binding="{Binding OldPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="*" />
                                            <DataGridTextColumn Header="بعد الخصم" Binding="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="*" />
                                            <DataGridTextColumn Header="الخصم" Binding="{Binding DiscountLabel}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="حد أدنى" Binding="{Binding MinimumOrder, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridTextColumn Header="هدية" Binding="{Binding GiftProduct, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridTextColumn Header="تحذير" Binding="{Binding Warning}" Width="1.5*" IsReadOnly="True" />
                                            <DataGridTemplateColumn Header="" Width="58">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="حذف"
                                                                Command="{Binding DataContext.RemoveOfferProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Height="30" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource OfferSurface}">
                                    <StackPanel>
                                        <TextBlock Text="الاستهداف" Style="{StaticResource SectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding TargetRules}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Content="{Binding Label}"
                                                                 GroupName="TargetRules"
                                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 Margin="0,0,12,8" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource SmallPill}" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding TargetedPharmaciesLabel}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource OfferSurface}">
                                    <StackPanel>
                                        <TextBlock Text="فحص جاهزية النشر" Style="{StaticResource SectionTitle}" />
                                        <ItemsControl ItemsSource="{Binding ReadinessChecks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding Accent}" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="22" />
                                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource OfferSurface}" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="الصورة والوصف" Style="{StaticResource SectionTitle}" DockPanel.Dock="Right" />
                                        <Button Content="رفع أو تغيير الصورة" Command="{Binding ChooseImageCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="34" Width="140" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding ImageShortLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="مقاسات مقترحة: Banner 1920x700 | Card 1080x1350 | Thumbnail 600x600"
                                               Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,6,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="وصف العرض" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding OfferDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MinHeight="78" TextWrapping="Wrap" AcceptsReturn="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="شروط العرض" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding OfferTerms, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MinHeight="78" TextWrapping="Wrap" AcceptsReturn="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="ملاحظات داخلية" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" MinHeight="78" TextWrapping="Wrap" AcceptsReturn="True" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource OfferSurface}">
                                <StackPanel>
                                    <TextBlock Text="تحليلات العرض" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding AnalyticsCards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#121E293B" BorderBrush="{Binding Accent}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,8,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Value}" Foreground="{Binding Accent}" FontSize="18" FontWeight="Black" />
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="تفاعل الصيدليات" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" Margin="0,8,0,8" />
                                    <DataGrid ItemsSource="{Binding PharmacyInteractions}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              MaxHeight="190"
                                              Background="#FF07111F"
                                              BorderBrush="#3347556B"
                                              GridLinesVisibility="None"
                                              Foreground="{StaticResource TextPrimaryBrush}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="الصيدلية" Binding="{Binding PharmacyName}" Width="1.5*" />
                                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="*" />
                                            <DataGridTextColumn Header="المشاهدة" Binding="{Binding ViewedAt}" Width="*" />
                                            <DataGridCheckBoxColumn Header="ضغطت" Binding="{Binding Clicked}" Width="70" />
                                            <DataGridCheckBoxColumn Header="أضافت" Binding="{Binding AddedToCart}" Width="70" />
                                            <DataGridCheckBoxColumn Header="طلبت" Binding="{Binding Ordered}" Width="70" />
                                            <DataGridTextColumn Header="آخر طلب" Binding="{Binding LastOrder}" Width="*" />
                                            <DataGridTextColumn Header="القيمة" Binding="{Binding OrderValue}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F0142238" BorderBrush="#2638BDF8" BorderThickness="0,1,0,0" Padding="12" CornerRadius="0,0,16,16">
                        <WrapPanel FlowDirection="RightToLeft">
                            <Button Content="حفظ كمسودة" Command="{Binding SaveDraftCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="18,0" Margin="0,0,8,0" />
                            <Button Content="إرسال للمراجعة" Command="{Binding SubmitReviewCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="18,0" Margin="0,0,8,0" />
                            <Button Content="نشر العرض" Command="{Binding PublishCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="22,0" Margin="0,0,8,0" />
                            <Button Content="إيقاف العرض" Command="{Binding PauseCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="18,0" Margin="0,0,8,0" />
                            <Button Content="إرسال تجربة لصيدلية واحدة" Command="{Binding SendTestCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="18,0" Margin="0,0,8,0" />
                            <Button Content="نسخ العرض" Command="{Binding DuplicateCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="18,0" Margin="0,0,8,0" />
                            <Button Content="حذف العرض" Command="{Binding DeleteOfferCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="18,0" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource OfferSurface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="معاينة العرض على تطبيق الصيدلي" Style="{StaticResource SectionTitle}" />
                    <ComboBox Grid.Row="1" ItemsSource="{Binding PreviewModes}" SelectedItem="{Binding PreviewMode}" Style="{StaticResource ModernComboBox}" Height="38" Margin="0,0,0,12" />

                    <Border Grid.Row="2" Background="#FF040A12" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="32" Padding="12" MaxWidth="292" HorizontalAlignment="Center">
                        <Border Background="#FF071314" CornerRadius="24" Padding="14">
                            <StackPanel>
                                <Border Background="#141E293B" CornerRadius="16" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="صيدلية الندى الجديدة" Foreground="White" FontSize="13" FontWeight="Bold" />
                                        <TextBlock Text="{Binding PreviewMode}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                    </StackPanel>
                                </Border>
                                <Border Height="128" CornerRadius="18" Background="#1822363E" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding PreviewImagePath}" Stretch="UniformToFill" Opacity="0.9" />
                                        <Border Background="#55111E32" />
                                        <TextBlock Text="{Binding PreviewDiscountLabel}" Foreground="#FF022C22" FontWeight="Black" Background="#FF31D0AA" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding OfferTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Black" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding OfferSubtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="{Binding PreviewPriceLabel}" Foreground="{StaticResource SuccessBrush}" FontSize="18" FontWeight="Black" />
                                    <TextBlock Text="{Binding PreviewOldPriceLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextDecorations="Strikethrough" Margin="10,5,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProductPreviewSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding PreviewExpiryLabel}" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,8,0,0" />
                                <Button Content="أضف للطلب" Style="{StaticResource PrimaryButtonStyle}" Height="38" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                </Grid>
            </Border>
