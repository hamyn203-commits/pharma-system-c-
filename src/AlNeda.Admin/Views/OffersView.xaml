<UserControl x:Class="AlNeda.Admin.Views.OffersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource PageBgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="OffSurface" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="OffLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="OffPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#1822363E" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="400" />
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Header ═══ -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="إدارة العروض" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="إنشاء العروض ومراجعة ظهورها على تطبيق الصيدلي ومتابعة الأداء"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Content="+ عرض جديد" Command="{Binding NewOfferCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="18,0" Margin="6,0,0,0" />
                    <Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" Margin="6,0,0,0" />
                    <Button Content="تصدير" Command="{Binding ExportReportCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="14,0" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ═══ Row 1: Stat Cards ═══ -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding StatCards}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Value}" Foreground="{Binding Accent}" FontSize="22" FontWeight="Black" />
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="10"
                                    Background="#1722363E" BorderBrush="{Binding Accent}" BorderThickness="1">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{Binding Accent}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══ Row 2: Three-column layout ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="300" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Column 0: Offers List ═══ -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="العروض الحالية" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBox Text="{Binding OfferSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="34"
                                 Tag="ابحث عن عرض..." />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"
                                      Style="{StaticResource ModernComboBox}" Height="32" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding DateFilters}" SelectedItem="{Binding DateFilter}"
                                      Style="{StaticResource ModernComboBox}" Height="32" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredOffers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectOfferCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                            Margin="0,0,0,8">
                                        <Border Background="{Binding CardBackground}"
                                                BorderBrush="{Binding ActiveBorder}" BorderThickness="1"
                                                CornerRadius="12" Padding="10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontWeight="Bold" FontSize="13" TextWrapping="Wrap" />
                                                    <Border Grid.Column="1" Background="{Binding Accent}" CornerRadius="8" Padding="6,3" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource PrimaryCyanBrush}" FontSize="10" Margin="0,6,0,0" />
                                                <UniformGrid Columns="3" Margin="0,8,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Views}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" />
                                                        <TextBlock Text="مشاهدات" Foreground="{StaticResource TextMutedBrush}" FontSize="9" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Orders}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" />
                                                        <TextBlock Text="طلبات" Foreground="{StaticResource TextMutedBrush}" FontSize="9" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Conversion}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="12" />
                                                        <TextBlock Text="تحويل" Foreground="{StaticResource TextMutedBrush}" FontSize="9" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <TextBlock Text="{Binding EndsAtLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <ContentControl Visibility="{Binding FilteredOffers.Count, Converter={x:Null}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                                <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="24" HorizontalAlignment="Center" Opacity="0.6" />
                                <TextBlock Text="لا توجد عروض" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </ContentControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══ Column 1: Editor (main content) ═══ -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="300" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Editor steps header -->
                    <Border Grid.Row="0" Background="#141E293B" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="12" CornerRadius="12,12,0,0">
                        <ItemsControl ItemsSource="{Binding EditorSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" BorderBrush="{Binding Accent}"
                                            BorderThickness="1" CornerRadius="10" Padding="8,5" Margin="3,0">
                                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Number}" Foreground="{Binding Accent}" FontWeight="Black" FontSize="12" />
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Scrollable editor body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                        <StackPanel>
                            <!-- Section: Basic Info (compact 2-col) -->
                            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="بيانات العرض" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="عنوان العرض" Style="{StaticResource OffLabel}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OfferTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,6" />

                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="نوع العرض" Style="{StaticResource OffLabel}" />
                                        <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding OfferTypes}" SelectedItem="{Binding OfferType}"
                                                  Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,6" />

                                        <TextBlock Grid.Row="0" Grid.Column="6" Text="الحالة" Style="{StaticResource OffLabel}" />
                                        <ComboBox Grid.Row="0" Grid.Column="7" ItemsSource="{Binding OfferStates}" SelectedItem="{Binding OfferState}"
                                                  Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,6" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="السطر المختصر" Style="{StaticResource OffLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OfferSubtitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}" Height="34" />

                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="تاريخ البداية" Style="{StaticResource OffLabel}" />
                                        <DatePicker Grid.Row="1" Grid.Column="4" SelectedDate="{Binding StartsAt}" Height="34" />

                                        <TextBlock Grid.Row="1" Grid.Column="6" Text="تاريخ النهاية" Style="{StaticResource OffLabel}" />
                                        <DatePicker Grid.Row="1" Grid.Column="7" SelectedDate="{Binding EndsAt}" Height="34" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Section: Products (compact DataGrid) -->
                            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="المنتجات المرتبطة" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="Bold" DockPanel.Dock="Right" />
                                        <Button Content="+ إضافة منتج" Command="{Binding AddOfferProductCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="30" HorizontalAlignment="Left" FontSize="11" />
                                    </DockPanel>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding OfferProducts}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              MinHeight="120" MaxHeight="200"
                                              Style="{StaticResource ModernDataGrid}"
                                              CellStyle="{StaticResource ModernDataGridCell}"
                                              RowStyle="{StaticResource ModernDataGridRow}"
                                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                              GridLinesVisibility="None"
                                              Margin="0,8,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="المنتج" Width="1.5*" MinWidth="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.ProductNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                                                  Style="{StaticResource ModernComboBox}" Height="30" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="كمية العرض" Binding="{Binding OfferQuantity, UpdateSourceTrigger=PropertyChanged}" Width="0.6*" MinWidth="60" />
                                            <DataGridTextColumn Header="قبل الخصم" Binding="{Binding OldPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="0.6*" MinWidth="60" />
                                            <DataGridTextColumn Header="بعد الخصم" Binding="{Binding NewPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="0.6*" MinWidth="60" />
                                            <DataGridTextColumn Header="الخصم" Binding="{Binding DiscountLabel}" Width="0.5*" MinWidth="50" IsReadOnly="True" />
                                            <DataGridTextColumn Header="حد أدنى" Binding="{Binding MinimumOrder, UpdateSourceTrigger=PropertyChanged}" Width="0.6*" MinWidth="50" />
                                            <DataGridTextColumn Header="هدية" Binding="{Binding GiftProduct, UpdateSourceTrigger=PropertyChanged}" Width="0.6*" MinWidth="50" />
                                            <DataGridTemplateColumn Header="" Width="48" MinWidth="44">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="&#xE74D;"
                                                                Command="{Binding DataContext.RemoveOfferProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ActionButtonStyle}"
                                                                Width="30" Height="26"
                                                                FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                Foreground="{StaticResource DangerBrush}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- Section: Targeting + Readiness (side by side) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="الاستهداف" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding TargetRules}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Content="{Binding Label}"
                                                                 GroupName="TargetRules"
                                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 Margin="0,0,10,6" FontSize="12" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Style="{StaticResource OffPill}" Margin="0,6,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TargetedPharmaciesLabel}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="فحص جاهزية النشر" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding ReadinessChecks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                                   Foreground="{Binding Accent}" FontSize="12" Width="20" />
                                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="11" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Section: Image + Description (compact) -->
                            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="الصورة والوصف" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="Bold" DockPanel.Dock="Right" />
                                        <Button Content="رفع صورة" Command="{Binding ChooseImageCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Height="30" Width="100" FontSize="11" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding ImageShortLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                    <TextBlock Text="مقاسات: Banner 1920x700 | Card 1080x1350 | Thumbnail 600x600"
                                               Foreground="{StaticResource WarningBrush}" FontSize="10" Margin="0,4,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="وصف العرض" Style="{StaticResource OffLabel}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding OfferDescription, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="شروط العرض" Style="{StaticResource OffLabel}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding OfferTerms, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="ملاحظات داخلية" Style="{StaticResource OffLabel}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Section: Analytics -->
                            <Border Style="{StaticResource CardStyle}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="تحليلات العرض" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding AnalyticsCards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#121E293B" BorderBrush="{Binding Accent}" BorderThickness="1"
                                                        CornerRadius="10" Padding="8" Margin="0,0,6,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Value}" Foreground="{Binding Accent}" FontSize="16" FontWeight="Black" />
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="تفاعل الصيدليات" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="13" FontWeight="Bold" Margin="0,6,0,6" />
                                    <DataGrid ItemsSource="{Binding PharmacyInteractions}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              MinHeight="80" MaxHeight="160"
                                              Style="{StaticResource ModernDataGrid}"
                                              CellStyle="{StaticResource ModernDataGridCell}"
                                              RowStyle="{StaticResource ModernDataGridRow}"
                                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                              GridLinesVisibility="None">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="الصيدلية" Binding="{Binding PharmacyName}" Width="1.5*" MinWidth="100" />
                                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="0.6*" MinWidth="70" />
                                            <DataGridTextColumn Header="المشاهدة" Binding="{Binding ViewedAt}" Width="0.6*" MinWidth="70" />
                                            <DataGridCheckBoxColumn Header="ضغطت" Binding="{Binding Clicked}" Width="54" MinWidth="44" />
                                            <DataGridCheckBoxColumn Header="أضافت" Binding="{Binding AddedToCart}" Width="54" MinWidth="44" />
                                            <DataGridCheckBoxColumn Header="طلبت" Binding="{Binding Ordered}" Width="54" MinWidth="44" />
                                            <DataGridTextColumn Header="آخر طلب" Binding="{Binding LastOrder}" Width="0.6*" MinWidth="70" />
                                            <DataGridTextColumn Header="القيمة" Binding="{Binding OrderValue}" Width="0.6*" MinWidth="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom action bar -->
                    <Border Grid.Row="2" Background="#F0142238" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="10" CornerRadius="0,0,12,12">
                        <WrapPanel FlowDirection="RightToLeft">
                            <Button Content="نشر" Command="{Binding PublishCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Height="34" Padding="18,0" Margin="0,0,6,0" FontSize="12" />
                            <Button Content="مسودة" Command="{Binding SaveDraftCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="14,0" Margin="0,0,6,0" FontSize="12" />
                            <Button Content="مراجعة" Command="{Binding SubmitReviewCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="14,0" Margin="0,0,6,0" FontSize="12" />
                            <Button Content="إيقاف" Command="{Binding PauseCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="14,0" Margin="0,0,6,0" FontSize="12" />
                            <Button Content="اختبار" Command="{Binding SendTestCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="14,0" Margin="0,0,6,0" FontSize="12" />
                            <Button Content="نسخ" Command="{Binding DuplicateCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="14,0" Margin="0,0,6,0" FontSize="12" />
                            <Button Content="حذف" Command="{Binding DeleteOfferCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="14,0" FontSize="12" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ Column 2: Preview ═══ -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="300" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="معاينة التطبيق" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />

                    <ComboBox Grid.Row="1" ItemsSource="{Binding PreviewModes}" SelectedItem="{Binding PreviewMode}"
                              Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,10" />

                    <!-- Phone mockup -->
                    <Border Grid.Row="2" Background="#FF040A12" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="24" Padding="10"
                            HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="260">
                        <Border Background="#FF071314" CornerRadius="18" Padding="12">
                            <StackPanel>
                                <!-- Pharmacy header -->
                                <Border Background="#141E293B" CornerRadius="12" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="صيدلية الندى" Foreground="White" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Text="{Binding PreviewMode}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" />
                                    </StackPanel>
                                </Border>

                                <!-- Image area with fallback -->
                                <Border Height="110" CornerRadius="14" Background="#1822363E" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding PreviewImagePath}" Stretch="UniformToFill"
                                               Visibility="{Binding OfferImagePath, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" />
                                        <Border Background="#55111E32" />
                                        <TextBlock Text="{Binding PreviewDiscountLabel}"
                                                   Foreground="#FF022C22" FontWeight="Black"
                                                   Background="#FF31D0AA" Padding="8,3"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                                                   FontSize="13" />
                                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="28"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"
                                                   Visibility="{Binding OfferImagePath, Converter={StaticResource StringEmptyToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding OfferTitle}" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16" FontWeight="Black" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding OfferSubtitle}" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,3,0,8" />

                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="{Binding PreviewPriceLabel}" Foreground="{StaticResource SuccessBrush}"
                                               FontSize="16" FontWeight="Black" />
                                    <TextBlock Text="{Binding PreviewOldPriceLabel}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10" TextDecorations="Strikethrough" Margin="8,4,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding ProductPreviewSummary}" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />

                                <TextBlock Text="{Binding PreviewExpiryLabel}" Foreground="{StaticResource WarningBrush}"
                                           FontSize="10" Margin="0,6,0,0" />

                                <Button Content="أضف للطلب"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="0,10,0,0"
                                        IsEnabled="False" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Status message -->
                    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource WarningBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
