<UserControl x:Class="AlNeda.Admin.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:conv="clr-namespace:AlNeda.Admin.Converters"
             xmlns:models="clr-namespace:AlNeda.Core.Models"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Resources>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter" />

        <!-- ─── Report Type Card Template ─── -->
        <DataTemplate x:Key="ReportTypeCard">
            <Border x:Name="CardBorder" CornerRadius="14" Padding="16,14" Margin="0,0,0,8"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                    Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                            Background="{StaticResource StatCardGreenGradient}" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource GlassCardBrush}" />
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryIndigoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="CardBorder" Property="Background" Value="#1AFFFFFF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ─── Chart Bar Template ─── -->
        <DataTemplate x:Key="ChartBarTemplate">
            <Grid Margin="0,0,0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Height="40" VerticalAlignment="Bottom"
                        CornerRadius="4,4,0,0" Margin="2,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="{Binding Color}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
            </Grid>
        </DataTemplate>

        <!-- ─── KPI Card Style ─── -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
            <Setter Property="Effect" Value="{StaticResource CardShadow}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ─── Mini Bar DataTemplate ─── -->
        <DataTemplate x:Key="MiniBarTemplate">
            <Border Height="4" CornerRadius="2" Margin="0,0,2,0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" />
        </DataTemplate>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="32,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- LEFT SIDEBAR – Report Types                                 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="التقارير المالية" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" Margin="0,0,0,16" />
                <ListBox ItemsSource="{Binding ReportTypes}" SelectedItem="{Binding SelectedReportType}"
                         Background="Transparent" BorderThickness="0"
                         ItemTemplate="{StaticResource ReportTypeCard}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT                                                -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header + Filters -->
                <RowDefinition Height="Auto" /> <!-- KPI Cards -->
                <RowDefinition Height="*" />    <!-- Main Content -->
                <RowDefinition Height="Auto" /> <!-- Bottom Bar -->
            </Grid.RowDefinitions>

            <!-- ─── HEADER & FILTERS ─── -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedReportType.Title, FallbackValue='التقارير المالية'}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding SelectedReportType.Description, FallbackValue='تحليل مالي شامل'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" FontSize="13" />
                </StackPanel>

                <!-- Filter Bar -->
                <Border HorizontalAlignment="Left" Background="{StaticResource CardBgBrush}" CornerRadius="14"
                        Padding="20,12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1"
                        Effect="{StaticResource CardShadow}" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- From -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="من:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0" />
                            <DatePicker SelectedDate="{Binding FilterFrom}"
                                         Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource BorderMutedBrush}"
                                         Height="36" FontSize="12" />
                        </StackPanel>
                        <!-- To -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="إلى:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,8,0" />
                            <DatePicker SelectedDate="{Binding FilterTo}"
                                         Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="{StaticResource BorderMutedBrush}"
                                         Height="36" FontSize="12" />
                        </StackPanel>
                        <!-- Period Type -->
                        <ComboBox ItemsSource="{Binding PeriodTypes}" SelectedItem="{Binding SelectedPeriodType}"
                                  Style="{StaticResource ModernComboBox}" Height="36" FontSize="12" Width="100" Margin="0,0,16,0" />
                        <!-- Apply -->
                        <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="36" FontSize="12" Padding="16,0" />
                        <!-- Toggle Filters -->
                        <Button Content="{Binding ShowFilters, Converter={StaticResource BoolToTextConverter}}" 
                                Command="{Binding ToggleFiltersCommand}"
                                Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" FontSize="18"
                                ToolTip="إخفاء/إظهار الفلاتر" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ─── KPI CARDS ─── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"
                          Margin="0,0,0,20" Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <!-- Total Revenue -->
                    <Border Style="{StaticResource KpiCardStyle}" Background="{StaticResource CardBgBrush}" Width="200" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardGreenGradient}">
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="إجمالي الإيرادات" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N2} ر.س}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Border CornerRadius="6" Padding="6,2" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Background="{StaticResource PrimaryGreenGlassBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RevenueChange, StringFormat={}{0:F1}%}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                                    <TextBlock Text=" عن الشهر الماضي" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Net Profit -->
                    <Border Style="{StaticResource KpiCardStyle}" Background="{StaticResource CardBgBrush}" Width="200" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardBlueGradient}">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="صافي الربح" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding NetProfit, StringFormat={}{0:N2} ر.س}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Border CornerRadius="6" Padding="6,2" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Background="{Binding ProfitMargin, Converter={StaticResource ProfitMarginToBrushConverter}}">
                                <TextBlock Text="{Binding ProfitMargin, StringFormat={}هامش الربح: {0:F1}%}" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBlueLightBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Total Expenses -->
                    <Border Style="{StaticResource KpiCardStyle}" Background="{StaticResource CardBgBrush}" Width="200" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardAmberGradient}">
                                    <TextBlock Text="📉" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="إجمالي المصروفات" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding TotalExpenses, StringFormat={}{0:N2} ر.س}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Border CornerRadius="6" Padding="6,2" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Background="{StaticResource WarningGlassBrush}">
                                <TextBlock Text="{Binding TotalDiscount, StringFormat={}خصوم: {0:N2}}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Orders Count -->
                    <Border Style="{StaticResource KpiCardStyle}" Background="{StaticResource CardBgBrush}" Width="200" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardPurpleGradient}">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="الطلبات" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding TotalOrders}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border CornerRadius="4" Padding="6,2" Background="{StaticResource PrimaryGreenGlassBrush}">
                                    <TextBlock Text="{Binding PaidOrders, StringFormat={}{0} مدفوع}" FontSize="10" Foreground="{StaticResource PrimaryGreenBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0" Background="{StaticResource WarningGlassBrush}">
                                    <TextBlock Text="{Binding PendingOrders, StringFormat={}{0} معلق}" FontSize="10" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Average Order -->
                    <Border Style="{StaticResource KpiCardStyle}" Background="{StaticResource CardBgBrush}" Width="200">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardGreenGradient}">
                                    <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="متوسط الطلب" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding AverageOrder, StringFormat={}{0:N2} ر.س}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Border CornerRadius="6" Padding="6,2" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Background="{StaticResource PrimaryGreenGlassBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="الضريبة: " FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding TotalTax, StringFormat={}{0:N2}}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── MAIN CONTENT ─── -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0"
                    Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ─── Chart / Visual Area ─── -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="0,0,0,1"
                            Padding="24,16" Background="{StaticResource GlassCardBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <!-- Revenue Trend Mini Chart -->
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="اتجاه الإيرادات" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding RevenueTrend.Count, StringFormat='({0} نقطة)'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding RevenueTrend}" Height="100">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate >
                                            <Grid Width="20" VerticalAlignment="Bottom" Margin="1,0">
                                                <Border VerticalAlignment="Bottom" Height="60" CornerRadius="3,3,0,0" Margin="2,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                            <GradientStop Color="#0DFFFFFF" Offset="0" />
                                                            <GradientStop Color="{Binding Color}" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Category / Expense Breakdown -->
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="توزيع حسب الفئة" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding CategoryRevenue}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate >
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="8,0"
                                                        HorizontalAlignment="Left" MinWidth="20" Width="{Binding Value, FallbackValue=100}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#0D000000" Offset="0" />
                                                            <GradientStop Color="{Binding Color}" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ─── Toolbar ─── -->
                    <Border Grid.Row="1" Padding="16,12,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="📋 جدول" Command="{Binding ToggleGridViewCommand}"
                                    Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0" />
                            <Button Content="📄 CSV" Command="{Binding ExportToCsvCommand}"
                                    Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0" />
                            <Button Content="📕 PDF" Command="{Binding ExportToPdfCommand}"
                                    Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0" />
                            <Button Content="🖨️ طباعة" Command="{Binding PrintReportCommand}"
                                    Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,16,0" />
                            <Button Content="📋 نسخ" Command="{Binding CopyToClipboardCommand}"
                                    Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- ─── Data Grid ─── -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding GridData}"
                              Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Style="{StaticResource ModernDataGrid}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              AutoGenerateColumns="True" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              Margin="16,0" />

                    <!-- ─── Content Views ─── -->
                    <!-- Revenue List -->
                    <ScrollViewer Grid.Row="1" Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto" Margin="16,0">
                        <StackPanel>
                            <!-- Revenue Items -->
                            <ItemsControl ItemsSource="{Binding RevenueData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate >
                                        <Border Background="{StaticResource GlassCardBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,6"
                                                BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Period}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NetRevenue, StringFormat={}صافي: {0:N2} ر.س}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding GrossRevenue, StringFormat='إجمالي: {0:N2}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text=" | " FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding Discounts, StringFormat='خصم: {0:N2}'}" FontSize="10" Foreground="{StaticResource WarningBrush}" />
                                                        <TextBlock Text=" | " FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding Tax, StringFormat='ضريبة: {0:N2}'}" FontSize="10" Foreground="{StaticResource PrimaryBlueLightBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="8" Padding="8,4" Background="{StaticResource PrimaryGreenGlassBrush}" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding OrderCount, StringFormat='{}{0} طلب'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Border CornerRadius="4" Padding="6,2" Background="{StaticResource DangerGlassBrush}" Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding Refunds, StringFormat='مرتجع: {0:N2}'}" FontSize="10" Foreground="{StaticResource DangerBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Profit Items -->
                            <ItemsControl ItemsSource="{Binding ProfitData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate >
                                        <Border Background="{StaticResource GlassCardBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,6"
                                                BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="إيرادات: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding Revenue, StringFormat={}{0:N2}}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                                                        <TextBlock Text="  |  " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="تكلفة: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding CostOfGoods, StringFormat={}{0:N2}}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                                        <TextBlock Text="  |  " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="صافي: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock Text="{Binding NetProfit, StringFormat={}{0:N2}}" FontSize="13" FontWeight="Bold" Foreground="{Binding NetProfit, Converter={StaticResource PositiveNegativeToBrushConverter}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="8" Padding="8,4" HorizontalAlignment="Center"
                                                        Background="{StaticResource PrimaryGreenGlassBrush}">
                                                    <TextBlock Text="{Binding NetMargin, StringFormat='{}هامش: {0:F1}%'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Top Products -->
                            <ItemsControl ItemsSource="{Binding TopProductsData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate >
                                        <Border Background="{StaticResource GlassCardBrush}" CornerRadius="10" Padding="16,10" Margin="0,0,0,4"
                                                BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{StaticResource PrimaryGreenGlassBrush}">
                                                    <TextBlock Text="{Binding Rank}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0">
                                                    <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Revenue, StringFormat={}{0:N2}}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Profit, StringFormat={}{0:N2}}" FontSize="12" FontWeight="Bold" Foreground="{Binding Profit, Converter={StaticResource PositiveNegativeToBrushConverter}}" />
                                                    <TextBlock Text="{Binding Margin, StringFormat={}{0:F1}%}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="4" CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                                                        Background="{StaticResource PrimaryBlueGlassBrush}">
                                                    <TextBlock Text="{Binding QuantitySold, StringFormat='{}{0} وحدة'}" FontSize="10" Foreground="{StaticResource PrimaryBlueLightBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Pharmacies -->
                            <ItemsControl ItemsSource="{Binding PharmaciesData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate >
                                        <Border Background="{StaticResource GlassCardBrush}" CornerRadius="10" Padding="16,10" Margin="0,0,0,4"
                                                BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{StaticResource PrimaryBlueGlassBrush}">
                                                    <TextBlock Text="{Binding Rank}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Border CornerRadius="4" Padding="6,1" Background="{StaticResource PrimaryGreenGlassBrush}">
                                                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{StaticResource PrimaryGreenBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalSales, StringFormat='مبيعات: {0:N2}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryGreenBrush}" />
                                                    <TextBlock Text="{Binding OrderCount, StringFormat='{}{0} طلب'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="الرصيد" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Balance, StringFormat={}{0:N2}}" FontSize="14" FontWeight="Bold" Foreground="{Binding Balance, Converter={StaticResource BalanceColorConverter}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding AverageOrderValue, StringFormat='{}معدل: {0:N2}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding LastOrderDate, StringFormat='{}آخر طلب: {0:MM/dd}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Period Comparison -->
                            <ItemsControl ItemsSource="{Binding ComparisonData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate >
                                        <Border Background="{StaticResource GlassCardBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,6"
                                                BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Metric}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="الفترة الحالية" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding CurrentPeriod, StringFormat={}{0:N2}}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryGreenBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="الفترة السابقة" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding PreviousPeriod, StringFormat={}{0:N2}}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="3" CornerRadius="8" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Background="{Binding Trend, Converter={StaticResource TrendToBrushConverter}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ChangePercent, StringFormat='{}{0:F1}%'}" FontSize="14" FontWeight="Bold"
                                                                   Foreground="{Binding Trend, Converter={StaticResource TrendToForegroundConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Expenses -->
                            <ItemsControl ItemsSource="{Binding ExpenseData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate >
                                        <Border Background="{StaticResource GlassCardBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,6"
                                                BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource StatCardAmberGradient}" Margin="0,0,12,0">
                                                        <TextBlock Text="📉" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding Count, StringFormat='{}{0} عملية'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:N2} ر.س}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="6" Padding="6,2" Background="{StaticResource WarningGlassBrush}" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Percentage, StringFormat={}{0:F1}%}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ─── Empty State ─── -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="64" HorizontalAlignment="Center" Opacity="0.3" />
                    <TextBlock Text="اختر تقريراً ماليّاً من القائمة" FontSize="16" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="سيتم عرض التحليلات المالية والمخططات البيانية هنا" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.6" />
                </StackPanel>
            </Border>

            <!-- ─── Loading ─── -->
            <Border Grid.Row="2" Background="{StaticResource OverlayBgBrush}" CornerRadius="20"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="240" Height="4" Style="{StaticResource ModernProgressBar}" Foreground="{StaticResource PrimaryIndigoBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="13" />
                </StackPanel>
            </Border>

            <!-- ─── STATUS BAR ─── -->
            <Border Grid.Row="3" Background="{StaticResource CardBgBrush}" CornerRadius="14" Padding="16,12"
                    BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Margin="0,16,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource PrimaryGreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SelectedPeriodType, StringFormat='نوع التقرير: {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <TextBlock Text="{Binding FilterFrom, StringFormat='من: {0:yyyy-MM-dd}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0" />
                        <TextBlock Text="{Binding FilterTo, StringFormat='إلى: {0:yyyy-MM-dd}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
