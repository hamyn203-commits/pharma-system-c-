<UserControl x:Class="AlNeda.Admin.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AlNeda.Admin.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20,10,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" Background="#E60D1117" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="#FF55D66B" Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل التقرير..." Foreground="#FF8B949E"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Report Categories -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="التقارير" FontSize="18" FontWeight="Bold" Foreground="#FF55D66B" Margin="0,0,0,16" />

                    <!-- Sales Reports -->
                    <TextBlock Text="تقارير المبيعات" Style="{StaticResource SectionHeader}" FontSize="12" Margin="0,0,0,8" />
                    <Button Content="📅 المبيعات اليومية" Command="{Binding RunReportCommand}" CommandParameter="daily_sales" 
                            Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,4" HorizontalAlignment="Stretch" />
                    <Button Content="📆 المبيعات الشهرية" Command="{Binding RunReportCommand}" CommandParameter="monthly_sales" 
                            Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,4" HorizontalAlignment="Stretch" />

                    <!-- Product Reports -->
                    <TextBlock Text="تقارير المنتجات" Style="{StaticResource SectionHeader}" FontSize="12" Margin="0,12,0,8" />
                    <Button Content="🏆 المنتجات الأكثر مبيعاً" Command="{Binding RunReportCommand}" CommandParameter="top_products" 
                            Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,4" HorizontalAlignment="Stretch" />
                    <Button Content="⚠️ المنتجات منتهية الصلاحية" Command="{Binding RunReportCommand}" CommandParameter="expiry" 
                            Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,4" HorizontalAlignment="Stretch" />
                    <Button Content="📦 تقرير المخزون" Command="{Binding RunReportCommand}" CommandParameter="stock" 
                            Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,4" HorizontalAlignment="Stretch" />

                    <!-- Financial Reports -->
                    <TextBlock Text="التقارير المالية" Style="{StaticResource SectionHeader}" FontSize="12" Margin="0,12,0,8" />
                    <Button Content="🏥 الصيدليات المدينة" Command="{Binding RunReportCommand}" CommandParameter="debts" 
                            Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,4" HorizontalAlignment="Stretch" />
                    <Button Content="💊 أفضل الصيدليات" Command="{Binding RunReportCommand}" CommandParameter="top_pharmacies" 
                            Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,4" HorizontalAlignment="Stretch" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Report Content -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="🔄" Command="{Binding ToggleViewModeCommand}"
                            ToolTip="تبديل العرض (جدول/نص)"
                            Background="#2D333B" Foreground="#E6EDF3" BorderBrush="#444C56"
                            Padding="10,8" BorderThickness="1" />
                    <Button Content="📄 CSV" Command="{Binding ExportToCsvCommand}"
                            Background="#2D333B" Foreground="#E6EDF3" BorderBrush="#444C56"
                            Padding="12,8" Margin="8,0,0,0" BorderThickness="1"
                            ToolTip="تصدير إلى CSV" />
                    <Button Content="📊 Excel" Command="{Binding ExportToExcelCommand}"
                            Background="#2D333B" Foreground="#E6EDF3" BorderBrush="#444C56"
                            Padding="12,8" Margin="4,0,0,0" BorderThickness="1"
                            ToolTip="تصدير إلى Excel" />
                    <Button Content="📕 PDF" Command="{Binding ExportToPdfCommand}"
                            Background="#2D333B" Foreground="#E6EDF3" BorderBrush="#444C56"
                            Padding="12,8" Margin="4,0,0,0" BorderThickness="1"
                            ToolTip="تصدير إلى PDF" />
                    <Button Content="🖨️ طباعة" Command="{Binding PrintCommand}"
                            Background="#238636" Foreground="White" BorderThickness="0"
                            Padding="12,8" Margin="4,0,0,0"
                            ToolTip="طباعة التقرير" />
                </StackPanel>

                <!-- Content -->
                <Grid Grid.Row="1">
                    <!-- Grid View -->
                    <DataGrid ItemsSource="{Binding ReportData}"
                              Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Style="{StaticResource ModernDataGrid}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF21262D"
                              AutoGenerateColumns="True" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" />

                    <!-- Text View -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <TextBlock Text="{Binding ReportContent}" 
                                   FontFamily="Consolas" FontSize="13" 
                                   Foreground="#FFADBAC7" 
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <!-- Placeholder when no report selected -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding CurrentReportName, Converter={StaticResource StringEmptyToVisibilityConverter}, FallbackValue=Visible}">
                        <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Opacity="0.5" />
                        <TextBlock Text="اختر تقريراً من القائمة الجانبية" 
                                   FontSize="14" Foreground="#FF8B949E" 
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="#FF21262D" CornerRadius="4" Padding="8,4" Margin="0,12,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#FF8B949E" FontSize="11" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
