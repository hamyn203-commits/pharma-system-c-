<UserControl x:Class="AlNeda.Admin.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Stats -->
            <RowDefinition Height="Auto" /> <!-- Actions -->
            <RowDefinition Height="*" />    <!-- Grid -->
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="{StaticResource DarkOverlayBgBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="{StaticResource SuccessBrush}" Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل المرتجعات..." Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Stats Section -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="مرتجعات اليوم" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{Binding TodayReturns}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="6,0,6,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="إجمالي مبالغ المرتجعات" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{Binding TotalReturnsAmount, StringFormat={}{0:N0}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="طلبات معلقة" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{Binding PendingReturns}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Header -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="إدارة المرتجعات" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />

            <Button Grid.Column="1" Content="+ إنشاء مرتجع جديد" Command="{Binding NewReturnCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Height="44" Padding="24,0" />
        </Grid>

        <!-- Data Grid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Returns}" SelectedItem="{Binding SelectedReturn}"
                      Style="{StaticResource ModernDataGrid}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderMutedBrush}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم المرتجع" Binding="{Binding ReturnNumber}" Width="120" />
                    <DataGridTextColumn Header="الصيدلية" Binding="{Binding Pharmacy.Name}" Width="*" />
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="120" />
                    <DataGridTextColumn Header="النوع" Binding="{Binding ReturnType}" Width="100" />
                    <DataGridTemplateColumn Header="الحالة" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Margin="10,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="approved">
                                                    <Setter Property="Background" Value="{StaticResource SuccessGlassBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="pending">
                                                    <Setter Property="Background" Value="{StaticResource WarningGlassBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="rejected">
                                                    <Setter Property="Background" Value="{StaticResource DangerGlassBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="approved">
                                                        <Setter Property="Text" Value="موافق عليه" />
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="pending">
                                                        <Setter Property="Text" Value="قيد الانتظار" />
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="rejected">
                                                        <Setter Property="Text" Value="مرفوض" />
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Editor Overlay -->
        <Border Grid.RowSpan="3" Background="{StaticResource DarkOverlayBgBrush}"
                Visibility="{Binding ShowEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <Border Style="{StaticResource CardStyle}" Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة مرتجع جديد" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,20" />

                    <Border Background="{StaticResource DangerGlassBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" />
                    </Border>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="الصيدلية" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Pharmacies}" SelectedItem="{Binding SelectedPharmacy}"
                                  DisplayMemberPath="Name" Height="44" Style="{StaticResource ModernComboBox}" />
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="المنتجات" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Button Content="+ إضافة منتج" Command="{Binding AddItemCommand}" HorizontalAlignment="Right" 
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" FontSize="12" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding NewItems}" Height="150" Margin="0,8,0,0" AutoGenerateColumns="False"
                                  Style="{StaticResource ModernDataGrid}" CellStyle="{StaticResource ModernDataGridCell}"
                                  RowStyle="{StaticResource ModernDataGridRow}" ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="المنتج" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Id" DisplayMemberPath="Name"
                                                      Style="{StaticResource ModernComboBox}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#xE74D;" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="المبلغ" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding TotalAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="44" IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <StackPanel Width="230" Margin="0,0,12,0">
                            <TextBlock Text="نوع المرتجع" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding ReturnTypes}" SelectedItem="{Binding ReturnType}"
                                      Height="44" Style="{StaticResource ModernComboBox}" />
                        </StackPanel>
                        <StackPanel Width="230">
                            <TextBlock Text="سبب المرتجع" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Reason}" Style="{StaticResource ModernTextBox}" Height="44" />
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <CheckBox Content="تعديل المخزون" IsChecked="{Binding AdjustStock}" Margin="0,0,20,0" Foreground="White" />
                        <CheckBox Content="تعديل حساب الصيدلية" IsChecked="{Binding AdjustBalance}" Foreground="White" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="حفظ" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="48" />
                        <Button Grid.Column="2" Content="إلغاء" Command="{Binding CancelEditCommand}"
                                Style="{StaticResource DangerButtonStyle}" Height="48" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>