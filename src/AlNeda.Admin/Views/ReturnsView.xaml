<UserControl x:Class="AlNeda.Admin.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="#E60D1117" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="#FF55D66B" Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل المرتجعات..." Foreground="#FF8B949E"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="المرتجعات" FontSize="22" FontWeight="Bold" Foreground="#FF55D66B" VerticalAlignment="Center" />

            <Button Grid.Column="1" Content="+ مرتجع جديد" Command="{Binding NewReturnCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="20,0" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Returns}" SelectedItem="{Binding SelectedReturn}"
                      Style="{StaticResource ModernDataGrid}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF21262D"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم المرتجع" Binding="{Binding ReturnNumber}" Width="120" />
                    <DataGridTextColumn Header="الصيدلية" Binding="{Binding Pharmacy.Name}" Width="*" />
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="90" />
                    <DataGridTextColumn Header="النوع" Binding="{Binding ReturnType}" Width="80" />
                    <DataGridTemplateColumn Header="الحالة" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="approved">
                                                    <Setter Property="Background" Value="#FF238636" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="pending">
                                                    <Setter Property="Background" Value="#FFD29922" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="rejected">
                                                    <Setter Property="Background" Value="#FFDA3633" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.RowSpan="2" Background="#E60D1117"
                Visibility="{Binding ShowEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <Border Style="{StaticResource CardStyle}" Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="مرتجع جديد" FontSize="20" FontWeight="Bold" Foreground="#FF55D66B" Margin="0,0,0,20" />

                    <Border Background="#FF3D1A1A" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFFF5C5C" FontSize="12" />
                    </Border>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="الصيدلية" FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Pharmacies}" SelectedItem="{Binding SelectedPharmacy}"
                                  DisplayMemberPath="Name" Height="44" Style="{StaticResource ModernComboBox}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="المبلغ" FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,6" />
                        <TextBox Text="{Binding TotalAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="44" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="نوع المرتجع" FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding ReturnTypes}" SelectedItem="{Binding ReturnType}"
                                  Height="44" Style="{StaticResource ModernComboBox}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="السبب" FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Reason}" Style="{StaticResource ModernTextBox}" Height="44" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="حفظ" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="48" />
                        <Button Grid.Column="2" Content="إلغاء" Command="{Binding CancelEditCommand}"
                                Style="{StaticResource DangerButtonStyle}" Height="48" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>