<UserControl x:Class="AlNeda.Admin.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Toolbar -->
                <RowDefinition Height="*" />    <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- HEADER                                                      -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="إدارة التصنيفات" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="تنظيم المنتجات حسب المجموعات الدوائية" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <Border HorizontalAlignment="Left" Background="{StaticResource CardBgBrush}" CornerRadius="16" Padding="20,12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="إجمالي النشط" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalActive}" Foreground="{StaticResource PrimaryGreenBrush}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="إجمالي المنتجات" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalProducts}" Foreground="{StaticResource PrimaryBlueLightBrush}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="الأكثر مبيعاً" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TopCategory}" Foreground="{StaticResource WarningBrush}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- TOOLBAR & FILTERS                                           -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" CornerRadius="16" Padding="20,16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Search -->
                        <Grid Width="350" Margin="0,0,16,0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" Height="40" VerticalContentAlignment="Center" Padding="35,0,12,0" />
                            <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0" Opacity="0.5" IsHitTestVisible="False"/>
                            <TextBlock Text="بحث سريع بالاسم أو الوصف..." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="38,0" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Inverse}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="➕ تصنيف جديد" Command="{Binding AddNewCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="20,0" Height="40" FontWeight="Bold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- DATAGRID                                                    -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              Style="{StaticResource ModernDataGrid}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                            
                            <DataGridTemplateColumn Header="التصنيف" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                            <Border Width="36" Height="36" Background="{DynamicResource PrimaryGreenGlassBrush}" CornerRadius="10" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Icon, FallbackValue=📦}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description, FallbackValue='لا يوجد وصف'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" MaxWidth="350" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الحالة" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="12,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WarningGlassBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryGreenGlassBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="معطل"/>
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="نشط"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="المنتجات" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PrimaryBlueGlassBrush}" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ProductCount}" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueLightBrush}"/>
                                                <TextBlock Text=" منتجات" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الإجراءات" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="✏️" Command="{Binding DataContext.EditSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource WindowButtonStyle}" ToolTip="تعديل"/>
                                            <Button Content="🗑️" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource CloseButtonStyle}" Margin="8,0,0,0" ToolTip="حذف"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading Overlay -->
                    <Border Background="{StaticResource OverlayBgBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource PrimaryGreenBrush}" Style="{StaticResource ModernProgressBar}"/>
                            <TextBlock Text="جاري التحديث..." Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- INLINE EDITOR / OVERLAY DIALOG                              -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Background="{StaticResource OverlayBgBrush}" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource PageBgBrush}" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="16" Padding="32">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" Opacity="0.5" ShadowDepth="10"/>
                </Border.Effect>
                
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,24">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Button Content="✕" Command="{Binding CancelEditCommand}" Style="{StaticResource WindowButtonStyle}" HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- Form -->
                    <StackPanel>
                        <!-- Name -->
                        <TextBlock Text="اسم التصنيف *" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding EditCategory.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="45" Margin="0,0,0,16" />

                        <!-- Description -->
                        <TextBlock Text="الوصف" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding EditCategory.Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12" Margin="0,0,0,16" />

                        <!-- Icon & Order -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الأيقونة" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding EditCategory.Icon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="45" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ترتيب العرض" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding EditCategory.DisplayOrder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="45" />
                            </StackPanel>
                        </Grid>

                        <CheckBox IsChecked="{Binding EditCategory.IsActive}" Content="نشط ومتاح للاستخدام" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,32"/>
                    </StackPanel>

                    <!-- Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="إلغاء" Command="{Binding CancelEditCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="45" />
                        <Button Grid.Column="2" Content="حفظ التصنيف" Command="{Binding SaveCategoryCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="45" FontWeight="Bold" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>