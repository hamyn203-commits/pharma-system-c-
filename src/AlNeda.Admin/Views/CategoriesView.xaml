<UserControl x:Class="AlNeda.Admin.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:conv="clr-namespace:AlNeda.Admin.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Toolbar -->
                <RowDefinition Height="*" />    <!-- DataGrid -->
                <RowDefinition Height="Auto" /> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="إدارة التصنيفات" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="تنظيم المنتجات حسب المجموعات الدوائية" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <Border HorizontalAlignment="Left" Background="{StaticResource CardBgBrush}" CornerRadius="16" Padding="20,12" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="إجمالي النشط" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalActive}" Foreground="{StaticResource PrimaryGreenBrush}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="إجمالي المنتجات" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalProducts}" Foreground="{StaticResource PrimaryBlueLightBrush}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="الأكثر مبيعاً" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TopCategory}" Foreground="{StaticResource WarningBrush}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TOOLBAR & FILTERS -->
            <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" CornerRadius="16" Padding="20,16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Search -->
                        <Grid Width="280" Margin="0,0,12,0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" Height="40" VerticalContentAlignment="Center" Padding="35,0,12,0" FontSize="12"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0" Opacity="0.5" IsHitTestVisible="False"/>
                            <TextBlock Text="بحث بالاسم أو الوصف..." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="38,0" IsHitTestVisible="False" FontSize="11"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </Grid>

                        <!-- Filter by count -->
                        <ComboBox ItemsSource="{Binding CountFilters}" SelectedItem="{Binding FilterCount}"
                                  Style="{StaticResource ModernComboBox}" MinWidth="100" Height="40" FontSize="12" Margin="0,0,12,0" />

                        <!-- Sort by -->
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}"
                                  Style="{StaticResource ModernComboBox}" MinWidth="90" Height="40" FontSize="12" Margin="0,0,12,0" />

                        <!-- Refresh -->
                        <Button Content="&#xE72D; تحديث" Command="{Binding RefreshCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="40" FontSize="12" Padding="16,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource TransparentButtonStyle}" Height="40" Padding="12,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" />
                                <TextBlock Text="Excel" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddNewCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="20,0" Height="40" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" />
                                <TextBlock Text="تصنيف جديد" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DATAGRID -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              Style="{StaticResource ModernDataGrid}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                            
                            <DataGridTemplateColumn Header="التصنيف" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0">
                                            <Border Width="36" Height="36" Background="{DynamicResource PrimaryGreenGlassBrush}" CornerRadius="10" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Icon, FallbackValue=📦}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Description, FallbackValue='لا يوجد وصف'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" MaxWidth="350" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الحالة" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="12,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WarningGlassBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryGreenGlassBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="معطل"/>
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="نشط"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="المنتجات" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PrimaryBlueGlassBrush}" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ProductCount}" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueLightBrush}"/>
                                                <TextBlock Text=" منتجات" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الإجراءات" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Command="{Binding DataContext.EditSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource WindowButtonStyle}" ToolTip="تعديل">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource CloseButtonStyle}" Margin="8,0,0,0" ToolTip="حذف">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Categories.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="لا توجد تصنيفات" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="أضف تصنيفاً جديداً من زر التصنيف الجديد" FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Loading Overlay -->
                    <Border Background="{StaticResource OverlayBgBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource PrimaryGreenBrush}" Style="{StaticResource ModernProgressBar}"/>
                            <TextBlock Text="{Binding StatusMessage, FallbackValue='جاري التحديث...'}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="{StaticResource CardBgBrush}" CornerRadius="14" Padding="16,12"
                    BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1" Margin="0,16,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource PrimaryGreenBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Categories.Count, StringFormat='{}{0} تصنيف معروض'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
