<UserControl x:Class="AlNeda.Admin.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{StaticResource DarkOverlayBgBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="{StaticResource SuccessBrush}" Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل السجل..." Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="سجل العمليات" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="المستخدم:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                <TextBox Text="{Binding SearchUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Width="150" Height="40" Margin="0,0,16,0" />
                
                <TextBlock Text="من:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="40" Margin="0,0,16,0" />
                
                <TextBlock Text="إلى:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0" />
                <DatePicker SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="40" Margin="0,0,16,0" />
                
                <Button Content="بحث" Command="{Binding LoadCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="40" Padding="16,0" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Logs}"
                      Style="{StaticResource ModernDataGrid}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderMutedBrush}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" />
                    <DataGridTextColumn Header="المستخدم" Binding="{Binding Username}" Width="100" />
                    <DataGridTextColumn Header="العملية" Binding="{Binding Action}" Width="100" />
                    <DataGridTextColumn Header="الكيان" Binding="{Binding Entity}" Width="80" />
                    <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="*" />
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>