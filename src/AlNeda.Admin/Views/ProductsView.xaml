<UserControl x:Class="AlNeda.Admin.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AlNeda.Admin.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:BalanceColorConverter x:Key="BalanceColorConverter" />
        <conv:PositiveIntegerRule x:Key="PositiveIntegerRule" />
        <conv:PositiveDecimalRule x:Key="PositiveDecimalRule" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style x:Key="ProductActionBtn" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6,0,6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Background="{StaticResource OverlayBgBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="{StaticResource PrimaryIndigoBrush}" Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل المنتجات..." Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>


        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="إجمالي المنتجات" Foreground="{StaticResource TextMutedBrush}" FontSize="12" /><TextBlock Text="{Binding TotalProducts}" Foreground="{StaticResource PrimaryIndigoDarkBrush}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18" Margin="5,0"><StackPanel><TextBlock Text="المنتجات النشطة" Foreground="{StaticResource TextMutedBrush}" FontSize="12" /><TextBlock Text="{Binding ActiveProducts}" Foreground="{StaticResource PrimaryCyanDarkBrush}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18" Margin="5,0"><StackPanel><TextBlock Text="مخزون منخفض" Foreground="{StaticResource TextMutedBrush}" FontSize="12" /><TextBlock Text="{Binding LowStockProducts}" Foreground="{StaticResource WarningBrush}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="قيمة المخزون" Foreground="{StaticResource TextMutedBrush}" FontSize="12" /><TextBlock Text="{Binding InventoryValue, StringFormat={}{0:N0}}" Foreground="{StaticResource DangerBrush}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" /></StackPanel></Border>
        </Grid>
        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="40" MinWidth="220">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Height="40"
                         VerticalContentAlignment="Center" />
            </Grid>

            <WrapPanel Grid.Row="1" FlowDirection="RightToLeft" Margin="0,10,0,0">
                <Button Content="بحث" Command="{Binding SearchCommand}" Height="38"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="20,0" />

                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMutedBrush}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding BarcodeSearch, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Width="190" Height="38"
                             VerticalContentAlignment="Center"
                             x:Name="BarcodeTextBox" />
                </StackPanel>

                <Button Content="+ إضافة منتج جديد" Command="{Binding NewProductCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="20,0" Margin="0,0,8,0" />
            </WrapPanel>
        </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                      Style="{StaticResource ModernDataGrid}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderMutedBrush}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeight="48"
                      HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      MinHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="48" MinWidth="44">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}">
                                <Setter Property="Width" Value="48" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="120" MinWidth="100" />
                    <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="105" MinWidth="90" />
                    <DataGridTextColumn Header="الشركة" Binding="{Binding Company}" Width="120" MinWidth="95" />
                    <DataGridTemplateColumn Header="الكمية" Width="78" MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PrimaryCyanGlassBrush}"
                                        CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Quantity}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="86" MinWidth="76" />
                    <DataGridTextColumn Header="صلاحية" Binding="{Binding ExpiryDate}" Width="96" MinWidth="84" />
                    <DataGridTemplateColumn Header="الإجراءات" Width="86" MinWidth="82">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="RightToLeft">
                                    <Button Content="&#xE70F;"
                                            Command="{Binding DataContext.EditSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ProductActionBtn}"
                                            ToolTip="تعديل" />
                                    <Button Content="&#xE74D;"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ProductActionBtn}"
                                            Foreground="{StaticResource DangerBrush}"
                                            ToolTip="حذف" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Editor Overlay -->
        <Border Grid.RowSpan="3" Background="{StaticResource OverlayBgBrush}"
                Visibility="{Binding ShowEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <Border Style="{StaticResource CardStyle}" MinWidth="360" MaxWidth="620" Padding="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="Black" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource PrimaryCyanGlassBrush}" CornerRadius="16,16,0,0" Padding="24,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="20" VerticalAlignment="Center">
                                <Run Text="إضافة / تعديل منتج" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20">
                            <!-- Validation Message -->
                            <Border Background="{StaticResource DangerGlassBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                                    Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA; " FontFamily="Segoe MDL2 Assets" />
                                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Product Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                <TextBlock Text="اسم المنتج *" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding EditProduct.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Height="46" />
                            </StackPanel>

                            <!-- Barcode -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="الباركود" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding EditProduct.Barcode}" Style="{StaticResource ModernTextBox}" Height="46" />
                            </StackPanel>

                            <!-- Company -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="الشركة" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding EditProduct.Company}" Style="{StaticResource ModernTextBox}" Height="46" />
                            </StackPanel>

                            <!-- Price -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="السعر *" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Style="{StaticResource ModernTextBox}" Height="46">
                                    <TextBox.Text>
                                        <Binding Path="EditProduct.UnitPrice" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                                            <Binding.ValidationRules>
                                                <conv:PositiveDecimalRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>

                            <!-- Quantity -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="الكمية *" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Style="{StaticResource ModernTextBox}" Height="46">
                                    <TextBox.Text>
                                        <Binding Path="EditProduct.Quantity" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                                            <Binding.ValidationRules>
                                                <conv:PositiveIntegerRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>

                            <!-- Category -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                <TextBlock Text="التصنيف" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedValue="{Binding EditProduct.CategoryId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource ModernComboBox}"
                                          ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                          Height="46" />
                            </StackPanel>

                            <!-- Expiry Date -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                <TextBlock Text="تاريخ الصلاحية" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding EditProduct.ExpiryDate}" Style="{StaticResource ModernTextBox}" Height="46" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Footer / Buttons -->
                    <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" CornerRadius="0,0,16,16" Padding="24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="حفظ التغييرات" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Height="48" />
                            <Button Grid.Column="2" Content="إلغاء ✖" Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Height="48" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
