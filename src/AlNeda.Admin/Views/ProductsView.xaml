<UserControl x:Class="AlNeda.Admin.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AlNeda.Admin.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:BalanceColorConverter x:Key="BalanceColorConverter" />
        <conv:PositiveIntegerRule x:Key="PositiveIntegerRule" />
        <conv:PositiveDecimalRule x:Key="PositiveDecimalRule" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="2" Background="#E60D1117" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="#FF55D66B" Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل المنتجات..." Foreground="#FF8B949E"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Width="280" Height="40"
                         VerticalContentAlignment="Center" />
                <Button Content="🔍 بحث" Command="{Binding SearchCommand}" Height="40"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" Padding="20,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                <TextBlock Text="📷" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding BarcodeSearch, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}" Width="160" Height="40"
                         VerticalContentAlignment="Center"
                         x:Name="BarcodeTextBox" />
            </StackPanel>

            <Button Grid.Column="2" Content="+ إضافة منتج جديد" Command="{Binding NewProductCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="20,0" />
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                      Style="{StaticResource ModernDataGrid}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF21262D">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}">
                                <Setter Property="Width" Value="50" />
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130" />
                    <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="110" />
                    <DataGridTextColumn Header="الشركة" Binding="{Binding Company}" Width="130" />
                    <DataGridTemplateColumn Header="الكمية" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#FF21262D"
                                        CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Quantity}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="90" />
                    <DataGridTextColumn Header="صلاحية" Binding="{Binding ExpiryDate}" Width="90" />
                    <DataGridTemplateColumn Header="الإجراءات" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✏️" FontSize="12" Padding="8,4"
                                            Command="{Binding DataContext.EditSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Background="#FF21262D" Foreground="#FF8B949E" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="B" Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#FF316DCA" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Content="🗑️" FontSize="12" Padding="8,4" Margin="4,0,0,0"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#FF21262D" Foreground="#FF8B949E" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="B" Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#FFFF5C5C" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Editor Overlay -->
        <Border Grid.RowSpan="2" Background="#E60D1117"
                Visibility="{Binding ShowEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <Border Style="{StaticResource CardStyle}" Width="560" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="Black" Opacity="0.5" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#FF1C2128" CornerRadius="16,16,0,0" Padding="24,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="20" VerticalAlignment="Center">
                                <Run Text="📦" /><Run Text=" " /><Run Text="إضافة / تعديل منتج" FontWeight="Bold" Foreground="#FF55D66B" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20">
                            <!-- Validation Message -->
                            <Border Background="#FF3D1A1A" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                                    Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️ " />
                                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFFF5C5C" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Product Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                <TextBlock Text="اسم المنتج *" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding EditProduct.Name, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Height="46" />
                            </StackPanel>

                            <!-- Barcode -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="الباركود" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding EditProduct.Barcode}" Style="{StaticResource ModernTextBox}" Height="46" />
                            </StackPanel>

                            <!-- Company -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="الشركة" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding EditProduct.Company}" Style="{StaticResource ModernTextBox}" Height="46" />
                            </StackPanel>

                            <!-- Price -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                                <TextBlock Text="السعر *" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Style="{StaticResource ModernTextBox}" Height="46">
                                    <TextBox.Text>
                                        <Binding Path="EditProduct.UnitPrice" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                                            <Binding.ValidationRules>
                                                <conv:PositiveDecimalRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>

                            <!-- Quantity -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                                <TextBlock Text="الكمية *" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Style="{StaticResource ModernTextBox}" Height="46">
                                    <TextBox.Text>
                                        <Binding Path="EditProduct.Quantity" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                                            <Binding.ValidationRules>
                                                <conv:PositiveIntegerRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>

                            <!-- Category -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                                <TextBlock Text="التصنيف" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedValue="{Binding EditProduct.CategoryId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource ModernComboBox}"
                                          ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                          Height="46" />
                            </StackPanel>

                            <!-- Expiry Date -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                                <TextBlock Text="تاريخ الصلاحية" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding EditProduct.ExpiryDate}" Style="{StaticResource ModernTextBox}" Height="46" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Footer / Buttons -->
                    <Border Grid.Row="2" Background="#FF161B22" CornerRadius="0,0,16,16" Padding="24,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="حفظ التغييرات ✅" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Height="48" />
                            <Button Grid.Column="2" Content="إلغاء ✖" Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Height="48" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
