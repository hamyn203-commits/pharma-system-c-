<UserControl x:Class="AlNeda.Admin.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Stats -->
            <RowDefinition Height="Auto" /> <!-- Actions -->
            <RowDefinition Height="*" />    <!-- Grid -->
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="#E60D1117" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="#FF55D66B" Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل التحصيلات..." Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Stats Section -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="تحصيلات اليوم" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="12,500" FontSize="28" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="💵" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="6,0,6,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="تحصيلات الشهر" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="285,400" FontSize="28" FontWeight="Bold" Foreground="#FF55D66B" />
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="إجمالي النقدية" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="1,240,000" FontSize="28" FontWeight="Bold" Foreground="#FFD29922" />
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Header -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="سجل التحصيلات" FontSize="22" FontWeight="Bold" Foreground="#FF55D66B" VerticalAlignment="Center" />

            <Button Grid.Column="1" Content="+ تحصيل مبلغ جديد" Command="{Binding NewPaymentCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Height="44" Padding="24,0" />
        </Grid>

        <!-- Data Grid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}"
                      Style="{StaticResource ModernDataGrid}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderMutedBrush}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصيدلية" Binding="{Binding PharmacyName}" Width="*" />
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="120" />
                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentType}" Width="120" />
                    <DataGridTextColumn Header="الحالة" Binding="{Binding PaymentStatus}" Width="120" />
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Editor Overlay -->
        <Border Grid.RowSpan="3" Background="#E60D1117"
                Visibility="{Binding ShowEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <Border Style="{StaticResource CardStyle}" Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="تحصيل مبلغ جديد" FontSize="20" FontWeight="Bold" Foreground="#FF55D66B" Margin="0,0,0,20" />

                    <Border Background="#FF3D1A1A" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFFF5C5C" FontSize="12" />
                    </Border>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="الصيدلية" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Pharmacies}" SelectedValue="{Binding SelectedPharmacyId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Name" Height="44" Style="{StaticResource ModernComboBox}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="المبلغ" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="44" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="طريقة التحصيل" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding PaymentType}"
                                  Height="44" Style="{StaticResource ModernComboBox}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="ملاحظات إضافية" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding PaymentNotes}" Style="{StaticResource ModernTextBox}" Height="44" />
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="حفظ العملية" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="48" />
                        <Button Grid.Column="2" Content="إلغاء" Command="{Binding CancelEditCommand}"
                                Style="{StaticResource DangerButtonStyle}" Height="48" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
