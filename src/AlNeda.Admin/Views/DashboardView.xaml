<UserControl x:Class="AlNeda.Admin.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:AlNeda.Admin.Behaviors"
             xmlns:controls="clr-namespace:AlNeda.Admin.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1200">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="DashboardHeroPremiumBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF102238" Offset="0" />
            <GradientStop Color="#FF123B35" Offset="0.55" />
            <GradientStop Color="#FF0F172A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DashboardCardPremiumBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1E293B" Offset="0" />
            <GradientStop Color="#FF172033" Offset="1" />
        </LinearGradientBrush>

        <!-- Premium flat cards: elevation comes from color, borders, and subtle transform only. -->
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DashboardCardPremiumBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
            <Setter Property="MinHeight" Value="164" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <TranslateTransform Y="0" />
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBgBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                </Trigger>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.006" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.006" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-2" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardCardShellStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MetricIconTextStyle" TargetType="TextBlock" BasedOn="{StaticResource IconTextBlockStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashboardListItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="AnalyticsTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource PageBgBrush}">
        <Grid Margin="6,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Cards -->
                <RowDefinition Height="Auto" /> <!-- Charts -->
                <RowDefinition Height="Auto" /> <!-- Rankings -->
                <RowDefinition Height="*" />    <!-- Tables/Alerts -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- HEADER                                                      -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{StaticResource DashboardHeroPremiumBrush}"
                    BorderBrush="{StaticResource AccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="30"
                    Margin="0,0,0,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#FF020617" Opacity="0.34" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <Border Background="{StaticResource PrimaryCyanGlassBrush}"
                                BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,7"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryCyanLightBrush}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="مركز عمليات المخزن" Foreground="{StaticResource PrimaryCyanLightBrush}" FontSize="12" FontWeight="Bold" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="لوحة تحكم تشغيلية جديدة"
                                   FontSize="34"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="مبيعات، مخزون، طلبات وتنبيهات في عرض واحد قابل للمتابعة اليومية"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Background="#241E293B"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="18,14"
                            VerticalAlignment="Top"
                            MinWidth="260">
                        <StackPanel>
                            <TextBlock Text="آخر نسخة احتياطية" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding LastBackup}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Black" Margin="0,7,0,0"/>
                            <Border Background="{StaticResource PrimaryIndigoGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryIndigoBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="النظام جاهز للطلبات" Foreground="{StaticResource PrimaryIndigoLightBrush}" FontSize="12" FontWeight="Bold" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="4" Margin="0,28,0,0">
                        <Border Background="#2422D3EE" BorderBrush="#4422D3EE" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="مبيعات اليوم" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                <TextBlock Text="{Binding Stats.DailySales, StringFormat={}{0:N0} ج.م}" Foreground="{StaticResource PrimaryCyanLightBrush}" FontSize="22" FontWeight="Black" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#2434D399" BorderBrush="#4434D399" BorderThickness="1" CornerRadius="16" Padding="16" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="طلبات نشطة" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                <TextBlock Text="{Binding Stats.ActiveOrders}" Foreground="{StaticResource PrimaryIndigoLightBrush}" FontSize="22" FontWeight="Black" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#24FBBF24" BorderBrush="#44FBBF24" BorderThickness="1" CornerRadius="16" Padding="16" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="تنبيهات المخزون" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                <TextBlock Text="{Binding AlertSummary, FallbackValue=لا توجد تنبيهات}" Foreground="{StaticResource WarningLightBrush}" FontSize="15" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="#24818CF8" BorderBrush="#44818CF8" BorderThickness="1" CornerRadius="16" Padding="16" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="تاريخ اليوم" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                <TextBlock Text="{Binding CurrentDate}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- CARDS SECTION (Skeleton or Real)                            -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <!-- Skeleton View -->
                <UniformGrid Columns="3" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <controls:SkeletonCard Margin="0,0,16,16" />
                    <controls:SkeletonCard Margin="8,0,8,16" />
                    <controls:SkeletonCard Margin="16,0,0,16" />
                    <controls:SkeletonCard Margin="0,0,16,0" />
                    <controls:SkeletonCard Margin="8,0,8,0" />
                    <controls:SkeletonCard Margin="16,0,0,0" />
                </UniformGrid>

                <!-- Data Cards -->
                <UniformGrid Columns="3" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    
                    <!-- 1. Total Receivables -->
                    <Button Command="{Binding NavToReceivablesCommand}" Style="{StaticResource TransparentButtonStyle}">
                        <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,16,16" Background="{StaticResource ReceivablesGradient}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{StaticResource DangerGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock Text="EGP" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource DangerBrush}"/>
                                    </Border>
                                    <TextBlock Text="إجمالي المستحقات" Style="{StaticResource MetricLabel}" Grid.Column="1" />
                                </Grid>
                                <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right">
                                    <i:Interaction.Behaviors>
                                        <behaviors:AnimatedNumberBehavior TargetNumber="{Binding Stats.TotalReceivables}" />
                                    </i:Interaction.Behaviors>
                                </TextBlock>
                                <TextBlock Text="جنيه مصري" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- 2. Active Orders -->
                    <Button Command="{Binding NavToActiveOrdersCommand}" Style="{StaticResource TransparentButtonStyle}">
                        <Border Style="{StaticResource DashboardCardStyle}" Margin="8,0,8,16" Background="{StaticResource OrdersGradient}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{StaticResource WarningGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock Text="#" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource WarningBrush}"/>
                                    </Border>
                                    <TextBlock Text="الطلبات النشطة" Style="{StaticResource MetricLabel}" Grid.Column="1" />
                                </Grid>
                                <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right">
                                    <i:Interaction.Behaviors>
                                        <behaviors:AnimatedNumberBehavior TargetNumber="{Binding Stats.ActiveOrders}" />
                                    </i:Interaction.Behaviors>
                                </TextBlock>
                                <TextBlock Text="قيد التنفيذ" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- 3. Pharmacies -->
                    <Button Command="{Binding NavToPharmaciesCommand}" Style="{StaticResource TransparentButtonStyle}">
                        <Border Style="{StaticResource DashboardCardStyle}" Margin="16,0,0,16" Background="{StaticResource PharmaciesGradient}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{StaticResource PrimaryIndigoGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock Text="+" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                                    </Border>
                                    <TextBlock Text="الصيدليات المسجلة" Style="{StaticResource MetricLabel}" Grid.Column="1" />
                                </Grid>
                                <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" HorizontalAlignment="Right">
                                    <i:Interaction.Behaviors>
                                        <behaviors:AnimatedNumberBehavior TargetNumber="{Binding Stats.TotalPharmacies}" />
                                    </i:Interaction.Behaviors>
                                </TextBlock>
                                <TextBlock Text="صيدلية مسجلة" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- 4. Products -->
                    <Button Command="{Binding NavToProductsCommand}" Style="{StaticResource TransparentButtonStyle}">
                        <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,16,0" Background="{StaticResource ProductsGradient}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentPurpleLightBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock Text="Rx" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource AccentPurpleBrush}"/>
                                    </Border>
                                    <TextBlock Text="إجمالي المنتجات" Style="{StaticResource MetricLabel}" Grid.Column="1" />
                                </Grid>
                                <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" HorizontalAlignment="Right">
                                    <i:Interaction.Behaviors>
                                        <behaviors:AnimatedNumberBehavior TargetNumber="{Binding Stats.TotalProducts}" />
                                    </i:Interaction.Behaviors>
                                </TextBlock>
                                <TextBlock Text="صنف دوائي" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- 5. Daily Sales -->
                    <Button Command="{Binding NavToDailySalesCommand}" Style="{StaticResource TransparentButtonStyle}">
                        <Border Style="{StaticResource DashboardCardStyle}" Margin="8,0,8,0" Background="{StaticResource DailySalesGradient}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{StaticResource PrimaryCyanGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock Text="24" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource PrimaryCyanBrush}"/>
                                    </Border>
                                    <TextBlock Text="مبيعات اليوم" Style="{StaticResource MetricLabel}" Grid.Column="1" />
                                </Grid>
                                <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryCyanBrush}" HorizontalAlignment="Right">
                                    <i:Interaction.Behaviors>
                                        <behaviors:AnimatedNumberBehavior TargetNumber="{Binding Stats.DailySales}" />
                                    </i:Interaction.Behaviors>
                                </TextBlock>
                                <TextBlock Text="جنيه مصري" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- 6. Monthly Sales -->
                    <Button Command="{Binding NavToMonthlySalesCommand}" Style="{StaticResource TransparentButtonStyle}">
                        <Border Style="{StaticResource DashboardCardStyle}" Margin="16,0,0,0" Background="{StaticResource MonthlySalesGradient}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{StaticResource PrimaryIndigoGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock Text="30" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                                    </Border>
                                    <TextBlock Text="مبيعات الشهر" Style="{StaticResource MetricLabel}" Grid.Column="1" />
                                </Grid>
                                <TextBlock FontSize="36" FontWeight="Bold" Foreground="{StaticResource PrimaryIndigoBrush}" HorizontalAlignment="Right">
                                    <i:Interaction.Behaviors>
                                        <behaviors:AnimatedNumberBehavior TargetNumber="{Binding Stats.MonthlySales}" />
                                    </i:Interaction.Behaviors>
                                </TextBlock>
                                <TextBlock Text="مبيعات الشهر" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </UniformGrid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- CHARTS SECTION                                              -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Border Style="{StaticResource CardStyle}" MinHeight="520" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="تحليل احترافي لحركة المبيعات" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Analytics.SalesMovement.TrendLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource SuccessGlassBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SalesGrowthPrefix}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SalesGrowthText}" Foreground="{StaticResource SuccessBrush}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,18">
                                    <Border Style="{StaticResource AnalyticsTileStyle}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="مبيعات 30 يوم" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding Analytics.SalesMovement.CurrentPeriodSales, StringFormat={}{0:N0} ج.م}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource AnalyticsTileStyle}" BorderBrush="{StaticResource PrimaryIndigoGlassBrush}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="عدد الطلبات" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding Analytics.SalesMovement.OrdersCount}" Foreground="{StaticResource SuccessBrush}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource AnalyticsTileStyle}" BorderBrush="{StaticResource PrimaryCyanGlassBrush}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="متوسط الطلب" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding Analytics.SalesMovement.AverageOrderValue, StringFormat={}{0:N0} ج.م}" Foreground="{StaticResource PrimaryCyanBrush}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource AnalyticsTileStyle}" BorderBrush="{StaticResource WarningGlassBrush}">
                                        <StackPanel>
                                            <TextBlock Text="أقوى يوم" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding Analytics.SalesMovement.BestSalesDay}" Foreground="{StaticResource WarningBrush}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Grid.Row="1" Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <lvc:CartesianChart Series="{Binding SalesSeries}" 
                                                        XAxes="{Binding XAxes}" 
                                                        YAxes="{Binding YAxes}"
                                                        FlowDirection="LeftToRight"
                                                        LegendPosition="Hidden"
                                                        TooltipPosition="Top" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="2">
                                <Border Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="أكثر منتج مبيعًا" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                            <TextBlock Text="Rx" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource PrimaryCyanBrush}" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Analytics.TopProduct.ProductName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Analytics.TopProduct.Category}" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,16" />
                                        <UniformGrid Columns="2">
                                            <StackPanel>
                                                <TextBlock Text="الكمية" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Analytics.TopProduct.QuantitySold}" Foreground="{StaticResource SuccessBrush}" FontSize="20" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="القيمة" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Analytics.TopProduct.Revenue, StringFormat={}{0:N0} ج.م}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource PrimaryCyanGlassBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="أكثر صيدلية اشترت" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                            <TextBlock Text="+" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource PrimaryIndigoBrush}" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Analytics.TopPharmacy.PharmacyName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Analytics.TopPharmacy.Phone}" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,16" />
                                        <UniformGrid Columns="2">
                                            <StackPanel>
                                                <TextBlock Text="إجمالي الشراء" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Analytics.TopPharmacy.TotalPurchases, StringFormat={}{0:N0} ج.م}" Foreground="{StaticResource PrimaryIndigoBrush}" FontSize="20" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="عدد الطلبات" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Analytics.TopPharmacy.OrdersCount}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardElevatedBrush}" BorderBrush="{StaticResource PrimaryIndigoGlassBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="نشاط العملاء" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                            <TextBlock Text="ON" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <UniformGrid Columns="2">
                                            <StackPanel>
                                                <TextBlock Text="صيدليات نشطة" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Analytics.SalesMovement.ActiveBuyingPharmacies}" Foreground="{StaticResource SuccessBrush}" FontSize="20" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="متوسط الصيدلية" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Analytics.SalesMovement.SalesPerActivePharmacy, StringFormat={}{0:N0} ج.م}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- RANKINGS SECTION                                            -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="أفضل 5 منتجات في البيع" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="حسب الكمية ثم إجمالي قيمة البيع خلال آخر 30 يوم" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Rx" Style="{StaticResource MetricIconTextStyle}" FontSize="18" HorizontalAlignment="Left" Foreground="{StaticResource SuccessBrush}"/>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Analytics.TopProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DashboardListItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Border Background="{StaticResource SuccessGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding QuantitySold, StringFormat={}{0:N0} وحدة}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="12"/>
                                                </Border>
                                                <Border Background="{StaticResource HoverBgBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                                    <TextBlock Text="{Binding Revenue, StringFormat={}{0:N0} ج.م}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="أفضل 5 صيدليات شراءً" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="ترتيب العملاء الأعلى قيمة خلال آخر 30 يوم" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                            <TextBlock Text="+" Style="{StaticResource MetricIconTextStyle}" FontSize="18" HorizontalAlignment="Left" Foreground="{StaticResource PrimaryIndigoBrush}"/>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Analytics.TopPharmacies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DashboardListItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding PharmacyName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Phone}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Border Background="{StaticResource PrimaryIndigoGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding TotalPurchases, StringFormat={}{0:N0} ج.م}" Foreground="{StaticResource PrimaryIndigoBrush}" FontWeight="Bold" FontSize="12"/>
                                                </Border>
                                                <Border Background="{StaticResource HoverBgBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                                    <TextBlock Text="{Binding OrdersCount, StringFormat={}{0} طلب}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ALERTS / RECENT ACTIVITIES                                  -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Stock Alerts -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="تنبيهات المخزون" Style="{StaticResource SectionHeader}" Margin="0,0,0,16" />
                        
                        <StackPanel Grid.Row="1">
                            <Button Command="{Binding ShowLowStockProductsCommand}" Style="{StaticResource TransparentButtonStyle}" Margin="0,0,0,8">
                                <Border Background="{DynamicResource WarningGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="!" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0"/>
                                            <TextBlock Text="منتجات مخزونها منخفض" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LowStockCount}" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>
                            
                            <Button Command="{Binding ShowExpiringProductsCommand}" Style="{StaticResource TransparentButtonStyle}" Margin="0,0,0,8">
                                <Border Background="{DynamicResource DangerGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="EXP" Style="{StaticResource MetricIconTextStyle}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,12,0"/>
                                            <TextBlock Text="منتجات تنتهي صلاحيتها قريباً" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExpiringCount}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>

                            <Button Command="{Binding ShowExpiredProductsCommand}" Style="{StaticResource TransparentButtonStyle}">
                                <Border Background="{DynamicResource DangerGlassBrush}" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DangerLightBrush}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="منتجات منتهية الصلاحية" Foreground="{StaticResource DangerLightBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExpiredCount}" Foreground="{StaticResource DangerLightBrush}" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Inactive Pharmacies -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="صيدليات تحتاج متابعة" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="لم تشتر منذ 30 يوم أو أكثر مع آخر صنف تم طلبه" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                            <TextBlock Text="!" Style="{StaticResource MetricIconTextStyle}" FontSize="18" HorizontalAlignment="Left" Foreground="{StaticResource WarningBrush}"/>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Analytics.InactivePharmacies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DashboardListItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding PharmacyName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                    <TextBlock Text="آخر صنف: " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                                    <TextBlock Text="{Binding LastProductName}" Foreground="{StaticResource PrimaryCyanBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastOrderValue, StringFormat=آخر طلب: {0:N0} ج.م}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="{StaticResource DangerGlassBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding InactivityLabel}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="بدون شراء" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
