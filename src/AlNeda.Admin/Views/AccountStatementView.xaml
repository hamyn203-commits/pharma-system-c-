<UserControl x:Class="AlNeda.Admin.Views.AccountStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AlNeda.Admin.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter" />
        <conv:BalanceColorConverter x:Key="BalanceColorConverter" />
        <conv:BalanceBgConverter x:Key="BalanceBgConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="4" Background="#E60D1117" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="#FF55D66B" Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل الكشف..." Foreground="#FF8B949E"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="كشف حساب الصيدلية" 
                   FontSize="24" FontWeight="Bold" Foreground="#FFFFFFFF" 
                   Margin="0,0,0,16" />

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" 
                      ItemsSource="{Binding Pharmacies}" 
                      SelectedItem="{Binding SelectedPharmacy}"
                      DisplayMemberPath="Name" 
                      Width="350" Height="44" 
                      Style="{StaticResource ModernComboBox}" />

            <Button Grid.Column="1" 
                    Content="📋 عرض الكشف" 
                    Command="{Binding ShowStatementCommand}" 
                    Height="44"
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Margin="12,0,0,0" 
                    Padding="24,0" />

            <!-- Action Buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="🖨️ طباعة" 
                        Command="{Binding PrintStatementCommand}"
                        IsEnabled="{Binding HasStatement}"
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Height="44" 
                        Padding="16,0"
                        ToolTip="طباعة كشف الحساب" />
                <Button Content="📄 تصدير HTML" 
                        Command="{Binding ExportStatementHtmlCommand}"
                        IsEnabled="{Binding HasStatement}"
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Height="44" 
                        Margin="8,0,0,0"
                        Padding="16,0"
                        ToolTip="تصدير كشف الحساب كملف HTML" />

                <!-- Balance Summary (if pharmacy selected) -->
                <Border Grid.Column="3" 
                        Background="{Binding SelectedPharmacy.Balance, Converter={StaticResource BalanceBgConverter}}" 
                        CornerRadius="12" Padding="16,8"
                        Margin="12,0,0,0"
                        Visibility="{Binding SelectedPharmacy, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الرصيد: " FontSize="14" Foreground="#FF8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedPharmacy.Balance, StringFormat={}{0:N2}}" 
                                   FontSize="16" FontWeight="Bold" 
                                   Foreground="{Binding SelectedPharmacy.Balance, Converter={StaticResource BalanceColorConverter}}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Statement Content -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding LedgerText}" 
                               FontFamily="Consolas" FontSize="12" 
                               Foreground="#FFADBAC7" 
                               TextWrapping="Wrap" />
                </ScrollViewer>

                <!-- Placeholder -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding LedgerText, Converter={StaticResource StringEmptyToVisibilityConverter}, FallbackValue=Visible}">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Opacity="0.5" />
                    <TextBlock Text="اختر صيدلية واضغط 'عرض الكشف'" 
                               FontSize="14" Foreground="#FF8B949E" 
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#FF21262D" CornerRadius="4" Padding="8,4" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FF8B949E" FontSize="11" />
        </Border>
    </Grid>
</UserControl>
