<Window x:Class="AlNeda.Admin.Views.OffersDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AlNeda.Admin.Views"
        xmlns:conv="clr-namespace:AlNeda.Admin.Converters"
        Title="مركز العروض والتسويق"
        Width="1300" Height="780"
        MinWidth="1050" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

            <!-- KPI Card Gradients -->
            <LinearGradientBrush x:Key="KpiGreenGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#CC0F2D20" Offset="0" />
                <GradientStop Color="#990D3320" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="KpiBlueGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#CC0E253B" Offset="0" />
                <GradientStop Color="#990D2B3A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="KpiAmberGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#CC332A18" Offset="0" />
                <GradientStop Color="#992F3218" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="KpiPurpleGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#CC20213B" Offset="0" />
                <GradientStop Color="#99202538" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="KpiTealGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#CC0D3530" Offset="0" />
                <GradientStop Color="#990D3028" Offset="1" />
            </LinearGradientBrush>

            <!-- KPI Card Style -->
            <Style x:Key="KpiCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-4" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>

            <!-- Icon Circle Style -->
            <Style x:Key="KpiIconCircle" TargetType="Border">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="CornerRadius" Value="19" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Skeleton Shimmer Animation -->
            <Style x:Key="SkeletonBlock" TargetType="Border">
                <Setter Property="Background" Value="#1A334155" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="20" Background="{StaticResource PageBgBrush}"
            BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#FF020617" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══════ ROW 0: TITLE BAR + KPI CARDS ═══════ -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Padding="16,12" MouseLeftButtonDown="TitleBarDrag" Cursor="Hand"
                        Background="{StaticResource HeaderBgBrush}" CornerRadius="20,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="RightToLeft">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PrimaryIndigoGlassBrush}">
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{StaticResource PrimaryIndigoBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="مركز العروض والتسويق" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="صمم، استهدف، تابع، حلل" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}"
                                    Width="36" Height="34" FontSize="10" ToolTip="تصغير" Click="Minimize_Click" />
                            <Button x:Name="MaxBtn" Content="&#xE922;" Style="{StaticResource WindowButtonStyle}"
                                    Width="36" Height="34" FontSize="10" ToolTip="تكبير" Margin="2,0" Click="Maximize_Click" />
                            <Button Content="&#xE8BB;" Style="{StaticResource CloseButtonStyle}"
                                    Width="36" Height="34" FontSize="10" ToolTip="إغلاق" Margin="4,0,0,0" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI Cards -->
                <Border Grid.Row="1" Padding="14,0,14,12" Background="{StaticResource HeaderBgBrush}">
                    <UniformGrid Columns="5">
                        <!-- Card 1: Active -->
                        <Border Style="{StaticResource KpiCard}" Background="{StaticResource KpiGreenGradient}" Margin="0,0,7,0">
                            <Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="{StaticResource PrimaryIndigo}" Opacity="0.18" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <Border Style="{StaticResource KpiIconCircle}" Background="#2634D399" BorderBrush="#4434D399">
                                    <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{StaticResource PrimaryGreenBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="نشطة" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding ActiveOffers, FallbackValue=0}" FontSize="22" FontWeight="Black"
                                               Foreground="{StaticResource PrimaryIndigoBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Pharmacies -->
                        <Border Style="{StaticResource KpiCard}" Background="{StaticResource KpiBlueGradient}" Margin="3,0,7,0">
                            <Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="{StaticResource PrimaryCyan}" Opacity="0.18" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <Border Style="{StaticResource KpiIconCircle}" Background="#2638BDF8" BorderBrush="#4438BDF8">
                                    <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{StaticResource PrimaryCyanBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="صيدلية" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding UniqueViewedPharmacies, FallbackValue=0}" FontSize="22" FontWeight="Black"
                                               Foreground="{StaticResource PrimaryCyanBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Orders -->
                        <Border Style="{StaticResource KpiCard}" Background="{StaticResource KpiAmberGradient}" Margin="3,0,7,0">
                            <Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#FFF59E0B" Opacity="0.18" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <Border Style="{StaticResource KpiIconCircle}" Background="#26FBBF24" BorderBrush="#44FBBF24">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{StaticResource WarningBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="طلبات" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding OrdersFromOffers, FallbackValue=0}" FontSize="22" FontWeight="Black"
                                               Foreground="{StaticResource WarningBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Conversion -->
                        <Border Style="{StaticResource KpiCard}" Background="{StaticResource KpiPurpleGradient}" Margin="3,0,7,0">
                            <Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#FF8B5CF6" Opacity="0.18" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <Border Style="{StaticResource KpiIconCircle}" Background="#268B5CF6" BorderBrush="#448B5CF6">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{StaticResource AccentPurpleBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="تحويل" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding ConversionRateText, FallbackValue='0%'}" FontSize="22" FontWeight="Black"
                                               Foreground="{StaticResource AccentPurpleBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Published -->
                        <Border Style="{StaticResource KpiCard}" Background="{StaticResource KpiTealGradient}" Margin="3,0,0,0">
                            <Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="{StaticResource PrimaryGreen}" Opacity="0.22" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <Border Style="{StaticResource KpiIconCircle}" Background="#2634D399" BorderBrush="#4434D399">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{StaticResource PrimaryGreenBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="منشورة" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding PublishedOffers, FallbackValue=0}" FontSize="22" FontWeight="Black"
                                               Foreground="{StaticResource PrimaryGreenBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- ═══════ ROW 1: MAIN CONTENT ═══════ -->
            <Grid Grid.Row="1">
                <Border Margin="12,0,12,0" ClipToBounds="True">
                    <views:OffersView x:Name="OffersContent" />
                </Border>

                <!-- Skeleton Loading Overlay -->
                <Border Background="{StaticResource OverlayBgBrush}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                        Panel.ZIndex="100">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="240" Height="4"
                                     Foreground="{StaticResource PrimaryCyanBrush}"
                                     Style="{StaticResource ModernProgressBar}" />
                        <TextBlock Text="جاري تحميل بيانات مركز العروض..." Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="14" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
