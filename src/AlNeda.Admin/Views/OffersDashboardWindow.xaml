<Window x:Class="AlNeda.Admin.Views.OffersDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مركز العروض والتسويق"
        Width="1500" Height="860"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource PageBgBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ModulePanel" TargetType="Border">
            <Setter Property="Background" Value="#CC0D1728" />
            <Setter Property="BorderBrush" Value="#2638BDF8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="180" />
        </Style>

        <Style x:Key="SideNavItem" TargetType="RadioButton">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Grid.Column="0" Background="Transparent" CornerRadius="4" Margin="0,9" />
                                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#141E293B" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2638BDF8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2231D0AA" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6631D0AA" />
                                <Setter TargetName="Accent" Property="Background" Value="{StaticResource SuccessBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource HeaderBgBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="18,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="مركز العروض والتسويق" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="إدارة العروض ومراجعة ظهورها على تطبيق الصيدلي ومتابعة الأداء"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Content="إنشاء عرض جديد" Command="{Binding CreateNewOfferCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Padding="24,0" Margin="0,0,10,0" />
                    <Button Content="تحديث" Command="{Binding RefreshCurrentCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="40" Padding="20,0" Margin="0,0,10,0" />
                    <Button Content="—" Width="38" Height="38" Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" Margin="0,0,6,0" />
                    <Button Content="□" Width="38" Height="38" Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" Margin="0,0,6,0" />
                    <Button Content="×" Width="38" Height="38" Style="{StaticResource CloseButtonStyle}" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBgBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="12"
                    Margin="0,0,14,0">
                <DockPanel>
                    <Button DockPanel.Dock="Top"
                            Command="{Binding ToggleSidebarCommand}"
                            Height="42"
                            Margin="0,0,0,14"
                            Background="#1822363E"
                            BorderBrush="#3347556B"
                            BorderThickness="1"
                            Cursor="Hand">
                        <TextBlock Text="☰" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" HorizontalAlignment="Center" />
                    </Button>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="القوائم"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="8,0,8,10"
                                       Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsDashboardVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="dashboard" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="لوحة العروض" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsAllOffersVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="all" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="كل العروض" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsPublishedVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="published" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="العروض المنشورة" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsReviewVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="review" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="قيد المراجعة" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsDraftsVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="drafts" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="المسودات" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="التحرير"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="8,12,8,10"
                                       Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsEditorVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="editor" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="محرر العرض" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsProductsVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="products" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="المنتجات داخل العرض" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsTargetingVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="targeting" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="الاستهداف" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsPreviewVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="preview" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="معاينة تطبيق الصيدلي" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="المتابعة"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="8,12,8,10"
                                       Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsAnalyticsVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="analytics" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="التحليلات" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsEngagementVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="engagement" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="تفاعل الصيدليات" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="OffersNav" IsChecked="{Binding IsImageSettingsVisible, Mode=OneWay}" Command="{Binding ShowSectionCommand}" CommandParameter="images" Style="{StaticResource SideNavItem}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                                    <TextBlock Text="إعدادات الصور" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ModulePanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding PageTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="25" FontWeight="Bold" />
                        <TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,5,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}" DataContext="{Binding Dashboard}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0">
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="عروض نشطة" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding ActiveOffers}" Foreground="{StaticResource SuccessBrush}" FontSize="30" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="منشورة" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding PublishedOffers}" Foreground="{StaticResource PrimaryCyanBrush}" FontSize="30" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="مشاهدات يومية" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding UniqueDailyImpressions}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="30" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="ضغطات" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding Clicks}" Foreground="{StaticResource WarningBrush}" FontSize="30" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetricCard}">
                                    <StackPanel>
                                        <TextBlock Text="تحويل" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding ConversionRateText}" Foreground="{StaticResource SuccessBrush}" FontSize="30" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,12,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="عروض تحتاج إجراء" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                                        <DataGrid ItemsSource="{Binding Offers}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None" Background="Transparent">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="العرض" Binding="{Binding Title}" Width="2*" />
                                                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*" />
                                                <DataGridTextColumn Header="مشاهدات" Binding="{Binding UniqueDailyImpressions}" Width="*" />
                                                <DataGridTextColumn Header="طلبات" Binding="{Binding Orders}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="أفضل عرض أداء" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" />
                                            <TextBlock Text="يظهر هنا العرض صاحب أعلى تحويل بعد توفر بيانات كافية." Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="آخر نشاط من الصيدليات" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" />
                                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <ScrollViewer Visibility="{Binding IsAllOffersVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding Editor}">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" Height="42" Text="بحث باسم العرض" Foreground="{StaticResource TextMutedBrush}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Height="42" Margin="10,0" SelectedIndex="0">
                                        <ComboBoxItem Content="كل الحالات" />
                                        <ComboBoxItem Content="منشور" />
                                        <ComboBoxItem Content="مسودة" />
                                        <ComboBoxItem Content="متوقف" />
                                    </ComboBox>
                                    <DatePicker Grid.Column="2" Height="42" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Offers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Views}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource SuccessBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="تعديل" Command="{Binding DataContext.SelectOfferCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="16,0" />
                                                        <Button Content="معاينة" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="16,0" Margin="8,0,0,0" />
                                                        <Button Content="نسخ" Style="{StaticResource SecondaryButtonStyle}" Height="36" Padding="16,0" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Visibility="{Binding IsPublishedVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding Editor}">
                                <TextBlock Text="العروض المنشورة مرتبة حسب الأداء" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding Offers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                                        <TextBlock Text="مشاهدات الصيدليات، الطلبات، والمبيعات الناتجة تظهر هنا مع بيانات التحليلات." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="إيقاف العرض" Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Padding="20,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Visibility="{Binding IsReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="قيد المراجعة" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="هنا تظهر العروض التي تحتاج موافقة قبل النشر، مع سبب التحذير وأزرار الموافقة أو الرفض أو إرسال تجربة لصيدلية واحدة." Foreground="{StaticResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,18" />
                                    <Button Content="إرسال تجربة لصيدلية واحدة" Style="{StaticResource PrimaryButtonStyle}" Height="42" Padding="24,0" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ScrollViewer Visibility="{Binding IsDraftsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding Editor}">
                                <TextBlock Text="المسودات" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding Offers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                                        <TextBlock Text="اكتمال العرض: الصورة، المنتجات، الاستهداف، ومواعيد النشر." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="متابعة التحرير" Command="{Binding DataContext.SelectOfferCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" Height="38" Padding="20,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Visibility="{Binding IsEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding Editor}" MaxWidth="980" HorizontalAlignment="Stretch">
                                <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="بيانات العرض" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="عنوان العرض" Style="{StaticResource FormLabel}" />
                                                <TextBox Text="{Binding OfferTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="السطر المختصر" Style="{StaticResource FormLabel}" />
                                                <TextBox Text="{Binding OfferSubtitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="نوع العرض" Style="{StaticResource FormLabel}" />
                                                <ComboBox ItemsSource="{Binding OfferTypes}" SelectedItem="{Binding OfferType}" Style="{StaticResource ModernComboBox}" Height="44" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0">
                                                <TextBlock Text="الحالة" Style="{StaticResource FormLabel}" />
                                                <TextBox Text="{Binding PublishStateText}" Style="{StaticResource ModernTextBox}" Height="44" IsReadOnly="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8,0">
                                                <TextBlock Text="تاريخ البداية" Style="{StaticResource FormLabel}" />
                                                <DatePicker SelectedDate="{Binding StartsAt}" Height="44" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                                <TextBlock Text="تاريخ النهاية" Style="{StaticResource FormLabel}" />
                                                <DatePicker SelectedDate="{Binding EndsAt}" Height="44" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="الصورة والوصف" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#FF07111F" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Height="210" ClipToBounds="True" Margin="0,0,16,0">
                                                <Image Source="{Binding PreviewImagePath}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <Button Content="رفع صورة" Command="{Binding ChooseImageCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="42" Padding="22,0" HorizontalAlignment="Right" />
                                                <TextBlock Text="وصف العرض" Style="{StaticResource FormLabel}" Margin="0,16,0,7" />
                                                <TextBox Text="{Binding OfferDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="92" VerticalContentAlignment="Top" />
                                                <TextBlock Text="شروط العرض وملاحظات داخلية يمكن إضافتها هنا في التطوير التالي." Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#101827" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="14">
                                    <WrapPanel>
                                        <Button Content="حفظ كمسودة" Command="{Binding SaveDraftCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="42" Padding="24,0" Margin="0,0,10,0" />
                                        <Button Content="إرسال للمراجعة" Style="{StaticResource SecondaryButtonStyle}" Height="42" Padding="24,0" Margin="0,0,10,0" />
                                        <Button Content="نشر" Command="{Binding PublishCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="42" Padding="30,0" Margin="0,0,10,0" />
                                        <Button Content="إيقاف" Command="{Binding PauseCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="42" Padding="24,0" Margin="0,0,10,0" />
                                        <Button Content="حذف" Style="{StaticResource CloseButtonStyle}" Height="42" Padding="24,0" />
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Visibility="{Binding IsProductsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBox}" Height="44">
                                        <ComboBoxItem Content="اختيار منتج من المخزون" />
                                    </ComboBox>
                                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Height="44" Margin="10,0" Text="الكمية" />
                                    <Button Grid.Column="2" Content="إضافة منتج" Style="{StaticResource PrimaryButtonStyle}" Height="44" Padding="24,0" />
                                </Grid>
                                <DataGrid AutoGenerateColumns="False" MinHeight="430" Background="{StaticResource CardBgBrush}" GridLinesVisibility="None">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="المنتج" Width="2*" />
                                        <DataGridTextColumn Header="الكمية المتاحة" Width="*" />
                                        <DataGridTextColumn Header="السعر قبل" Width="*" />
                                        <DataGridTextColumn Header="السعر بعد" Width="*" />
                                        <DataGridTextColumn Header="نسبة الخصم" Width="*" />
                                        <DataGridTextColumn Header="الحد الأدنى" Width="*" />
                                        <DataGridTextColumn Header="هدية" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="تحذيرات توفر المنتج والكمية القليلة ستظهر هنا عند ربط OfferProduct بالمخزون." Foreground="{StaticResource WarningBrush}" FontSize="13" Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Visibility="{Binding IsTargetingVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                            <Grid DataContext="{Binding Editor}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="360" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,14,0">
                                    <StackPanel>
                                        <TextBlock Text="خيارات الاستهداف" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" />
                                        <ComboBox ItemsSource="{Binding AudienceSegments}" SelectedItem="{Binding AudienceSegment}" Style="{StaticResource ModernComboBox}" Height="44" Margin="0,16,0,0" />
                                        <TextBlock Text="قريباً: محافظة معينة، لم تطلب منذ 30 يوم، VIP، مديونية." Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" />
                                        <Button Content="إرسال تجربة لصيدلية واحدة" Style="{StaticResource SecondaryButtonStyle}" Height="42" Margin="0,18,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="16">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="قائمة الصيدليات المختارة" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                                        <ListBox ItemsSource="{Binding TargetPharmacies}" Background="#FF07111F" BorderBrush="#3347556B">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected}" Foreground="{StaticResource TextPrimaryBrush}" Margin="8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Phone}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <Grid Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" DataContext="{Binding Editor}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="460" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Text="أوضاع المعاينة" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" />
                                <ComboBox ItemsSource="{Binding PreviewModes}" SelectedItem="{Binding PreviewMode}" Style="{StaticResource ModernComboBox}" Height="44" Width="360" HorizontalAlignment="Right" Margin="0,14,0,18" />
                                <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="هذه الصفحة للمعاينة فقط. لا توجد حقول تحرير كثيرة هنا حتى تبقى المراجعة هادئة وواضحة." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" />
                                        <Button Content="تغيير الصورة" Command="{Binding ChooseImageCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="42" Padding="24,0" HorizontalAlignment="Right" Margin="0,18,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FF050A13" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="30" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="تطبيق الصيدلي" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                    <Border Background="#FF07111F" CornerRadius="22" Padding="14">
                                        <StackPanel>
                                            <Border Background="#141E293B" CornerRadius="18" Padding="12" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="أهلاً يا صيدلية النور" Foreground="White" FontSize="14" FontWeight="Bold" />
                                                    <TextBlock Text="عروض مختارة لمخزونك" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="22" ClipToBounds="True" Background="#FF0F172A">
                                                <Grid MinHeight="380">
                                                    <Image Source="{Binding PreviewImagePath}" Stretch="UniformToFill" Opacity="0.96" />
                                                    <Border Background="#66020A13" />
                                                    <StackPanel Margin="18" VerticalAlignment="Bottom">
                                                        <Border Background="#F031D0AA" CornerRadius="16" Padding="10,5" HorizontalAlignment="Right" Margin="0,0,0,10">
                                                            <TextBlock Text="{Binding PreviewDiscountLabel}" Foreground="#FF022C22" FontSize="17" FontWeight="Black" />
                                                        </Border>
                                                        <TextBlock Text="{Binding OfferTitle}" Foreground="White" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding OfferSubtitle}" Foreground="#FFE0F2FE" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" FlowDirection="RightToLeft">
                                                            <TextBlock Text="{Binding PreviewPriceLabel}" Foreground="#FFA7F3D0" FontSize="20" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding PreviewOldPriceLabel}" Foreground="#FFCBD5E1" FontSize="12" TextDecorations="Strikethrough" Margin="10,6,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Button Content="أضف للطلب" Style="{StaticResource PrimaryButtonStyle}" Height="42" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding IsAnalyticsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" DataContext="{Binding Dashboard}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0">
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="المشاهدات" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Text="{Binding UniqueDailyImpressions}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="الضغطات" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Text="{Binding Clicks}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="الطلبات" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Text="{Binding OrdersFromOffers}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="معدل التحويل" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Text="{Binding ConversionRateText}" Foreground="{StaticResource SuccessBrush}" FontSize="28" FontWeight="Bold" /></StackPanel></Border>
                            </WrapPanel>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,12,0"><TextBlock Text="Chart لحركة التفاعل سيظهر هنا عند إضافة سلسلة زمنية للأحداث." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" /></Border>
                                <Border Grid.Column="1" Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="18"><TextBlock Text="Chart للمبيعات الناتجة من العروض سيظهر هنا عند ربط قيم الطلبات." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" /></Border>
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding IsEngagementVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid AutoGenerateColumns="False" Background="{StaticResource CardBgBrush}" GridLinesVisibility="None">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="اسم الصيدلية" Width="2*" />
                                    <DataGridTextColumn Header="رقم الهاتف" Width="*" />
                                    <DataGridTextColumn Header="اسم العرض" Width="2*" />
                                    <DataGridTextColumn Header="وقت المشاهدة" Width="*" />
                                    <DataGridCheckBoxColumn Header="ضغطت؟" Width="*" />
                                    <DataGridCheckBoxColumn Header="أضافت للسلة؟" Width="*" />
                                    <DataGridCheckBoxColumn Header="طلبت؟" Width="*" />
                                    <DataGridTextColumn Header="قيمة الطلب" Width="*" />
                                    <DataGridTextColumn Header="آخر تفاعل" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <ScrollViewer Visibility="{Binding IsImageSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto">
                            <Grid DataContext="{Binding Editor}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="360" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="المقاسات المطلوبة" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" />
                                            <TextBlock Text="Banner: 1920x700" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,14,0,0" />
                                            <TextBlock Text="Card: 1080x1350" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,8,0,0" />
                                            <TextBlock Text="Thumbnail: 600x600" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#141E293B" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="16" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="إرشادات الجرافيك" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" />
                                            <TextBlock Text="اترك مساحة آمنة للنصوص، لا تضع تفاصيل سعر صغيرة جداً، وتأكد أن الصورة واضحة على شاشة موبايل." Foreground="{StaticResource TextMutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" />
                                            <Button Content="تحميل صورة جديدة" Command="{Binding ChooseImageCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="42" Padding="24,0" HorizontalAlignment="Right" Margin="0,18,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#FF07111F" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
                                    <Image Source="{Binding PreviewImagePath}" Stretch="Uniform" />
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
