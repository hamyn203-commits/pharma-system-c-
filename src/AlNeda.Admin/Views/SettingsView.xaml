<UserControl x:Class="AlNeda.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Tab Icon Mapping -->
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                Padding="28,14"
                                Margin="0,0,4,0"
                                CornerRadius="14,14,0,0"
                                Cursor="Hand"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TabIcon" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TabLabel" Text="{TemplateBinding Header}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF161B22" />
                                <Setter TargetName="TabLabel" Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="TabLabel" Property="Foreground" Value="#FFD1D5DB" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabLabel" Property="Foreground" Value="#FF8B949E" />
                            </MultiTrigger>
                            <Trigger Property="Tag" Value="general">
                                <Setter TargetName="TabIcon" Property="Text" Value="⚙️" />
                            </Trigger>
                            <Trigger Property="Tag" Value="database">
                                <Setter TargetName="TabIcon" Property="Text" Value="💾" />
                            </Trigger>
                            <Trigger Property="Tag" Value="users">
                                <Setter TargetName="TabIcon" Property="Text" Value="👥" />
                            </Trigger>
                            <Trigger Property="Tag" Value="notifications">
                                <Setter TargetName="TabIcon" Property="Text" Value="🔔" />
                            </Trigger>
                            <Trigger Property="Tag" Value="backup">
                                <Setter TargetName="TabIcon" Property="Text" Value="🛡️" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Row Style -->
        <Style x:Key="ToggleRowStyle" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.005" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Gradient Backgrounds for Sections -->
        <LinearGradientBrush x:Key="SectionGeneralGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A10B981" Offset="0" />
            <GradientStop Color="#0A000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SectionDbGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A3B82F6" Offset="0" />
            <GradientStop Color="#0A000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SectionUsersGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A8B5CF6" Offset="0" />
            <GradientStop Color="#0A000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SectionNotifGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1AF59E0B" Offset="0" />
            <GradientStop Color="#0A000000" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SectionBackupGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1AEF4444" Offset="0" />
            <GradientStop Color="#0A000000" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- HEADER                                                      -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,28">
            <StackPanel>
                <TextBlock Text="الإعدادات المتقدمة" Style="{StaticResource PageTitle}" />
                <TextBlock Text="تخصيص تجربة الاستخدام وإدارة إعدادات النظام" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" FontSize="13" />
            </StackPanel>
            <Border HorizontalAlignment="Left" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="16,10" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🟢" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Status, FallbackValue='النظام جاهز'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- TABS                                                        -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                     SelectedIndex="0">
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Margin" Value="0,0,0,0" />
                </Style>
            </TabControl.Resources>

            <!-- ════════════════════════ -->
            <!-- TAB 1: GENERAL           -->
            <!-- ════════════════════════ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Header="عام" Tag="general">
                <ScrollViewer Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="740" HorizontalAlignment="Left">
                        <!-- Appearance -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardGreenGradient}" Margin="0,0,14,0">
                                        <TextBlock Text="🎨" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="المظهر واللغة" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="تخصيص واجهة المستخدم حسب تفضيلاتك" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="لغة التطبيق" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding CurrentSettings.Language}" Style="{StaticResource ModernComboBox}" Height="44" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="الثيم المفضل" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding CurrentSettings.Theme}" Style="{StaticResource ModernComboBox}" Height="44" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="نوع الخط" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                        <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding CurrentSettings.FontFamily}" Style="{StaticResource ModernComboBox}" Height="44" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding CurrentSettings.FontSize, StringFormat='حجم الخط ‏({0}px)'}" Style="{StaticResource CardTitle}" Margin="0,0,0,16" />
                                        <Border Background="#FF0D1117" CornerRadius="12" Padding="14,4" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                            <Slider Minimum="12" Maximum="20" Value="{Binding CurrentSettings.FontSize}" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" Foreground="{StaticResource PrimaryGreenBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- System Behavior -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardBlueGradient}" Margin="0,0,14,0">
                                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="سلوك النظام" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="إعدادات التشغيل والسلوك الافتراضي" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource ToggleRowStyle}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="بدء التشغيل مع Windows" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="سيتم فتح البرنامج تلقائياً عند تشغيل الجهاز" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding CurrentSettings.StartWithWindows}" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ToggleRowStyle}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="التحديثات التلقائية" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="التحقق من وجود إصدارات جديدة عند بدء التشغيل" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding CurrentSettings.CheckUpdatesOnStartup}" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════════════ -->
            <!-- TAB 2: DATABASE          -->
            <!-- ════════════════════════ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Header="قاعدة البيانات" Tag="database">
                <ScrollViewer Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="740" HorizontalAlignment="Left">
                        <!-- Connection -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardBlueGradient}" Margin="0,0,14,0">
                                        <TextBlock Text="🔗" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="اتصال البيانات" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="إعدادات الاتصال ومسار قاعدة البيانات" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="مسار ملف قاعدة البيانات" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CurrentSettings.DbPath}" IsReadOnly="True" Style="{StaticResource ModernTextBox}" Height="44" />
                                    <Button Grid.Column="2" Content="🔍 تغيير المسار" Command="{Binding BrowseDatabaseCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="20,0" Height="44" Foreground="#FFFFFFFF" />
                                </Grid>

                                <TextBlock Text="عنوان اتصال الخادم (API Base URL)" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <TextBox Text="{Binding CurrentSettings.ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,20" />

                                <!-- DB Stats & Actions -->
                                <Border Background="{StaticResource GlassCardBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,4"
                                        BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource StatCardBlueGradient}">
                                                <TextBlock Text="🗄️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                                <TextBlock Text="حجم قاعدة البيانات" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding DbSize, FallbackValue='0 MB'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueLightBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="🔌 اختبار الاتصال" Command="{Binding TestConnectionCommand}"
                                                    Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource PrimaryGreenBrush}" FontWeight="SemiBold" Margin="0,0,20,0" />
                                            <Button Content="🧹 ضغط وتنظيف" Command="{Binding VacuumDbCommand}"
                                                    Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════════════ -->
            <!-- TAB 3: USERS             -->
            <!-- ════════════════════════ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Header="المستخدمين" Tag="users">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header Bar -->
                    <Border Grid.Row="0" Style="{StaticResource SettingsCardStyle}" Padding="20,16" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="إدارة صلاحيات الوصول" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="إضافة وتعديل وإدارة حسابات الموظفين" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Content="➕ مستخدم جديد" Command="{Binding NewUserAsyncCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="24,0" Height="40" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>

                    <!-- Users Table -->
                    <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                  CellStyle="{StaticResource ModernDataGridCell}"
                                  RowStyle="{StaticResource ModernDataGridRow}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="المستخدم" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource StatCardPurpleGradient}" Margin="0,0,12,0">
                                                    <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="الدور" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="12,4" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryBlueGlassBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="admin">
                                                                <Setter Property="Background" Value="{StaticResource PrimaryGreenGlassBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Role}" Value="rep">
                                                                <Setter Property="Background" Value="{StaticResource WarningGlassBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBlueLightBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="admin">
                                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Role}" Value="rep">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy/MM/dd}}" Width="160" />

                                <DataGridTemplateColumn Header="الإجراءات" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" Command="{Binding DataContext.EditSelectedUserAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource WindowButtonStyle}" ToolTip="تعديل" />
                                                <Button Content="🗑️" Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource CloseButtonStyle}" Margin="8,0,0,0" ToolTip="حذف" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════ -->
            <!-- TAB 4: NOTIFICATIONS     -->
            <!-- ════════════════════════ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Header="الإشعارات" Tag="notifications">
                <ScrollViewer Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="740" HorizontalAlignment="Left">
                        <!-- Inventory Alerts -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardAmberGradient}" Margin="0,0,14,0">
                                        <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="تنبيهات المخزون" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="إدارة التنبيهات المتعلقة بالمخزون والأدوية" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Expiry Alert -->
                                <Border Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="تنبيه انتهاء الصلاحية" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                                <TextBlock Text="إظهار تنبيه عند قرب انتهاء صلاحية الأدوية" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                            <CheckBox IsChecked="{Binding CurrentSettings.ExpiryAlertEnabled}" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Background="#FF0D1117" CornerRadius="12" Padding="16" IsEnabled="{Binding CurrentSettings.ExpiryAlertEnabled}" Opacity="0.9">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="تنبيه قبل انتهاء الصلاحية بـ:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                                <Border Background="#FF161B22" CornerRadius="8" Padding="8,0" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                                    <TextBox Text="{Binding CurrentSettings.ExpiryDaysThreshold}" Width="70" Style="{StaticResource ModernTextBox}" Height="36" TextAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="يوم" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Low Stock Alert -->
                                <Border Style="{StaticResource ToggleRowStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="تنبيه نفاد الكمية" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                                <TextBlock Text="إظهار تنبيه عند وصول المخزون للحد الأدنى" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                            <CheckBox IsChecked="{Binding CurrentSettings.LowStockAlertEnabled}" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Background="#FF0D1117" CornerRadius="12" Padding="16" IsEnabled="{Binding CurrentSettings.LowStockAlertEnabled}" Opacity="0.9">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="الحد الأدنى للكمية:" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                                <Border Background="#FF161B22" CornerRadius="8" Padding="8,0" BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1">
                                                    <TextBox Text="{Binding CurrentSettings.LowStockThreshold}" Width="70" Style="{StaticResource ModernTextBox}" Height="36" TextAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="وحدة" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Alert Method -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource StatCardPurpleGradient}" Margin="0,0,14,0">
                                        <TextBlock Text="🔊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="طريقة التنبيه" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="تفضيلات الإشعارات وطريقة العرض" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="طريقة العرض المفضلة" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding AlertMethods}" SelectedItem="{Binding CurrentSettings.AlertMethod}" Style="{StaticResource ModernComboBox}" Height="44" Margin="0,0,0,20" />

                                <Border Style="{StaticResource ToggleRowStyle}" Margin="0">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="تشغيل صوت عند التنبيه" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="إصدار صوت تنبيه مسموع عند وصول إشعار جديد" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding CurrentSettings.PlaySoundOnAlert}" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════════════ -->
            <!-- TAB 5: BACKUP            -->
            <!-- ════════════════════════ -->
            <TabItem Style="{StaticResource SettingsTabItem}" Header="النسخ الاحتياطي" Tag="backup">
                <ScrollViewer Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="740" HorizontalAlignment="Left">
                        <!-- Auto Backup -->
                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Border Width="36" Height="36" CornerRadius="10" Background="#1AEF4444" Margin="0,0,14,0">
                                        <TextBlock Text="🛡️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="الأمان والحفظ" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="إعدادات النسخ الاحتياطي التلقائي واليدوي" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Style="{StaticResource ToggleRowStyle}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="النسخ الاحتياطي التلقائي" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="حفظ نسخة احتياطية من البيانات بشكل دوري" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                        <CheckBox IsChecked="{Binding CurrentSettings.AutoBackupEnabled}" Style="{StaticResource ModernToggleSwitch}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Rectangle Style="{StaticResource SectionDivider}" />

                                <StackPanel IsEnabled="{Binding CurrentSettings.AutoBackupEnabled}" Opacity="{Binding CurrentSettings.AutoBackupEnabled, Converter={StaticResource BoolToOpacityConverter}, FallbackValue=1}">
                                    <TextBlock Text="تكرار النسخ الاحتياطي" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding BackupIntervals}" SelectedItem="{Binding CurrentSettings.BackupInterval}"
                                              Style="{StaticResource ModernComboBox}" Height="44" Margin="0,0,0,20" />

                                    <TextBlock Text="مسار حفظ النسخ الاحتياطية" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding CurrentSettings.BackupPath}" Style="{StaticResource ModernTextBox}" Height="44" />
                                        <Button Grid.Column="2" Content="📁 اختيار مجلد" Style="{StaticResource SecondaryButtonStyle}" Padding="20,0" Height="44" Foreground="#FFFFFFFF" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Manual Backup CTA -->
                        <Border Style="{StaticResource SettingsCardStyle}" Background="#FF1A1F26" BorderBrush="{StaticResource DangerGlassBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Background="{StaticResource DangerGlassBrush}">
                                    <TextBlock Text="⚠️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                                    <TextBlock Text="إنشاء نسخة احتياطية فورية" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Text="احفظ بياناتك الآن بشكل كامل وآمن" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="🛡️ ابدأ النسخ الآن" Command="{Binding CreateBackupCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Padding="28,0" Height="48" FontWeight="Bold" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- BOTTOM ACTION BAR                                          -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" CornerRadius="20" Padding="24,16"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1.5" Margin="0,20,0,0"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource StatCardGreenGradient}" Margin="0,0,12,0">
                        <TextBlock Text="✓" FontSize="14" Foreground="{StaticResource PrimaryGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Status, FallbackValue='النظام جاهز'}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="🔄 إعادة تشغيل" Command="{Binding RestartAppCommand}"
                            Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,20,0" FontSize="13" />
                    <Button Content="↩️ استعادة الافتراضي" Command="{Binding ResetDefaultsCommand}"
                            Style="{StaticResource TransparentButtonStyle}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,24,0" FontSize="13" />
                    <Button Content="💾 حفظ الإعدادات" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" Width="180" Height="44" FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
