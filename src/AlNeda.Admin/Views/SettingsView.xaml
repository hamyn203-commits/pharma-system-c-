<UserControl x:Class="AlNeda.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,10,20">
        <StackPanel MaxWidth="600">
            <TextBlock Text="الإعدادات" FontSize="22" FontWeight="Bold" Foreground="#FF55D66B" Margin="0,0,0,24" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="مسار قاعدة البيانات" FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,6" />
                    <TextBox Text="{Binding DbPath, Mode=OneWay}" IsReadOnly="True" 
                             Style="{StaticResource ModernTextBox}" Height="44" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="مسار ملفات السجل" FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,6" />
                    <TextBox Text="{Binding LogPath, Mode=OneWay}" IsReadOnly="True" 
                             Style="{StaticResource ModernTextBox}" Height="44" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>