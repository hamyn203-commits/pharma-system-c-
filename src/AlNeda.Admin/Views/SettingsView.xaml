<UserControl x:Class="AlNeda.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TabIcon" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" />
                                <TextBlock x:Name="TabLabel" Text="{TemplateBinding Header}" FontSize="13" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PrimaryIndigoGlassBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryIndigoBrush}" />
                                <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter TargetName="TabIcon" Property="Foreground" Value="{StaticResource PrimaryIndigoLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryCyanBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="general"><Setter TargetName="TabIcon" Property="Text" Value="&#xE713;" /></Trigger>
                            <Trigger Property="Tag" Value="account"><Setter TargetName="TabIcon" Property="Text" Value="&#xE77B;" /></Trigger>
                            <Trigger Property="Tag" Value="security"><Setter TargetName="TabIcon" Property="Text" Value="&#xE72E;" /></Trigger>
                            <Trigger Property="Tag" Value="database"><Setter TargetName="TabIcon" Property="Text" Value="&#xE74E;" /></Trigger>
                            <Trigger Property="Tag" Value="users"><Setter TargetName="TabIcon" Property="Text" Value="&#xE716;" /></Trigger>
                            <Trigger Property="Tag" Value="notifications"><Setter TargetName="TabIcon" Property="Text" Value="&#xEA8F;" /></Trigger>
                            <Trigger Property="Tag" Value="backup"><Setter TargetName="TabIcon" Property="Text" Value="&#xE83D;" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsPanel" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DashboardHeroGradient}" CornerRadius="22" Padding="24" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="الإعدادات المتقدمة" FontSize="30" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="تحكم كامل في الحسابات، الأمان، النظام، التنبيهات، النسخ الاحتياطي، والتقارير"
                               Opacity="0.9" Foreground="White" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="فحص النظام" Command="{Binding RunHealthCheckCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Width="130" Height="42"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="عام" Tag="general" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource SettingsPanel}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="هوية النظام" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="بيانات تظهر في التقارير والطباعة والفواتير" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                                <TextBlock Text="اسم المخزن / الشركة" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CurrentSettings.CompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,14" />
                                <TextBlock Text="اسم الفرع" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CurrentSettings.BranchName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,14" />
                                <TextBlock Text="العملة الافتراضية" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding CurrentSettings.DefaultCurrency}" Style="{StaticResource ModernComboBox}" Height="44" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsPanel}" Margin="12,0,0,12">
                            <StackPanel>
                                <TextBlock Text="تجربة الاستخدام" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="تحكم في شكل البرنامج وسلوكه اليومي" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="قائمة جانبية مضغوطة" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="تجعل مساحة العمل أكبر في الشاشات الصغيرة" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.CompactSidebar}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="حركات الداش بورد" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="تفعيل تأثيرات 3D والحركة داخل كروت لوحة التحكم" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.ShowDashboardAnimations}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="الثيم" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding CurrentSettings.Theme}" Style="{StaticResource ModernComboBox}" Height="44" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="الحساب" Tag="account" Style="{StaticResource SettingsTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.9*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsPanel}">
                        <StackPanel>
                            <TextBlock Text="بيانات المستخدم" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="اختر مستخدما من الجدول ثم عدل الاسم أو الدور أو كلمة المرور" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                            <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding SelectedUser.Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,14" />
                            <TextBlock Text="الدور الوظيفي" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedUser.Role}" Style="{StaticResource ModernComboBox}" Height="44" Margin="0,0,0,14" />
                            <TextBlock Text="كلمة مرور جديدة" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding UserPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,14" />
                            <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,18" />
                            <Button Content="حفظ بيانات المستخدم" Command="{Binding SaveSelectedUserCredentialsCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="44" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SettingsPanel}" Padding="12">
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                  CellStyle="{StaticResource ModernDataGridCell}"
                                  RowStyle="{StaticResource ModernDataGridRow}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المستخدم" Binding="{Binding Username}" Width="*" />
                                <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="110" />
                                <DataGridTemplateColumn Header="" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding DataContext.EditSelectedUserAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource WindowButtonStyle}" ToolTip="تعديل">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" />
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource CloseButtonStyle}" Margin="6,0,0,0" ToolTip="حذف">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="الأمان" Tag="security" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource SettingsPanel}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="حماية الجلسة" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="إعدادات تمنع الاستخدام غير المصرح به عند ترك الجهاز" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="قفل تلقائي للجلسة" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="يقفل البرنامج بعد مدة عدم نشاط" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.EnableSessionLock}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="مدة عدم النشاط بالدقائق" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CurrentSettings.SessionTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsPanel}" Margin="12,0,0,12">
                            <StackPanel>
                                <TextBlock Text="سياسات الحماية" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="قواعد تحمي البيانات والعمليات الحساسة" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="كلمات مرور قوية" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="يفرض كلمة مرور أقوى عند تغيير بيانات المستخدم" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.RequireStrongPasswords}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="إخفاء الأرقام المالية الحساسة" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="مفيد عند مشاركة الشاشة أو العمل أمام العملاء" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.MaskSensitiveFinancials}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="تأكيد قبل الحذف" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="يقلل أخطاء حذف المنتجات أو الحسابات بالخطأ" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.ConfirmBeforeDelete}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="قاعدة البيانات" Tag="database" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SettingsPanel}">
                        <StackPanel>
                            <TextBlock Text="الاتصال والبيانات" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="تحكم في مسار قاعدة البيانات والخادم وفحص سلامة الاتصال" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                            <TextBlock Text="مسار قاعدة البيانات" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding CurrentSettings.DbPath}" Style="{StaticResource ModernTextBox}" Height="44" />
                                <Button Grid.Column="2" Content="تغيير" Command="{Binding BrowseDatabaseCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="100" />
                            </Grid>
                            <TextBlock Text="API Base URL" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CurrentSettings.ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,14" />
                            <TextBlock Text="مسار ملفات السجل" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CurrentSettings.LogsPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,18" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="اختبار الاتصال" Command="{Binding TestConnectionCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="140" Margin="0,0,12,0" />
                                <Button Content="ضغط وتنظيف القاعدة" Command="{Binding VacuumDbCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="170" />
                                <TextBlock Text="{Binding DbSize, StringFormat=حجم القاعدة: {0}}" Foreground="{StaticResource PrimaryCyanLightBrush}" FontWeight="Bold" Margin="22,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="المستخدمين" Tag="users" Style="{StaticResource SettingsTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SettingsPanel}" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="إدارة المستخدمين" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="إضافة وتعديل وحذف حسابات الموظفين" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <Button Content="مستخدم جديد" Command="{Binding NewUserAsyncCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="130" HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource SettingsPanel}" Padding="12">
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                                  CellStyle="{StaticResource ModernDataGridCell}"
                                  RowStyle="{StaticResource ModernDataGridRow}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المستخدم" Binding="{Binding Username}" Width="*" />
                                <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="140" />
                                <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy/MM/dd}}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="الإشعارات" Tag="notifications" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource SettingsPanel}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="تنبيهات المخزون" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="تحديد متى ينبهك البرنامج عن الصلاحية والكميات" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="تنبيه انتهاء الصلاحية" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.ExpiryAlertEnabled}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="عدد الأيام قبل انتهاء الصلاحية" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CurrentSettings.ExpiryDaysThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,14" />
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="تنبيه انخفاض الكمية" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.LowStockAlertEnabled}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="الحد الأدنى للكمية" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CurrentSettings.LowStockThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsPanel}" Margin="12,0,0,12">
                            <StackPanel>
                                <TextBlock Text="طريقة التنبيه" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="تحديد شكل الإشعار والصوت والتنبيهات المالية" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                                <TextBlock Text="طريقة العرض" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding AlertMethods}" SelectedItem="{Binding CurrentSettings.AlertMethod}" Style="{StaticResource ModernComboBox}" Height="44" Margin="0,0,0,14" />
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="تشغيل صوت التنبيه" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.PlaySoundOnAlert}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="تنبيه التحصيلات المتأخرة" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.PendingPaymentsAlertEnabled}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="حد التنبيه المالي" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CurrentSettings.PendingPaymentsThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="النسخ والتقارير" Tag="backup" Style="{StaticResource SettingsTabItem}">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource SettingsPanel}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="النسخ الاحتياطي" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="حفظ نسخة آمنة من بياناتك بشكل يدوي أو تلقائي" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="نسخ احتياطي تلقائي" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.AutoBackupEnabled}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="تكرار النسخ" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding BackupIntervals}" SelectedItem="{Binding CurrentSettings.BackupInterval}" Style="{StaticResource ModernComboBox}" Height="44" Margin="0,0,0,14" />
                                <TextBlock Text="عدد النسخ المحتفظ بها" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CurrentSettings.BackupRetentionCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,14" />
                                <TextBlock Text="مسار النسخ الاحتياطي" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CurrentSettings.BackupPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="44" Margin="0,0,0,18" />
                                <Button Content="إنشاء نسخة الآن" Command="{Binding CreateBackupCommand}" Style="{StaticResource DangerButtonStyle}" Height="44" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsPanel}" Margin="12,0,0,12">
                            <StackPanel>
                                <TextBlock Text="التقارير والطباعة" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="إعدادات ترفع جودة التقارير والفواتير" Style="{StaticResource MutedText}" Margin="0,4,0,18" />
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="تصدير التقارير تلقائيا" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.AutoExportReports}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="النطاق الافتراضي للتقارير" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ReportRanges}" SelectedItem="{Binding CurrentSettings.DefaultReportRange}" Style="{StaticResource ModernComboBox}" Height="44" Margin="0,0,0,14" />
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="إظهار بيانات الشركة في الطباعة" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="يضيف اسم المخزن والفرع في رأس الفاتورة والتقارير" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.PrintCompanyHeader}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="سجل تدقيق العمليات" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="تسجيل التعديلات والحذف والعمليات المهمة" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CurrentSettings.EnableAuditTrail}" Style="{StaticResource ModernToggleSwitch}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" CornerRadius="18" Padding="20,14"
                BorderBrush="{StaticResource BorderMutedBrush}" BorderThickness="1.5" Margin="0,18,0,0">
            <Grid>
                <TextBlock Text="{Binding Status, FallbackValue=جاهز}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <WrapPanel HorizontalAlignment="Left">
                    <Button Content="إعادة تشغيل" Command="{Binding RestartAppCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0,0,10,0" />
                    <Button Content="استعادة الافتراضي" Command="{Binding ResetDefaultsCommand}" Style="{StaticResource DangerButtonStyle}" Width="145" Margin="0,0,10,0" />
                    <Button Content="حفظ الإعدادات" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="155" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
