<Window x:Class="AlNeda.Admin.Views.AddEditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="إدارة المستخدم" Height="500" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource CardBgBrush}" CornerRadius="16" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="بيانات المستخدم" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="اسم المستخدم" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Username}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="الدور الوظيفي" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Margin="0,0,0,16"/>

                <TextBlock Text="&#xE716; كلمة المرور الجديدة" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Password}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="تأكيد كلمة المرور" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding ConfirmPassword}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="إلغاء" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="0,12"/>
                <Button Grid.Column="1" Content="حفظ التغييرات" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="0,12"/>
            </Grid>
        </Grid>
    </Border>
</Window>
