<UserControl x:Class="AlNeda.Admin.Views.PharmaciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PharmacyMetricCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FilterToggleButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="#20FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="#30FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33F59E0B" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#66F59E0B" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <Border Grid.RowSpan="3"
                Background="#E60D1117"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="4"
                             Foreground="{StaticResource SuccessBrush}"
                             Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل الصيدليات..."
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إدارة الصيدليات"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="إضافة، اعتماد، متابعة، وحذف حسابات الصيدليات وتطبيق الصيدلي"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="إضافة صيدلية جديدة +"
                        Command="{Binding NewPharmacyCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="44" Padding="26,0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- KPI + Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- KPI Cards -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource PharmacyMetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="إجمالي الصيدليات" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding TotalPharmacies, StringFormat={}{0:N0}}"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#6638BDF8" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource PharmacyMetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="نشطة" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding ActivePharmacies, StringFormat={}{0:N0}}"
                                       Foreground="{StaticResource SuccessBrush}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#6631D0AA" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource PharmacyMetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="قيد المراجعة" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding PendingPharmacies, StringFormat={}{0:N0}}"
                                       Foreground="{StaticResource WarningBrush}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Text="&#xE7FB;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#66F59E0B" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource PharmacyMetricCard}" Margin="0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="إجمالي المستحقات" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding TotalDebt, StringFormat={}{0:N0}}"
                                       Foreground="{StaticResource DangerBrush}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#66FB7185" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Search + Filter bar -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Height="40">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Padding="40,0,14,0" VerticalContentAlignment="Center"
                                 Tag="ابحث عن صيدلية بالاسم أو رقم الهاتف..." />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="0,0,12,0" IsHitTestVisible="False" />
                    </Grid>

                    <Button Grid.Column="1" Content="بحث" Command="{Binding LoadCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="40" MinWidth="100" Margin="10,0,0,0" />

                    <Button Grid.Column="2" Content="تحديث" Command="{Binding LoadCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="40" MinWidth="90" Margin="8,0,0,0" />

                    <ToggleButton Grid.Column="3" Content="قيد المراجعة فقط"
                                  IsChecked="{Binding ShowPendingOnly}"
                                  Style="{StaticResource FilterToggleButton}"
                                  Margin="10,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Pharmacies}"
                          SelectedItem="{Binding SelectedPharmacy}"
                          Style="{StaticResource ModernDataGrid}"
                          CellStyle="{StaticResource ModernDataGridCell}"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          GridLinesVisibility="None"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="54"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />

                        <DataGridTemplateColumn Header="اسم الصيدلية" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding OwnerName}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120" />
                        <DataGridTextColumn Header="المالك" Binding="{Binding OwnerName}" Width="1*" />

                        <DataGridTemplateColumn Header="الرصيد" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Balance, StringFormat={}{0:N2}}"
                                               Foreground="{Binding Balance, Converter={StaticResource BalanceColorConverter}}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status with colored badge -->
                        <DataGridTemplateColumn Header="الحالة" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2438BDF8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AccountStatus}" Value="active">
                                                        <Setter Property="Background" Value="#2531D0AA" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccountStatus}" Value="blocked">
                                                        <Setter Property="Background" Value="#30FB7185" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccountStatus}" Value="pending">
                                                        <Setter Property="Background" Value="#33F59E0B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="غير محدد" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccountStatus}" Value="active">
                                                            <Setter Property="Text" Value="نشطة" />
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccountStatus}" Value="blocked">
                                                            <Setter Property="Text" Value="محظورة" />
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccountStatus}" Value="pending">
                                                            <Setter Property="Text" Value="قيد المراجعة" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="تاريخ التسجيل" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Width="100" />
                        <DataGridTextColumn Header="آخر دخول" Binding="{Binding AppLastLoginAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130" />
                        <DataGridCheckBoxColumn Header="حساب تطبيق" Binding="{Binding HasAppAccount}" Width="90" />
                        <DataGridTextColumn Header="طلبات التطبيق" Binding="{Binding AppOrdersCount}" Width="90" />

                        <!-- Actions column -->
                        <DataGridTemplateColumn Header="الإجراءات" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="RightToLeft">
                                        <Button Content="&#xE70F;"
                                                Command="{Binding DataContext.EditSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource ActionBtn}" ToolTip="تعديل" />

                                        <Button Content="اعتماد"
                                                Command="{Binding DataContext.ApprovePharmacyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="30" MinWidth="60" Padding="10,0" Margin="3,0"
                                                ToolTip="اعتماد حساب الصيدلية وفتح تطبيق الصيدلي" />

                                        <Button Content="سحب"
                                                Command="{Binding DataContext.RevokePharmacyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Height="30" MinWidth="50" Padding="8,0" Margin="3,0"
                                                ToolTip="سحب صلاحية تطبيق الصيدلي" />

                                        <Button Content="&#xE13D;"
                                                Command="{Binding DataContext.OpenAppAccountEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource ActionBtn}" ToolTip="حساب التطبيق" />

                                        <Button Content="&#xE72E;"
                                                Command="{Binding DataContext.ResetAppPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource ActionBtn}" ToolTip="إعادة كلمة المرور" />

                                        <Button Content="&#xE74D;"
                                                Command="{Binding DataContext.DeletePharmacyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionBtn}" ToolTip="حذف الصيدلية"
                                                Foreground="{StaticResource DangerBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoPharmacies, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="26"
                               HorizontalAlignment="Center" Opacity="0.7" />
                    <TextBlock Text="لا توجد صيدليات" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="14" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Editor overlay (add / edit) -->
        <Border Grid.RowSpan="3" Background="#E60D1117"
                Visibility="{Binding ShowEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <Border Style="{StaticResource CardStyle}" Width="560" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                    <StackPanel>
                        <TextBlock Text="إضافة / تعديل صيدلية"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <Border Background="#3D7F1D1D" CornerRadius="10" Padding="12,8" Margin="0,0,0,14"
                                Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" />
                        </Border>

                        <TextBlock Text="اسم الصيدلية *" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditPharmacy.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,12" />

                        <TextBlock Text="اسم المالك" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditOwnerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,12" />

                        <TextBlock Text="الهاتف" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditPharmacy.Phone}"
                                 Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,12" />

                        <TextBlock Text="العنوان" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditPharmacy.Address}"
                                 Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,12" />

                        <!-- App account section (only for new pharmacy) -->
                        <Border Background="#1A38BDF8" CornerRadius="10" Padding="16" Margin="0,0,0,14"
                                Visibility="{Binding IsNewPharmacy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="إنشاء حساب تطبيق (اختياري)"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Text="اسم المستخدم للتطبيق" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding EditAppUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,10" />
                                <TextBlock Text="كلمة المرور (8 أحرف على الأقل)" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding EditAppPassword, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,8" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="حفظ"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Height="44" />
                            <Button Grid.Column="2" Content="إلغاء"
                                    Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource DangerButtonStyle}" Height="44" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- App Account editor overlay -->
        <Border Grid.RowSpan="3" Background="#E60D1117"
                Visibility="{Binding ShowAppAccountEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="220">
            <Border Style="{StaticResource CardStyle}" Width="460" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إنشاء حساب تطبيق" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding SelectedPharmacy.Name}"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                    <TextBox Text="{Binding AppUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="42"
                             Tag="اسم المستخدم" Margin="0,0,0,12" />
                    <TextBox Text="{Binding AppPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="42"
                             Tag="كلمة المرور" Margin="0,0,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="إنشاء"
                                Command="{Binding CreateAppAccountCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="42" />
                        <Button Grid.Column="2" Content="إلغاء"
                                Command="{Binding CancelAppAccountCommand}"
                                Style="{StaticResource DangerButtonStyle}" Height="42" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
