<UserControl x:Class="AlNeda.Admin.Views.PharmaciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24,20,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Stats -->
            <RowDefinition Height="Auto" /> <!-- Search & Actions -->
            <RowDefinition Height="*" />    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="#E60D1117" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="#FF55D66B" Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل البيانات..." Foreground="#FF8B949E"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Stats Section -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Pharmacies -->
            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="إجمالي الصيدليات" Foreground="#FF8B949E" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{Binding Pharmacies.Count}" FontSize="28" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="🏥" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Active Pharmacies -->
            <Border Grid.Column="1" Margin="6,0,6,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="الصيدليات النشطة" Foreground="#FF8B949E" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{Binding Pharmacies.Count}" FontSize="28" FontWeight="Bold" Foreground="#FF55D66B" />
                        <TextBlock Text="✅" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Debtors -->
            <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="إجمالي المديونيات" Foreground="#FF8B949E" FontSize="13" />
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="125,400" FontSize="28" FontWeight="Bold" Foreground="#FFFF5C5C" />
                        <TextBlock Text="💰" FontSize="24" HorizontalAlignment="Left" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search & Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Grid Width="300" Height="44">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Padding="35,0,12,0"
                             VerticalContentAlignment="Center" Tag="ابحث باسم الصيدلية..."/>
                    <TextBlock Text="🔍" Foreground="#FF8B949E" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <Button Content="تحديث" Command="{Binding LoadCommand}" Height="44"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0" Padding="20,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="+ إضافة صيدلية جديدة" Command="{Binding NewPharmacyCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Height="44" Padding="24,0" />
        </Grid>

        <!-- Data Grid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Pharmacies}" SelectedItem="{Binding SelectedPharmacy}"
                      Style="{StaticResource ModernDataGrid}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF21262D"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم الصيدلية" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="2*" />
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="150" />
                    <DataGridTemplateColumn Header="الرصيد" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Balance, StringFormat={}{0:N2}}" 
                                           Foreground="{Binding Balance, Converter={StaticResource BalanceColorConverter}}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="الحالة" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" Margin="14,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccountStatus}" Value="active">
                                                    <Setter Property="Background" Value="#FF1F3B2A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AccountStatus}" Value="blocked">
                                                    <Setter Property="Background" Value="#FF3D1A1A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AccountStatus}" Value="pending">
                                                    <Setter Property="Background" Value="#FF3B2D1A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AccountStatus}" Value="active">
                                                        <Setter Property="Text" Value="نشط" />
                                                        <Setter Property="Foreground" Value="#FF55D66B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccountStatus}" Value="blocked">
                                                        <Setter Property="Text" Value="محظور" />
                                                        <Setter Property="Foreground" Value="#FFFF5C5C" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccountStatus}" Value="pending">
                                                        <Setter Property="Text" Value="قيد الانتظار" />
                                                        <Setter Property="Foreground" Value="#FFD29922" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="الإجراءات" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️" Command="{Binding DataContext.EditSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource ActionButtonStyle}" ToolTip="تعديل" />
                                    <Button Content="🚫" Command="{Binding DataContext.SetStatusAsyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="blocked" Style="{StaticResource ActionButtonStyle}" ToolTip="حظر" Margin="6,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.RowSpan="3" Background="#E60D1117"
                Visibility="{Binding ShowEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <Border Style="{StaticResource CardStyle}" Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة/تعديل صيدلية" FontSize="20" FontWeight="Bold" Foreground="#FF55D66B" Margin="0,0,0,20" />

                    <Border Background="#FF3D1A1A" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFFF5C5C" FontSize="12" />
                    </Border>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="الاسم *" FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditPharmacy.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}" Height="44" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="الهاتف" FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditPharmacy.Phone}" Style="{StaticResource ModernTextBox}" Height="44" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="العنوان" FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,6" />
                        <TextBox Text="{Binding EditPharmacy.Address}" Style="{StaticResource ModernTextBox}" Height="44" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="حفظ التغييرات" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="48" />
                        <Button Grid.Column="2" Content="إلغاء" Command="{Binding CancelEditCommand}"
                                Style="{StaticResource DangerButtonStyle}" Height="48" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>