<UserControl x:Class="AlNeda.Admin.Views.PharmaciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PharmacyMetricCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="22" />
            <Setter Property="MinHeight" Value="104" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style x:Key="TinyActionButton" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="3"
                Background="#E60D1117"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="220"
                             Height="4"
                             Foreground="{StaticResource SuccessBrush}"
                             Style="{StaticResource ModernProgressBar}" />
                <TextBlock Text="جاري تحميل الصيدليات..."
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="20"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إدارة الصيدليات"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Text="بحث، إضافة، متابعة حالة الحسابات، وتجهيز حسابات تطبيق الصيدلي"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="إضافة صيدلية جديدة +"
                        Command="{Binding NewPharmacyCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="44"
                        Padding="26,0"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,18">
                <Border Style="{StaticResource PharmacyMetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="إجمالي الصيدليات"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding TotalPharmacies, StringFormat={}{0:N0}}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock Text="&#xE821;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#6638BDF8"
                                   FontSize="26"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource PharmacyMetricCard}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="الصيدليات النشطة"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding ActivePharmacies, StringFormat={}{0:N0}}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock Text="&#xE73E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#6631D0AA"
                                   FontSize="26"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource PharmacyMetricCard}" Margin="0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="إجمالي المستحقات"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding TotalDebt, StringFormat={}{0:N0}}"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock Text="&#xE8C7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#66FB7185"
                                   FontSize="26"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </UniformGrid>

            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Height="44">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Padding="44,0,14,0"
                                 VerticalContentAlignment="Center"
                                 Tag="ابحث عن صيدلية بالاسم أو رقم الهاتف..." />
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,14,0"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <Button Grid.Column="1"
                            Content="بحث"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44"
                            MinWidth="110"
                            Margin="12,0,0,0" />

                    <Button Grid.Column="2"
                            Content="تحديث"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="44"
                            MinWidth="100"
                            Margin="10,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="10"
                ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Pharmacies}"
                          SelectedItem="{Binding SelectedPharmacy}"
                          Style="{StaticResource ModernDataGrid}"
                          CellStyle="{StaticResource ModernDataGridCell}"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          GridLinesVisibility="None"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="58"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />

                        <DataGridTemplateColumn Header="اسم الصيدلية" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Address}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="145" />
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="2*" />

                        <DataGridTemplateColumn Header="الرصيد" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Balance, StringFormat={}{0:N2}}"
                                               Foreground="{Binding Balance, Converter={StaticResource BalanceColorConverter}}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="الحالة" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="14"
                                            Padding="10,5"
                                            HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2438BDF8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AccountStatus}" Value="active">
                                                        <Setter Property="Background" Value="#2531D0AA" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccountStatus}" Value="blocked">
                                                        <Setter Property="Background" Value="#30FB7185" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AccountStatus}" Value="pending">
                                                        <Setter Property="Background" Value="#33F59E0B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="غير محدد" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccountStatus}" Value="active">
                                                            <Setter Property="Text" Value="نشطة" />
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccountStatus}" Value="blocked">
                                                            <Setter Property="Text" Value="محظورة" />
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AccountStatus}" Value="pending">
                                                            <Setter Property="Text" Value="قيد المراجعة" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridCheckBoxColumn Header="حساب تطبيق" Binding="{Binding HasAppAccount}" Width="110" />
                        <DataGridCheckBoxColumn Header="نشط تطبيق" Binding="{Binding IsAppAccountActive}" Width="105" />
                        <DataGridTextColumn Header="آخر دخول" Binding="{Binding AppLastLoginAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="155" />
                        <DataGridTextColumn Header="طلبات التطبيق" Binding="{Binding AppOrdersCount}" Width="120" />

                        <DataGridTemplateColumn Header="الإجراءات" Width="360">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="RightToLeft">
                                        <Button Content="&#xE70F;"
                                                Command="{Binding DataContext.EditSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource TinyActionButton}"
                                                ToolTip="تعديل" />
                                        <Button Content="اعتماد"
                                                Command="{Binding DataContext.ApprovePharmacyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="32"
                                                MinWidth="74"
                                                Padding="12,0"
                                                Margin="4,0"
                                                ToolTip="اعتماد حساب الصيدلية وفتح تطبيق الصيدلي" />
                                        <Button Content="سحب صلاحية"
                                                Command="{Binding DataContext.RevokePharmacyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Height="32"
                                                MinWidth="98"
                                                Padding="12,0"
                                                Margin="4,0"
                                                ToolTip="سحب صلاحية تطبيق الصيدلي وحظر الدخول" />
                                        <Button Content="&#xE13D;"
                                                Command="{Binding DataContext.OpenAppAccountEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource TinyActionButton}"
                                                ToolTip="حساب التطبيق" />
                                        <Button Content="&#xE72E;"
                                                Command="{Binding DataContext.ResetAppPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource TinyActionButton}"
                                                ToolTip="إعادة كلمة المرور" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoPharmacies, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE821;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="26"
                               HorizontalAlignment="Center"
                               Opacity="0.7" />
                    <TextBlock Text="لا توجد صيدليات"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="14"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.RowSpan="3"
                Background="#E60D1117"
                Visibility="{Binding ShowEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <Border Style="{StaticResource CardStyle}"
                    Width="560"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة / تعديل صيدلية"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,18" />

                    <Border Background="#3D7F1D1D"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="0,0,0,14"
                            Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" />
                    </Border>

                    <TextBlock Text="الاسم *" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding EditPharmacy.Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Height="44"
                             Margin="0,0,0,12" />

                    <TextBlock Text="الهاتف" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding EditPharmacy.Phone}"
                             Style="{StaticResource ModernTextBox}"
                             Height="44"
                             Margin="0,0,0,12" />

                    <TextBlock Text="العنوان" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding EditPharmacy.Address}"
                             Style="{StaticResource ModernTextBox}"
                             Height="44"
                             Margin="0,0,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="حفظ التغييرات"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="46" />
                        <Button Grid.Column="2"
                                Content="إلغاء"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="46" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="3"
                Background="#E60D1117"
                Visibility="{Binding ShowAppAccountEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="220">
            <Border Style="{StaticResource CardStyle}"
                    Width="460"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إنشاء حساب تطبيق"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,10" />
                    <TextBlock Text="{Binding SelectedPharmacy.Name}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,0,16" />

                    <TextBox Text="{Binding AppUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Height="44"
                             Tag="اسم المستخدم"
                             Margin="0,0,0,12" />
                    <TextBox Text="{Binding AppPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Height="44"
                             Tag="كلمة المرور"
                             Margin="0,0,0,18" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="إنشاء"
                                Command="{Binding CreateAppAccountCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="44" />
                        <Button Grid.Column="2"
                                Content="إلغاء"
                                Command="{Binding CancelAppAccountCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="44" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
