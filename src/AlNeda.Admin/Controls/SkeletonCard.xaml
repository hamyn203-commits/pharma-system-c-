<UserControl x:Class="AlNeda.Admin.Controls.SkeletonCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="120">
    <UserControl.Resources>
        <Storyboard x:Key="ShimmerAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ShimmerTransform" 
                             Storyboard.TargetProperty="X"
                             From="-1" To="1" Duration="0:0:1.5" />
        </Storyboard>
    </UserControl.Resources>
    
    <Border Style="{StaticResource CardStyle}" BorderThickness="0">
        <Grid>
            <Rectangle RadiusX="12" RadiusY="12">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="ShimmerGradient" StartPoint="0,0.5" EndPoint="1,0.5">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="ShimmerTransform" X="-1" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF1A1F26" Offset="0" />
                        <GradientStop Color="#FF2A2F36" Offset="0.5" />
                        <GradientStop Color="#FF1A1F26" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            
            <StackPanel Margin="16">
                <Border Background="#FF2D333B" Height="12" Width="100" HorizontalAlignment="Left" CornerRadius="4" Margin="0,0,0,12"/>
                <Border Background="#FF2D333B" Height="28" Width="150" HorizontalAlignment="Left" CornerRadius="6"/>
            </StackPanel>
        </Grid>
    </Border>
    
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource ShimmerAnimation}" />
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
