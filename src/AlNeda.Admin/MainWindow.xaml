<Window x:Class="AlNeda.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مخزن الندا - نظام إدارة المخزن"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        MinWidth="1024" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource PageBgBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding NavigateCommand}" CommandParameter="dashboard" />
        <KeyBinding Key="F2" Command="{Binding NavigateCommand}" CommandParameter="products" />
        <KeyBinding Key="F3" Command="{Binding NavigateCommand}" CommandParameter="pharmacies" />
        <KeyBinding Key="F4" Command="{Binding NavigateCommand}" CommandParameter="orders" />
        <KeyBinding Key="F5" Command="{Binding NavigateCommand}" CommandParameter="payments" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="282" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- SIDEBAR                                                      -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource PageBgBrush}" Padding="18,18,0,18">
            <Border Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="24" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="#FFABB6B4" Opacity="0.16" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="16,18,16,12" HorizontalAlignment="Center">
                        <Grid Width="54" Height="54" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource PrimaryIndigoGlassBrush}" Stroke="{StaticResource BorderDefaultBrush}" StrokeThickness="1" />
                            <Grid>
                                <Rectangle Width="6" Height="24" Fill="{StaticResource PrimaryIndigoBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RadiusX="2" RadiusY="2" />
                                <Rectangle Width="24" Height="6" Fill="{StaticResource PrimaryIndigoBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RadiusX="2" RadiusY="2" />
                            </Grid>
                        </Grid>
                        <TextBlock Text="مخزن الندا" FontSize="20" FontWeight="Bold"
                                   TextAlignment="Center" Margin="0,10,0,0">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource PrimaryIndigo}" Offset="0" />
                                    <GradientStop Color="{StaticResource PrimaryCyanLight}" Offset="1" />
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Pharmacy Management" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" Opacity="0.7" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource BorderMutedBrush}" Height="1" Margin="16,0" />

                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                                  Margin="2,12,2,0"
                                  Background="Transparent">
                        <StackPanel>
                            <TextBlock Text="عام" Style="{StaticResource SectionHeader}" />

                            <Button x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}" Tag="dashboard"
                                    Click="NavButton_Click" ToolTip="F1" Foreground="{StaticResource GeneralGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,0,0" />
                                    <TextBlock Text="الرئيسية" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="المخزون" Style="{StaticResource SectionHeader}" Tag="inventory" />
                            <Button x:Name="NavProducts" Style="{StaticResource NavButtonStyle}" Tag="products"
                                    Click="NavButton_Click" ToolTip="F2" Foreground="{StaticResource InventoryGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="المنتجات" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavCategories" Style="{StaticResource NavButtonStyle}" Tag="categories"
                                    Click="NavButton_Click" Foreground="{StaticResource InventoryGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="التصنيفات" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavSuppliers" Style="{StaticResource NavButtonStyle}" Tag="suppliers"
                                    Click="NavButton_Click" Foreground="{StaticResource InventoryGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="الموردين" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavPurchases" Style="{StaticResource NavButtonStyle}" Tag="purchases"
                                    Click="NavButton_Click" Foreground="{StaticResource InventoryGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="المشتريات" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="المبيعات والحسابات" Style="{StaticResource SectionHeader}" Tag="sales" />
                            <Button x:Name="NavPharmacies" Style="{StaticResource NavButtonStyle}" Tag="pharmacies"
                                    Click="NavButton_Click" ToolTip="F3" Foreground="{StaticResource SalesGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="الصيدليات" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavOrders" Style="{StaticResource NavButtonStyle}" Tag="orders"
                                    Click="NavButton_Click" ToolTip="F4" Foreground="{StaticResource SalesGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="الطلبات" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavPayments" Style="{StaticResource NavButtonStyle}" Tag="payments"
                                    Click="NavButton_Click" ToolTip="F5" Foreground="{StaticResource SalesGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="التحصيلات" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavReturns" Style="{StaticResource NavButtonStyle}" Tag="returns"
                                    Click="NavButton_Click" Foreground="{StaticResource SalesGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="المرتجعات" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavStatements" Style="{StaticResource NavButtonStyle}" Tag="statements"
                                    Click="NavButton_Click" Foreground="{StaticResource SalesGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="كشف الحساب" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavOffers" Style="{StaticResource NavButtonStyle}" Tag="offers"
                                    Click="NavButton_Click" Foreground="{StaticResource SalesGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="العروض" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="المتابعة" Style="{StaticResource SectionHeader}" Tag="monitoring" />
                            <Button x:Name="NavReports" Style="{StaticResource NavButtonStyle}" Tag="reports"
                                    Click="NavButton_Click" Foreground="{StaticResource MonitoringGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="التقارير" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavAudit" Style="{StaticResource NavButtonStyle}" Tag="audit"
                                    Click="NavButton_Click" Foreground="{StaticResource MonitoringGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="سجل العمليات" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavBackup" Style="{StaticResource NavButtonStyle}" Tag="backup"
                                    Click="NavButton_Click" Foreground="{StaticResource MonitoringGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="النسخ الاحتياطي" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" Tag="settings"
                                    Click="NavButton_Click" Foreground="{StaticResource MonitoringGroupBrush}">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="الإعدادات" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- User Panel -->
                    <Border Grid.Row="3" Background="{StaticResource PrimaryCyanGlassBrush}"
                            CornerRadius="18" Margin="8,10,8,8" Padding="4">
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="14" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource PrimaryIndigoGlassBrush}" />
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <!-- User Info -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CurrentRoleLabel}"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <!-- Logout -->
                                <Button Grid.Column="2"
                                        FontSize="16" Width="36" Height="36"
                                        Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                        BorderThickness="0" Cursor="Hand"
                                        Command="{Binding LogoutCommand}"
                                        ToolTip="تسجيل خروج">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="{StaticResource DangerGlassBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT                                                -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="{StaticResource PageBgBrush}" Margin="18,18,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" Height="78" CornerRadius="24" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Margin="0,0,0,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#FFABB6B4" Opacity="0.12" />
                </Border.Effect>
                <Grid>
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <!-- Breadcrumb hint -->
                        <TextBlock Text=" / " Foreground="{StaticResource TextMutedBrush}" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock Text="مخزن الندا" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Clock & Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Notifications -->
                        <Button FontSize="16" Width="36" Height="36"
                                Background="{StaticResource PrimaryCyanGlassBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="{StaticResource PrimaryIndigoGlassBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Date/Time -->
                        <Border Background="{StaticResource PrimaryCyanGlassBrush}" CornerRadius="12" Padding="12,7" Margin="0,0,8,0">
                            <TextBlock x:Name="ClockText" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Border>

                        <!-- Minimize / Maximize / Close -->
                        <StackPanel Orientation="Horizontal">
                            <Button FontSize="12" Width="36" Height="36"
                                    Style="{StaticResource WindowButtonStyle}"
                                    Click="Minimize_Click">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                            </Button>
                            <Button x:Name="MaximizeButton" FontSize="11" Width="36" Height="36"
                                    Style="{StaticResource WindowButtonStyle}"
                                    Click="Maximize_Click">
                                <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                            </Button>
                            <Button FontSize="12" Width="36" Height="36"
                                    Style="{StaticResource CloseButtonStyle}"
                                    Click="Close_Click">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" Background="{StaticResource PageBgBrush}" CornerRadius="24">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>

            <!-- Premium Footer -->
            <Border Grid.Row="2"
                    Background="{StaticResource WarmSurfaceBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    Padding="16,10"
                    CornerRadius="20"
                    Margin="0,18,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Color="#FF020617" Opacity="0.28" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="RightToLeft">
                        <Border Background="#1F31D0AA" BorderBrush="#4431D0AA" BorderThickness="1" CornerRadius="14" Padding="12,7" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <Ellipse Width="8" Height="8"
                                         Fill="{Binding IsApiOnline, Converter={StaticResource BoolToStatusBrushConverter}}"
                                         VerticalAlignment="Center" Margin="0,0,0,0" />
                                <TextBlock Text="{Binding ApiStatusText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#1822363E" BorderBrush="#3347556B" BorderThickness="1" CornerRadius="14" Padding="12,7" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryCyanBrush}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DatabaseName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#18133022" BorderBrush="#3334D399" BorderThickness="1" CornerRadius="14" Padding="12,7">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="جاهز لتطبيق الصيدليات" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource WarningBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,0,0" />
                        <TextBlock Text="{Binding FooterHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="8,0,0,0" />
                        <TextBlock Text=" / " Foreground="{StaticResource BorderDefaultBrush}" FontSize="12" Margin="10,0" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="RightToLeft">
                        <Border Background="#1915253A" BorderBrush="#338B5CF6" BorderThickness="1" CornerRadius="14" Padding="12,7" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryIndigoBrush}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0">
                                    <Run Text="{Binding CurrentUserName, Mode=OneWay}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding CurrentRoleLabel, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#181E3A5F" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="14" Padding="12,7" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource PrimaryCyanBrush}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FooterClock}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#141B2A" BorderBrush="#263246" BorderThickness="1" CornerRadius="14" Padding="12,7">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentPurpleBrush}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
