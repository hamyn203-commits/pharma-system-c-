<Window x:Class="AlNeda.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مخزن الندا - نظام إدارة المخزن"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        MinWidth="1024" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="#FF0D1117"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding NavigateCommand}" CommandParameter="dashboard" />
        <KeyBinding Key="F2" Command="{Binding NavigateCommand}" CommandParameter="products" />
        <KeyBinding Key="F3" Command="{Binding NavigateCommand}" CommandParameter="pharmacies" />
        <KeyBinding Key="F4" Command="{Binding NavigateCommand}" CommandParameter="orders" />
        <KeyBinding Key="F5" Command="{Binding NavigateCommand}" CommandParameter="payments" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- SIDEBAR                                                      -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#FF161B22">
            <Border BorderBrush="#FF21262D" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="20,24,20,16" HorizontalAlignment="Center">
                        <Grid Width="48" Height="48" HorizontalAlignment="Center">
                            <Ellipse Fill="#FF1F3B2A" />
                            <Grid>
                                <Rectangle Width="6" Height="24" Fill="#FF55D66B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RadiusX="1.5" RadiusY="1.5" />
                                <Rectangle Width="24" Height="6" Fill="#FF55D66B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RadiusX="1.5" RadiusY="1.5" />
                            </Grid>
                        </Grid>
                        <TextBlock Text="مخزن الندا" FontSize="18" FontWeight="Bold"
                                   Foreground="#FFFFFFFF" TextAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="Pharmaceutical ERP" FontSize="10"
                                   Foreground="#FF8B949E" TextAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#FF21262D" Height="1" Margin="16,0" />

                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Margin="8,12,8,0"
                                  Background="Transparent">
                        <StackPanel>
                            <TextBlock Text="عام" Style="{StaticResource SectionHeader}" />

                            <Button x:Name="NavDashboard" Content="  الرئيسية"
                                    Style="{StaticResource NavButtonStyle}" Tag="dashboard"
                                    Click="NavButton_Click" ToolTip="F1" />

                            <TextBlock Text="المخزون" Style="{StaticResource SectionHeader}" />
                            <Button x:Name="NavProducts" Content="  المنتجات"
                                    Style="{StaticResource NavButtonStyle}" Tag="products"
                                    Click="NavButton_Click" ToolTip="F2" />
                            <Button x:Name="NavCategories" Content="  التصنيفات"
                                    Style="{StaticResource NavButtonStyle}" Tag="categories"
                                    Click="NavButton_Click" />
                            <Button x:Name="NavSuppliers" Content="  الموردين"
                                    Style="{StaticResource NavButtonStyle}" Tag="suppliers"
                                    Click="NavButton_Click" />
                            <Button x:Name="NavPurchases" Content="  المشتريات"
                                    Style="{StaticResource NavButtonStyle}" Tag="purchases"
                                    Click="NavButton_Click" />

                            <TextBlock Text="المبيعات والحسابات" Style="{StaticResource SectionHeader}" />
                            <Button x:Name="NavPharmacies" Content="  الصيدليات"
                                    Style="{StaticResource NavButtonStyle}" Tag="pharmacies"
                                    Click="NavButton_Click" ToolTip="F3" />
                            <Button x:Name="NavOrders" Content="  الطلبات"
                                    Style="{StaticResource NavButtonStyle}" Tag="orders"
                                    Click="NavButton_Click" ToolTip="F4" />
                            <Button x:Name="NavPayments" Content="  التحصيلات"
                                    Style="{StaticResource NavButtonStyle}" Tag="payments"
                                    Click="NavButton_Click" ToolTip="F5" />
                            <Button x:Name="NavReturns" Content="  المرتجعات"
                                    Style="{StaticResource NavButtonStyle}" Tag="returns"
                                    Click="NavButton_Click" />
                            <Button x:Name="NavStatements" Content="  كشف الحساب"
                                    Style="{StaticResource NavButtonStyle}" Tag="statements"
                                    Click="NavButton_Click" />

                            <TextBlock Text="المتابعة" Style="{StaticResource SectionHeader}" />
                            <Button x:Name="NavReports" Content="  التقارير"
                                    Style="{StaticResource NavButtonStyle}" Tag="reports"
                                    Click="NavButton_Click" />
                            <Button x:Name="NavAudit" Content="  سجل العمليات"
                                    Style="{StaticResource NavButtonStyle}" Tag="audit"
                                    Click="NavButton_Click" />
                            <Button x:Name="NavBackup" Content="  النسخ الاحتياطي"
                                    Style="{StaticResource NavButtonStyle}" Tag="backup"
                                    Click="NavButton_Click" />
                            <Button x:Name="NavSettings" Content="  الإعدادات"
                                    Style="{StaticResource NavButtonStyle}" Tag="settings"
                                    Click="NavButton_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- User Panel -->
                    <Border Grid.Row="3" Background="#FF21262D"
                            CornerRadius="16" Margin="12,8,12,16" Padding="4">
                        <Border Background="#FF161B22" CornerRadius="12" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                                    <Ellipse Fill="#FF1F3B2A" />
                                    <TextBlock Text="👤" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <!-- User Info -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentUserName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF" />
                                    <TextBlock Text="{Binding CurrentRoleLabel}"
                                               FontSize="11" Foreground="#FF8B949E" />
                                </StackPanel>

                                <!-- Logout -->
                                <Button Grid.Column="2" Content="🚪"
                                        FontSize="16" Width="36" Height="36"
                                        Background="Transparent" Foreground="#FF8B949E"
                                        BorderThickness="0" Cursor="Hand"
                                        Command="{Binding LogoutCommand}"
                                        ToolTip="تسجيل خروج">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="{TemplateBinding Background}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="#FF3D1A1A" />
                                                    <Setter Property="Foreground" Value="#FFFF5C5C" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT                                                -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Background="#FF0D1117">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Bar -->
            <Border Grid.Row="0" Background="#FF161B22"
                    BorderBrush="#FF21262D" BorderThickness="0,0,0,1"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="#FFFFFFFF" />
                        <!-- Breadcrumb hint -->
                        <TextBlock Text=" › " Foreground="#FF484F58" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock Text="مخزن الندا" Foreground="#FF8B949E" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Clock & Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Notifications -->
                        <Button Content="🔔" FontSize="16" Width="36" Height="36"
                                Background="Transparent" Foreground="#FF8B949E"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="Background" Value="#FF21262D" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Date/Time -->
                        <Border Background="#FF21262D" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                            <TextBlock x:Name="ClockText" FontSize="12"
                                       Foreground="#FF8B949E" VerticalAlignment="Center" />
                        </Border>

                        <!-- Minimize / Maximize / Close -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="—" FontSize="12" Width="36" Height="36"
                                    Style="{StaticResource WindowButtonStyle}"
                                    Click="Minimize_Click" />
                            <Button x:Name="MaximizeButton" Content="⬜" FontSize="11" Width="36" Height="36"
                                    Style="{StaticResource WindowButtonStyle}"
                                    Click="Maximize_Click" />
                            <Button Content="✕" FontSize="12" Width="36" Height="36"
                                    Style="{StaticResource CloseButtonStyle}"
                                    Click="Close_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ContentControl Content="{Binding CurrentPage}" Grid.Row="1" />

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#FF161B22"
                    BorderBrush="#FF21262D" BorderThickness="0,1,0,0"
                    Padding="24,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#FF55D66B" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11" Foreground="#FF8B949E"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- User info -->
                    <TextBlock Grid.Column="2" FontSize="11" Foreground="#FF484F58"
                               VerticalAlignment="Center">
                        <Run Text="{Binding CurrentUserName, Mode=OneWay}" />
                        <Run Text=" | " />
                        <Run Text="{Binding CurrentRoleLabel, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
